<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gazer beta MSI (WiX v5+ / CLI v7).

  Build via scripts/build-msi.ps1 (stages payload, then):
    wix build -acceptEula wix7 -ext WixToolset.UI.wixext -bindpath Payload=... packaging\Gazer.wxs -d Version=0.4.0 -o dist\Gazer-0.4.0-beta.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- Stable UpgradeCode — do not change across versions. -->
  <Package Name="Gazer"
           Manufacturer="Gazer"
           Version="$(var.Version)"
           UpgradeCode="8F3A2C1E-9B4D-4E7A-A1C5-6D8E0F2B4A7C"
           Language="1033"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="Gazer — gaze input mapper (Tobii Eye Tracker 5 + mouse)"
                        Manufacturer="Gazer" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Gazer is already installed. Remove it first if you need to install this build."
                  AllowSameVersionUpgrades="yes" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Brand icon: Add/Remove Programs, Start Menu, Desktop shortcuts. -->
    <Icon Id="GazerIcon" SourceFile="!(bindpath.Payload)\resources\icons\gazer.ico" />
    <Property Id="ARPPRODUCTICON" Value="GazerIcon" />

    <!-- Optional UI (license-free minimal welcome). -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="!(bindpath.Packaging)\License.rtf" />

    <Feature Id="ProductFeature" Title="Gazer" Level="1"
             Description="Gazer application, layouts, and Qt runtime."
             AllowAdvertise="no"
             ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="PayloadFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Gazer" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Gazer" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- Harvest staged payload (exe, Qt DLLs, plugins, resources, Tobii DLL, MinGW runtime). -->
    <ComponentGroup Id="PayloadFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.Payload)\**">
        <Exclude Files="!(bindpath.Payload)\**\*.pdb" />
        <!-- Compiler objects only (not resources/models/*.obj mesh assets). -->
        <Exclude Files="!(bindpath.Payload)\*.obj" />
        <Exclude Files="!(bindpath.Payload)\**\*.log" />
      </Files>
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="B2C4E6A8-1D3F-5A7B-9C0E-2F4D6A8B0C1E">
      <Shortcut Id="GazerStartMenu"
                Name="Gazer"
                Description="Gaze input mapper"
                Target="[INSTALLFOLDER]Gazer.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="GazerIcon" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\Gazer\Installer"
                     Name="StartMenuShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="C3D5F7A9-2E4B-6C8D-0A1F-3E5B7C9D1A2F">
      <Shortcut Id="GazerDesktop"
                Name="Gazer"
                Description="Gaze input mapper"
                Target="[INSTALLFOLDER]Gazer.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="GazerIcon" />
      <RegistryValue Root="HKCU"
                     Key="Software\Gazer\Installer"
                     Name="DesktopShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

  </Package>
</Wix>
