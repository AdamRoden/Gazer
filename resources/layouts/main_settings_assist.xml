<Page id="main_settings_assist" name="Assist tools" thickness="1" radius="4">
  <Style id="group" background="#00000000" thickness="1" radius="8"/>
  <Style id="row" background="#00000000" thickness="1" radius="6"/>
  <Style id="plain" background="#00000000" thickness="0" radius="0"/>
  <Style id="join" background="#00000000" thickness="0" radius="0"/>
  <Grid id="board" desktopMode="true" rows="17" columns="16" anchor="Top" offset="0,0" size="A_ScreenHeight/9*16, A_ScreenHeight" gap="6" margin="12" thickness="1" radius="4">
    <SubGrid id="tabs" row="0" col="0" colSpan="16" rows="1" columns="6" gap="6">
      <Cell id="tab_buttons" row="0" col="0" label="Button" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_button_timing"/>
      </Cell>
      <Cell id="tab_pointers" row="0" col="1" label="Pointer" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_pointer_timing"/>
      </Cell>
      <Cell id="tab_styles" row="0" col="2" label="Styles" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_styles"/>
      </Cell>
      <Cell id="tab_assist" row="0" col="3" label="Assist" role="tab" interactive="false"/>
      <Cell id="tab_lts" row="0" col="4" label="LTS" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_lts"/>
      </Cell>
      <Cell id="tab_theme" row="0" col="5" label="Theme" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_theme"/>
      </Cell>
    </SubGrid>

    <Cell id="page_title" row="1" col="0" colSpan="16" label="Assist tools" caption="Tracker, live lens, and gaze helpers" role="label" textStyle="title" style="plain"/>

    <SubGrid id="sec_tr" row="2" col="0" colSpan="16" rowSpan="2" rows="2" columns="1" rowWeights="1,2" gap="6" margin="6" style="group">
      <Cell id="h_tr" row="0" col="0" label="Tracker" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_tr" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="tr_l" row="0" col="0" label="Tracker" caption="Applies on next app start." role="label" style="plain"/>
        <SubGrid id="act_tr" row="0" col="1" rows="1" columns="3" gap="0" style="row">
          <Cell id="tr_a" row="0" col="0" label="Auto Tobii" activeState="setting.tracker.0" style="join" command="settings.tracker.auto"/>
          <Cell id="tr_m" row="0" col="1" label="Mouse" activeState="setting.tracker.1" style="join" command="settings.tracker.mouse"/>
          <Cell id="preview" row="0" col="2" label="Head preview" icon="AvatarIcon" style="join" command="openPreview"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_lens" row="4" col="0" colSpan="16" rowSpan="3" rows="3" columns="1" rowWeights="1,2,2" gap="6" margin="6" style="group">
      <Cell id="h_lens" row="0" col="0" label="Live lens" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_z" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="z_l" row="0" col="0" label="Magnifier lens zoom" caption="Live lens magnification. Not used by pre-click or foresight." role="label" style="plain"/>
        <SubGrid id="act_z" row="0" col="1" rows="1" columns="7" gap="0" style="row">
          <Cell id="z_dec" row="0" col="0" label="−" style="join" command="settings.nudge.magZoom.dec"/>
          <Cell id="z_val" row="0" col="1" colSpan="3" label="—" role="value" settingKey="magZoom" style="join"/>
          <Cell id="z_inc" row="0" col="4" label="+" style="join" command="settings.nudge.magZoom.inc"/>
          <Cell id="z_edit" row="0" col="5" colSpan="2" label="Edit…" style="join" command="settings.edit.magZoom"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_l" row="2" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="l_l" row="0" col="0" label="Magnifier lens size" caption="Live lens diameter in pixels." role="label" style="plain"/>
        <SubGrid id="act_l" row="0" col="1" rows="1" columns="7" gap="0" style="row">
          <Cell id="l_dec" row="0" col="0" label="−" style="join" command="settings.nudge.magLensSize.dec"/>
          <Cell id="l_val" row="0" col="1" colSpan="3" label="—" role="value" settingKey="magLensSize" style="join"/>
          <Cell id="l_inc" row="0" col="4" label="+" style="join" command="settings.nudge.magLensSize.inc"/>
          <Cell id="l_edit" row="0" col="5" colSpan="2" label="Edit…" style="join" command="settings.edit.magLensSize"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_help" row="7" col="0" colSpan="16" rowSpan="3" rows="3" columns="1" rowWeights="1,2,2" gap="6" margin="6" style="group">
      <Cell id="h_help" row="0" col="0" label="Helpers" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_help1" row="1" col="0" rows="1" columns="2" gap="0" style="row">
        <Cell id="reticle" row="0" col="0" label="Gaze Indicator" icon="ApplicationIcon" role="toggle" activeState="gazeReticle" style="join" command="toggleGazeReticle"/>
        <Cell id="follow" row="0" col="1" label="Gaze → mouse" icon="MouseMagneticCursorIcon" role="toggle" activeState="gazeMouseFollow" style="join" command="toggleGazeMouseFollow"/>
      </SubGrid>
      <SubGrid id="row_help2" row="2" col="0" rows="1" columns="2" gap="0" style="row">
        <Cell id="magnifier" row="0" col="0" label="Magnifier" icon="MouseMagnifierIcon" role="toggle" activeState="magnifier" style="join" command="toggleMagnifier"/>
        <Cell id="click_loop" row="0" col="1" label="Gaze click loop" icon="RepeatMouseActionIcon" role="toggle" activeState="loop.gazeClick" style="join" command="mouseDwellClickLoop"/>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_combo" row="10" col="0" colSpan="16" rowSpan="7" rows="7" columns="1" rowWeights="1,2,2,2,2,2,2" gap="6" margin="6" style="group">
      <Cell id="h_combo" row="0" col="0" label="ComboMouse" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_combo_on" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="combo_l" row="0" col="0" label="ComboMouse" caption="Dwell to place, then drift and click from the pie." role="label" style="plain"/>
        <Cell id="combo_on" row="0" col="1" label="Toggle" icon="PieSlice5" role="toggle" activeState="comboMouse" command="toggleComboMouse"/>
      </SubGrid>
      <SubGrid id="row_combo_inner" row="2" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="ci_l" row="0" col="0" label="Inner radius" caption="Inner edge of the drift ring (px)." role="label" style="plain"/>
        <SubGrid id="act_ci" row="0" col="1" rows="1" columns="7" gap="0" style="row">
          <Cell id="ci_dec" row="0" col="0" label="−" style="join" command="settings.nudge.comboInnerRadiusPx.dec"/>
          <Cell id="ci_val" row="0" col="1" colSpan="3" label="—" role="value" settingKey="comboInnerRadiusPx" style="join"/>
          <Cell id="ci_inc" row="0" col="4" label="+" style="join" command="settings.nudge.comboInnerRadiusPx.inc"/>
          <Cell id="ci_edit" row="0" col="5" colSpan="2" label="Edit…" style="join" command="settings.edit.comboInnerRadiusPx"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_combo_shared" row="3" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="cs_l" row="0" col="0" label="Shared radius" caption="Where the drift ring meets the command pie (px)." role="label" style="plain"/>
        <SubGrid id="act_cs" row="0" col="1" rows="1" columns="7" gap="0" style="row">
          <Cell id="cs_dec" row="0" col="0" label="−" style="join" command="settings.nudge.comboSharedRadiusPx.dec"/>
          <Cell id="cs_val" row="0" col="1" colSpan="3" label="—" role="value" settingKey="comboSharedRadiusPx" style="join"/>
          <Cell id="cs_inc" row="0" col="4" label="+" style="join" command="settings.nudge.comboSharedRadiusPx.inc"/>
          <Cell id="cs_edit" row="0" col="5" colSpan="2" label="Edit…" style="join" command="settings.edit.comboSharedRadiusPx"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_combo_outer" row="4" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="co_l" row="0" col="0" label="Outer radius" caption="Outer edge of the command pie (px)." role="label" style="plain"/>
        <SubGrid id="act_co" row="0" col="1" rows="1" columns="7" gap="0" style="row">
          <Cell id="co_dec" row="0" col="0" label="−" style="join" command="settings.nudge.comboOuterRadiusPx.dec"/>
          <Cell id="co_val" row="0" col="1" colSpan="3" label="—" role="value" settingKey="comboOuterRadiusPx" style="join"/>
          <Cell id="co_inc" row="0" col="4" label="+" style="join" command="settings.nudge.comboOuterRadiusPx.inc"/>
          <Cell id="co_edit" row="0" col="5" colSpan="2" label="Edit…" style="join" command="settings.edit.comboOuterRadiusPx"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_combo_inner_c" row="5" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="cic_l" row="0" col="0" label="Inner ring" caption="Color and opacity of the drift ring." role="label" style="plain"/>
        <Cell id="cic_sw" row="0" col="1" label="Inner color" settingKey="comboInnerColor" command="settings.edit.color.comboInnerColor"/>
      </SubGrid>
      <SubGrid id="row_combo_outer_c" row="6" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="coc_l" row="0" col="0" label="Outer ring" caption="Color and opacity of the command slices." role="label" style="plain"/>
        <Cell id="coc_sw" row="0" col="1" label="Outer color" settingKey="comboOuterColor" command="settings.edit.color.comboOuterColor"/>
      </SubGrid>
    </SubGrid>
  </Grid>
</Page>
