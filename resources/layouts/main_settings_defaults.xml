<Page id="main_settings_defaults" name="Defaults" radius="16">
  <Style id="group" background="bg95" thickness="0" radius="16"/>
  <Style id="row" background="transparent" thickness="0" radius="0"/>
  <Style id="plain" background="transparent" thickness="0" radius="0"/>
  <Style id="join" background="transparent" thickness="0" radius="0"/>
  <Style id="joinLeft" background="transparent" thickness="0" radius="10,0,0,10"/>
  <Style id="joinRight" background="transparent" thickness="0" radius="0,10,10,0"/>
  <Style id="button" background="transparent" thickness="0" radius="10"/>
  <Grid id="board" desktopMode="true" rows="4" columns="6" anchor="Top" offset="0,0" size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth), A_ScreenHeight" gap="8" margin="0" radius="16"
        rowHeights="96,72,40,*" columnWidths="*,160,180,200,150,72">
    <SubGrid id="titlebar" row="0" col="0" colSpan="6" rows="1" columns="2" columnWidths="*,160" gap="8" margin="0" style="plain">
      <Cell id="page_title" row="0" col="0" label="Defaults" caption="Compare each setting with its factory value" role="label" textStyle="title" style="plain"/>
      <Cell id="tab_done" row="0" col="1" label="Close" icon="keyboardHide" textStyle="row" style="button" closeAllPages="true"/>
    </SubGrid>
    <SubGrid id="def_tools" row="1" col="0" colSpan="5" rows="1" columns="5" columnWidths="*,160,180,200,150" gap="0" margin="0" style="row">
      <Cell id="def_search" row="0" col="0" label="Search" caption="Name, description, or page" icon="search" textStyle="row" style="joinLeft" command="settings.defaults.search"/>
      <Cell id="def_select_all" row="0" col="1" label="Select all" style="join" command="settings.defaults.selectAll"/>
      <Cell id="def_deselect_all" row="0" col="2" label="Deselect all" style="join" command="settings.defaults.deselectAll"/>
      <Cell id="def_filter" row="0" col="3" label="All" icon="ArrowDown" textStyle="row" style="join" activeState="settings.defaults.filterMenu" command="settings.defaults.filterMenu"/>
      <Cell id="def_reset" row="0" col="4" label="Reset" style="joinRight" command="settings.defaults.resetSelected"/>
    </SubGrid>
    <SubGrid id="def_cols" row="2" col="0" colSpan="5" rows="1" columns="5" columnWidths="5*,3*,3*,2*,2*" gap="6" margin="0" style="row">
      <Cell id="def_col_name" row="0" col="0" label="Setting" role="label" style="plain"/>
      <Cell id="def_col_default" row="0" col="1" label="Default" role="label" style="plain"/>
      <Cell id="def_col_current" row="0" col="2" label="Current" role="label" style="plain"/>
      <Cell id="def_col_edit" row="0" col="3" label="Edit" role="label" style="plain"/>
      <Cell id="def_col_pick" row="0" col="4" label="Select" role="label" style="plain"/>
    </SubGrid>
    <SubGrid id="scroller" row="3" col="0" colSpan="5" scroll="true" rows="1" columns="1" rowHeights="*" gap="0" margin="0">
      <Cell id="def_empty" row="0" col="0" label="Nothing matches" role="label" style="plain"/>
    </SubGrid>
    <SubGrid id="def_menu" row="3" col="3" rows="8" columns="1" rowHeights="72,72,72,72,72,72,72,72" gap="0" margin="0" layers="2">
      <Cell id="def_m_all" row="0" col="0" label="All" role="choice" style="button" background="bg95" activeState="settings.defaults.filter.All" command="settings.defaults.filter.All"/>
      <Cell id="def_m_dwell" row="1" col="0" label="Dwell" role="choice" style="button" background="bg95" activeState="settings.defaults.filter.Dwell" command="settings.defaults.filter.Dwell"/>
      <Cell id="def_m_pointer" row="2" col="0" label="Pointer" role="choice" style="button" background="bg95" activeState="settings.defaults.filter.Pointer" command="settings.defaults.filter.Pointer"/>
      <Cell id="def_m_gaze" row="3" col="0" label="Gaze" role="choice" style="button" background="bg95" activeState="settings.defaults.filter.Gaze" command="settings.defaults.filter.Gaze"/>
      <Cell id="def_m_head" row="4" col="0" label="Head" role="choice" style="button" background="bg95" activeState="settings.defaults.filter.Head" command="settings.defaults.filter.Head"/>
      <Cell id="def_m_speak" row="5" col="0" label="Speak" role="choice" style="button" background="bg95" activeState="settings.defaults.filter.Speak" command="settings.defaults.filter.Speak"/>
      <Cell id="def_m_theme" row="6" col="0" label="Theme" role="choice" style="button" background="bg95" activeState="settings.defaults.filter.Theme" command="settings.defaults.filter.Theme"/>
      <Cell id="def_m_setup" row="7" col="0" label="Setup" role="choice" style="button" background="bg95" activeState="settings.defaults.filter.Setup" command="settings.defaults.filter.Setup"/>
    </SubGrid>
    <SubGrid id="page_scroll" row="3" col="5" rows="3" columns="1" rowHeights="72,*,72" gap="6" margin="0" layers="1,2" style="group">
      <Cell id="set_scroll_up" row="0" col="0" icon="ArrowUp" role="scrollUp" style="button" command="settings.scroll.up"/>
      <Cell id="set_scroll_track" row="1" col="0" role="scrollbar" caption="0,1,1" scanGrace="400"/>
      <Cell id="set_scroll_down" row="2" col="0" icon="ArrowDown" role="scrollDown" style="button" command="settings.scroll.down"/>
    </SubGrid>
  </Grid>
</Page>
