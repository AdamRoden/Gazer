<?xml version="1.0" encoding="UTF-8"?>
<Page id="main_settings_defaults" name="Defaults" radius="16">
  <Style id="row" background="transparent" thickness="0" radius="0"/>
  <Style id="join" background="transparent" thickness="0" radius="0"/>
  <Style id="plain" background="transparent" thickness="0" radius="0"/>
  <Style id="button" background="transparent" thickness="0" radius="10"/>
  <Style id="joinLeft" background="transparent" thickness="0" radius="10,0,0,10"/>
  <Style id="group" background="bg95" thickness="0" radius="16"/>
  <Style id="joinRight" background="transparent" thickness="0" radius="0,10,10,0"/>
  <Grid id="board" rows="4" columns="6" desktopMode="true" anchor="Top" offset="0,0" size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth),A_ScreenHeight" gap="8" rowHeights="96,72,40,*" columnWidths="*,160,180,200,150,72" radius="16">
    <Row id="titlebar" columns="2" span="6" gap="8" columnWidths="*,160" style="plain">
      <Label id="page_title" style="plain" label="Defaults" caption="Compare each setting with its factory value" textStyle="title"/>
      <Button id="tab_done" style="button" label="Close" icon="keyboardHide" textStyle="row" closeAllPages="true"/>
    </Row>
    <Row columns="5" row="1" span="5" columnWidths="*,160,180,200,150" style="row">
      <Button id="def_search" style="joinLeft" label="Search" icon="search" caption="Name, description, or page" textStyle="row" command="settings.defaults.search"/>
      <Button style="join" label="Select all" command="settings.defaults.selectAll"/>
      <Button style="join" label="Deselect all" command="settings.defaults.deselectAll"/>
      <Button id="def_filter" style="join" label="All" icon="ArrowDown" bind="settings.defaults.filterMenu" textStyle="row" command="settings.defaults.filterMenu"/>
      <Button style="joinRight" label="Reset" command="settings.defaults.resetSelected"/>
    </Row>
    <Row columns="5" row="2" span="5" gap="6" columnWidths="5*,3*,3*,2*,2*" style="row">
      <Label style="plain" label="Setting"/>
      <Label style="plain" label="Default"/>
      <Label style="plain" label="Current"/>
      <Label style="plain" label="Edit"/>
      <Label style="plain" label="Select"/>
    </Row>
    <Grid id="scroller" row="3" span="5" scroll="true">
      <Label id="def_empty" style="plain" label="Nothing matches"/>
    </Grid>
    <Column rows="8" row="3" col="3" rowHeights="72,72,72,72,72,72,72,72" layers="2">
      <Choice style="button" label="All" bind="settings.defaults.filter.All" background="bg95" command="settings.defaults.filter.All"/>
      <Choice style="button" label="Dwell" bind="settings.defaults.filter.Dwell" background="bg95" command="settings.defaults.filter.Dwell"/>
      <Choice style="button" label="Pointer" bind="settings.defaults.filter.Pointer" background="bg95" command="settings.defaults.filter.Pointer"/>
      <Choice style="button" label="Gaze" bind="settings.defaults.filter.Gaze" background="bg95" command="settings.defaults.filter.Gaze"/>
      <Choice style="button" label="Head" bind="settings.defaults.filter.Head" background="bg95" command="settings.defaults.filter.Head"/>
      <Choice style="button" label="Speak" bind="settings.defaults.filter.Speak" background="bg95" command="settings.defaults.filter.Speak"/>
      <Choice style="button" label="Theme" bind="settings.defaults.filter.Theme" background="bg95" command="settings.defaults.filter.Theme"/>
      <Choice style="button" label="Setup" bind="settings.defaults.filter.Setup" background="bg95" command="settings.defaults.filter.Setup"/>
    </Column>
    <Card id="page_scroll" rows="3" row="3" col="5" gap="6" rowHeights="72,*,72" layers="1,2" style="group">
      <Button id="set_scroll_up" style="button" icon="ArrowUp" role="scrollUp" command="settings.scroll.up"/>
      <Button caption="0,1,1" role="scrollbar" scanGrace="400"/>
      <Button id="set_scroll_down" style="button" icon="ArrowDown" role="scrollDown" command="settings.scroll.down"/>
    </Card>
  </Grid>
</Page>
