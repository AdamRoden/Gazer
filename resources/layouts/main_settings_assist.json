{
  "schemaVersion": 1,
  "id": "main_settings_assist",
  "name": "Assist tools",
  "description": "Tracker, live lens, gaze helpers, and action loops",
  "uiStyle": "fluent",
  "window": { "anchor": "TopCenter", "widthPx": 1260, "height": 100, "marginPx": 0 },
  "grid": { "columns": 6, "rows": 11, "gapPx": 10, "marginPx": 100 },
  "items": [
    { "id": "buttons", "label": "Buttons", "row": 0, "col": 0, "action": { "type": "loadLayout", "layoutId": "main_settings_buttons" } },
    { "id": "pointers", "label": "Pointers", "row": 0, "col": 1, "action": { "type": "loadLayout", "layoutId": "main_settings_pointers" } },
    { "id": "lts", "label": "Look↕Scroll", "row": 0, "col": 2, "action": { "type": "loadLayout", "layoutId": "main_settings_lts" } },
    { "id": "theme", "label": "Theme", "row": 0, "col": 3, "action": { "type": "loadLayout", "layoutId": "main_settings_theme" } },
    { "id": "assist", "label": "Assist tools", "row": 0, "col": 4 },

    { "id": "tr_l", "role": "label", "label": "Tracker", "caption": "Applies on next app start.", "row": 2, "col": 0 },
    { "id": "tr_a", "label": "Auto Tobii", "activeState": "setting.tracker.0", "row": 2, "col": 1, "action": { "type": "command", "name": "settings.tracker.auto" } },
    { "id": "tr_m", "label": "Mouse", "activeState": "setting.tracker.1", "row": 2, "col": 2, "action": { "type": "command", "name": "settings.tracker.mouse" } },

    { "id": "reticle", "label": "Gaze Indicator", "activeState": "gazeReticle", "row": 3, "col": 1, "action": { "type": "command", "name": "toggleGazeReticle" } },
    { "id": "follow", "label": "Gaze → mouse", "activeState": "gazeMouseFollow", "row": 3, "col": 2, "action": { "type": "command", "name": "toggleGazeMouseFollow" } },
    { "id": "preview", "label": "Head preview", "row": 3, "col": 3, "action": { "type": "command", "name": "openPreview" } },

    { "id": "z_l", "role": "label", "label": "Lens zoom", "caption": "Live lens magnification. Not used by pre-click or foresight.", "row": 4, "col": 0 },
    { "id": "z_d", "label": "−", "row": 4, "col": 1, "action": { "type": "command", "name": "settings.nudge.magZoom.dec" } },
    { "id": "z_v", "role": "value", "settingKey": "magZoom", "label": "—", "row": 4, "col": 2 },
    { "id": "z_i", "label": "+", "row": 4, "col": 3, "action": { "type": "command", "name": "settings.nudge.magZoom.inc" } },
    { "id": "z_e", "label": "Edit…", "row": 4, "col": 4, "action": { "type": "command", "name": "settings.edit.magZoom" } },

    { "id": "l_l", "role": "label", "label": "Lens size", "caption": "Live lens diameter in pixels.", "row": 5, "col": 0 },
    { "id": "l_d", "label": "−", "row": 5, "col": 1, "action": { "type": "command", "name": "settings.nudge.magLensSize.dec" } },
    { "id": "l_v", "role": "value", "settingKey": "magLensSize", "label": "—", "row": 5, "col": 2 },
    { "id": "l_i", "label": "+", "row": 5, "col": 3, "action": { "type": "command", "name": "settings.nudge.magLensSize.inc" } },
    { "id": "l_e", "label": "Edit…", "row": 5, "col": 4, "action": { "type": "command", "name": "settings.edit.magLensSize" } },

    { "id": "f_l", "role": "label", "label": "Lens follow", "caption": "Sticky / Balanced / Snappy tracking for the live lens.", "row": 6, "col": 0 },
    { "id": "f_s", "label": "Sticky", "activeState": "setting.magFollow.0", "row": 6, "col": 1, "action": { "type": "command", "name": "settings.mag.follow.sticky" } },
    { "id": "f_v", "role": "value", "settingKey": "magFollowProfile", "label": "—", "row": 6, "col": 2 },
    { "id": "f_b", "label": "Balanced", "activeState": "setting.magFollow.1", "row": 6, "col": 3, "action": { "type": "command", "name": "settings.mag.follow.balanced" } },
    { "id": "f_n", "label": "Snappy", "activeState": "setting.magFollow.2", "row": 6, "col": 4, "action": { "type": "command", "name": "settings.mag.follow.snappy" } },

    { "id": "tog", "label": "Toggle lens", "activeState": "magnifier", "row": 7, "col": 1, "action": { "type": "command", "name": "toggleMagnifier" } },
    { "id": "click_loop", "label": "Gaze click\nloop", "activeState": "loop.gazeClick", "row": 7, "col": 2, "action": { "type": "command", "name": "mouseDwellClickLoop" } },
    { "id": "stop_loops", "label": "Stop action loops", "row": 7, "col": 3, "colSpan": 2, "action": { "type": "command", "name": "stopAllActionLoops" } },

    { "id": "close", "label": "Close", "row": 10, "col": 2, "colSpan": 1, "action": { "type": "closeLayout" } }
  ]
}
