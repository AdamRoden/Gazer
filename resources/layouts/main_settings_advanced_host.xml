<Page id="main_settings_advanced_host" name="Advanced" radius="16">
  <Style id="tabbar" background="bg95" thickness="0" radius="12"/>
  <Grid id="board" desktopMode="true" rows="2" columns="16" anchor="Top" offset="0,0"
        size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth), A_ScreenHeight" rowHeights="0.1*,*">
    <SubGrid id="tabs" row="0" col="0" colSpan="16" rows="1" columns="6" gap="6" margin="4" style="tabbar">
      <Cell id="tab_adv_speed" row="0" col="0" label="Adv. speed" icon="timer" role="tab" hostPage="main_settings_speed_advanced"/>
      <Cell id="tab_indicators" row="0" col="1" label="Indicators" icon="cycle" role="tab" hostPage="main_settings_indicators"/>
      <Cell id="tab_tools" row="0" col="2" label="Tools" icon="lookToScroll" role="tab" hostPage="main_settings_tools"/>
      <Cell id="tab_admin" row="0" col="3" label="Admin" icon="settings" role="tab" hostPage="main_settings_admin"/>
      <Cell id="tab_basic" row="0" col="4" label="Basic" icon="home" role="tab" closePage="true"/>
      <Cell id="tab_done" row="0" col="5" label="Done" icon="keyboardHide" closeAllPages="true"/>
    </SubGrid>
    <SubGrid id="body" row="1" col="0" colSpan="16" src="main_settings_speed_advanced" grid="board"/>
  </Grid>
</Page>
