{
  "schemaVersion": 1,
  "id": "example_assist",
  "name": "Assist",
  "description": "Gaze assist: LTS, magnifier, reticle, gaze mouse, move-to.",  
  "boundsMode": "screen",
  "autoClose": true,
  "autoCloseIdleMs": 3000,
  "autoCloseFadeMs": 3000,
  "window": {
    "anchor": "bottomCenter",
    "widthPx": 1080,
    "heightPx": 150,
    "style": {
      "background": "#00000000"
    }
  },
  "grid": {
    "columns": 8,
    "rows": 1,
    "gapPx": 10
  },
  "items": [
    {
      "id": "mag",
      "label": "Magnifier",
      "activeState": "magnifier",
      "row": 0,
      "col": 0,
      "action": { "type": "command", "name": "toggleMagnifier" }
    },
    {
      "id": "gaze_reticle",
      "label": "Gaze reticle",
      "activeState": "gazeReticle",
      "row": 0,
      "col": 1,
      "action": { "type": "command", "name": "toggleGazeReticle" }
    },
    {
      "id": "gaze_follow",
      "label": "Gaze mouse",
      "activeState": "gazeMouseFollow",
      "row": 0,
      "col": 2,
      "action": { "type": "command", "name": "toggleGazeMouseFollow" }
    },
    {
      "id": "mouse_move",
      "label": "Move mouse\n(dwell)",
      "activeState": "mouseDwellMove",
      "row": 0,
      "col": 3,
      "action": { "type": "command", "name": "mouseDwellMove" }
    },
    {
      "id": "mag_pick",
      "label": "Move-to\nZoom",
      "activeState": "mouseMoveMagPick",
      "row": 0,
      "col": 4,
      "action": { "type": "command", "name": "toggleMouseMoveMagPick" }
    },
    {
      "id": "lts",
      "label": "Look↕Scroll",
      "activeState": "lookToScroll",
      "row": 0,
      "col": 5,
      "action": { "type": "command", "name": "toggleLookToScroll" }
    },
    {
      "id": "lts_hint",
      "label": "LTS: dwell\n@center to pause\n@limit to accelerate",
      "role": "label",
      "row": 0,
      "col": 6
    },
    {
      "id": "main",
      "label": "← Main",
      "row": 0,
      "col": 7,
      "action": { "type": "loadLayout", "layoutId": "main_drawer" }
    }
  ]
}
