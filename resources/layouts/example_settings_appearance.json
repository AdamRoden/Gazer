{
  "schemaVersion": 1,
  "id": "example_settings_appearance",
  "name": "Progress & flash",
  "description": "Radial / fill / border highlights, colors, and completion flash",
  "uiStyle": "fluent",
  "window": { "anchor": "TopCenter", "widthPx": 1260, "height": 100, "marginPx": 0 },
  "grid": { "columns": 5, "rows": 10, "gapPx": 10, "marginPx": 100 },
  "items": [
    { "id": "timing", "label": "Timing", "row": 0, "col": 0, "style": { "background": "#2b4c7e", "foreground": "#f4f6fc" }, "action": { "type": "loadLayout", "layoutId": "example_settings_timing" } },
    { "id": "magnifier", "label": "Magnifier", "row": 0, "col": 1, "style": { "background": "#5c4d7a", "foreground": "#f4f6fc" }, "action": { "type": "loadLayout", "layoutId": "example_settings_magnifier" } },
    { "id": "lts", "label": "Look↕Scroll", "row": 0, "col": 2, "style": { "background": "#1b5e4a", "foreground": "#f4f6fc" }, "action": { "type": "loadLayout", "layoutId": "example_settings_lts" } },
    {"id": "appearance","label": "Appearance","row": 0,"col": 3,"style": { "background": "#5c4d7a", "foreground": "#f4f6fc" },"action": { "type": "loadLayout", "layoutId": "example_settings_appearance" }},
  
    { "id": "t_name", "role": "label", "label": "Theme", "caption": "Dark / Light / Custom", "row": 2, "col": 0 },
    { "id": "light", "label": "Light", "activeState": "setting.theme.light", "row": 2, "col": 2,
      "style": { "background": "#f0f4f9", "foreground": "#1f1f1f" },
      "action": { "type": "command", "name": "theme.light" } },
    { "id": "dark", "label": "Dark", "activeState": "setting.theme.dark", "row": 2, "col": 3,
      "style": { "background": "#0a0a0b", "foreground": "#e3e3e3" },
      "action": { "type": "command", "name": "theme.dark" } },
    { "id": "custom", "label": "Custom", "activeState": "setting.theme.custom", "row": 2, "col": 4,
      "style": { "background": "#674ea7", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "theme.custom" } },
      
    { "id": "r_name", "role": "label", "label": "Board radial", "caption": "Ring progress on activators.", "row": 3, "col": 0 },
    { "id": "r_val", "role": "value", "settingKey": "progressRadial", "label": "—", "row": 3, "col": 2 },
    { "id": "r_tog", "label": "Toggle", "activeState": "setting.progressRadial", "row": 3, "col": 3, "colSpan": 2, "style": { "background": "#0a7ea4", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.progress.radial.toggle" } },

    { "id": "f_name", "role": "label", "label": "Board fill", "caption": "Fill activator background as progress grows.", "row": 4, "col": 0 },
    { "id": "f_val", "role": "value", "settingKey": "progressFill", "label": "—", "row": 4, "col": 2 },
    { "id": "f_tog", "label": "Toggle", "activeState": "setting.progressFill", "row": 4, "col": 3, "style": { "background": "#0a7ea4", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.progress.fill.toggle" } },
    { "id": "f_col", "label": "Color", "row": 4, "col": 4, "style": { "background": "#5c4d7a", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.edit.color.progressFillColor" } },

    { "id": "b_name", "role": "label", "label": "Board border", "caption": "Highlight activator border while dwelling.", "row": 5, "col": 0 },
    { "id": "b_val", "role": "value", "settingKey": "progressBorder", "label": "—", "row": 5, "col": 2 },
    { "id": "b_tog", "label": "Toggle", "activeState": "setting.progressBorder", "row": 5, "col": 3, "style": { "background": "#0a7ea4", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.progress.border.toggle" } },
    { "id": "b_col", "label": "Color", "row": 5, "col": 4, "style": { "background": "#5c4d7a", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.edit.color.progressBorderColor" } },

    { "id": "pc_name", "role": "label", "label": "Progress ring color", "caption": "Color of the radial progress arc on boards.", "row": 6, "col": 0 },
    { "id": "pc_val", "role": "value", "settingKey": "progressColor", "label": "—", "row": 6, "col": 2 },
    { "id": "pc_col", "label": "Pick…", "row": 6, "col": 3, "colSpan": 2, "style": { "background": "#5c4d7a", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.edit.color.progressColor" } },

    { "id": "mr_name", "role": "label", "label": "Mouse radial / fill / border", "caption": "Progress styles for the mouse-move reticle.", "row": 7, "col": 0 },
    { "id": "mr_r", "label": "Radial", "activeState": "setting.mouseProgressRadial", "row": 7, "col": 2, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.mouseProgress.radial.toggle" } },
    { "id": "mr_f", "label": "Fill", "activeState": "setting.mouseProgressFill", "row": 7, "col": 3, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.mouseProgress.fill.toggle" } },
    { "id": "mr_b", "label": "Border", "activeState": "setting.mouseProgressBorder", "row": 7, "col": 4, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.mouseProgress.border.toggle" } },

    { "id": "fl_name", "role": "label", "label": "Completion flash", "caption": "Brief flash after activation — border, fill, duration.", "row": 8, "col": 0 },
    { "id": "fl_val", "role": "value", "settingKey": "flashOnComplete", "label": "—", "row": 8, "col": 1 },
    { "id": "fl_tog", "label": "Toggle", "activeState": "setting.flashOnComplete", "row": 8, "col": 2, "style": { "background": "#0a7ea4", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.flash.toggle" } },
    { "id": "fl_bc", "label": "Border", "row": 8, "col": 3, "style": { "background": "#5c4d7a", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.edit.color.flashBorderColor" } },
    { "id": "fl_fc", "label": "Fill", "row": 8, "col": 4, "style": { "background": "#5c4d7a", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.edit.color.flashFillColor" } },

    { "id": "fd_label", "role": "label", "label": "Flash duration", "caption": "How long the completion flash is shown (ms).", "row": 9, "col": 0 },
    { "id": "fd_dec", "label": "−", "row": 9, "col": 2, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.flashMs.dec" } },
    { "id": "fd_val", "role": "value", "settingKey": "flashMs", "label": "—", "row": 9, "col": 3 },
    { "id": "fd_inc", "label": "+", "row": 9, "col": 4, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.flashMs.inc" } }
  ]
}
