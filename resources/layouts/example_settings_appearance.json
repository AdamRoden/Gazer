{
  "schemaVersion": 1,
  "id": "example_settings_appearance",
  "name": "Progress & flash",
  "description": "Radial / fill / border highlights, colors, and completion flash",
  "uiStyle": "fluent",
  "window": { "anchor": "center", "widthPx": 1100, "heightPx": 680, "marginPx": 16 },
  "grid": { "columns": 5, "rows": 7, "gapPx": 8, "marginPx": 52 },
  "dwell": { "enabled": true, "ms": [650], "progressStyle": "radial" },
  "items": [
    { "id": "r_name", "role": "label", "label": "Board radial", "caption": "Ring progress on activators.", "row": 0, "col": 0 },
    { "id": "r_val", "role": "value", "settingKey": "progressRadial", "label": "—", "row": 0, "col": 2 },
    { "id": "r_tog", "label": "Toggle", "activeState": "setting.progressRadial", "row": 0, "col": 3, "colSpan": 2, "style": { "background": "#0a7ea4", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.progress.radial.toggle" } },

    { "id": "f_name", "role": "label", "label": "Board fill", "caption": "Fill activator background as progress grows.", "row": 1, "col": 0 },
    { "id": "f_val", "role": "value", "settingKey": "progressFill", "label": "—", "row": 1, "col": 2 },
    { "id": "f_tog", "label": "Toggle", "activeState": "setting.progressFill", "row": 1, "col": 3, "style": { "background": "#0a7ea4", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.progress.fill.toggle" } },
    { "id": "f_col", "label": "Color", "row": 1, "col": 4, "style": { "background": "#5c4d7a", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.edit.color.progressFillColor" } },

    { "id": "b_name", "role": "label", "label": "Board border", "caption": "Highlight activator border while dwelling.", "row": 2, "col": 0 },
    { "id": "b_val", "role": "value", "settingKey": "progressBorder", "label": "—", "row": 2, "col": 2 },
    { "id": "b_tog", "label": "Toggle", "activeState": "setting.progressBorder", "row": 2, "col": 3, "style": { "background": "#0a7ea4", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.progress.border.toggle" } },
    { "id": "b_col", "label": "Color", "row": 2, "col": 4, "style": { "background": "#5c4d7a", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.edit.color.progressBorderColor" } },

    { "id": "pc_name", "role": "label", "label": "Progress ring color", "caption": "Color of the radial progress arc on boards.", "row": 3, "col": 0 },
    { "id": "pc_val", "role": "value", "settingKey": "progressColor", "label": "—", "row": 3, "col": 2 },
    { "id": "pc_col", "label": "Pick…", "row": 3, "col": 3, "colSpan": 2, "style": { "background": "#5c4d7a", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.edit.color.progressColor" } },

    { "id": "mr_name", "role": "label", "label": "Mouse radial / fill / border", "caption": "Progress styles for the mouse-move reticle.", "row": 4, "col": 0 },
    { "id": "mr_r", "label": "Radial", "activeState": "setting.mouseProgressRadial", "row": 4, "col": 2, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.mouseProgress.radial.toggle" } },
    { "id": "mr_f", "label": "Fill", "activeState": "setting.mouseProgressFill", "row": 4, "col": 3, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.mouseProgress.fill.toggle" } },
    { "id": "mr_b", "label": "Border", "activeState": "setting.mouseProgressBorder", "row": 4, "col": 4, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.mouseProgress.border.toggle" } },

    { "id": "fl_name", "role": "label", "label": "Completion flash", "caption": "Brief flash after activation — border, fill, duration.", "row": 5, "col": 0 },
    { "id": "fl_val", "role": "value", "settingKey": "flashOnComplete", "label": "—", "row": 5, "col": 1 },
    { "id": "fl_tog", "label": "Toggle", "activeState": "setting.flashOnComplete", "row": 5, "col": 2, "style": { "background": "#0a7ea4", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.flash.toggle" } },
    { "id": "fl_bc", "label": "Border", "row": 5, "col": 3, "style": { "background": "#5c4d7a", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.edit.color.flashBorderColor" } },
    { "id": "fl_fc", "label": "Fill", "row": 5, "col": 4, "style": { "background": "#5c4d7a", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.edit.color.flashFillColor" } },

    { "id": "fd_label", "role": "label", "label": "Flash duration", "caption": "How long the completion flash is shown (ms).", "row": 6, "col": 0 },
    { "id": "fd_dec", "label": "−", "row": 6, "col": 1, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.flashMs.dec" } },
    { "id": "fd_val", "role": "value", "settingKey": "flashMs", "label": "—", "row": 6, "col": 2 },
    { "id": "fd_inc", "label": "+", "row": 6, "col": 3, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.flashMs.inc" } },
    { "id": "back", "label": "← Settings", "row": 6, "col": 4, "style": { "background": "#0a7ea4", "foreground": "#fff" }, "action": { "type": "loadLayout", "layoutId": "example_settings" } }
  ]
}
