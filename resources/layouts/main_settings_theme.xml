        </SubGrid>
        <SubGrid id="row_pal_analogous2" row="7" col="0" rows="1" columns="11" gap="0" style="row">
          <Cell id="h_pal_analogous2" row="0" col="0" colSpan="2" label="" role="label" style="plain"/>
          <Cell id="pal_analogous2_9" row="0" col="2" style="joinLeft" command="settings.theme.shade.analogous2.9"/>
