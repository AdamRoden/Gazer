<Page id="main_settings_theme" name="Theme" radius="16">
  <Style id="group" thickness="0" radius="16"/>
  <Style id="row" background="#00000000" thickness="0" radius="0"/>
  <Style id="plain" background="#00000000" thickness="0" radius="0"/>
  <Style id="join" background="#00000000" thickness="0" radius="0"/>
  <Style id="joinLeft" background="#00000000" thickness="0" radius="10,0,0,10"/>
  <Style id="joinRight" background="#00000000" thickness="0" radius="0,10,10,0"/>
  <Style id="tabbar" thickness="0" radius="12"/>
  <Grid id="board" desktopMode="true" rows="12" columns="16" anchor="Top" offset="0,0" size="A_ScreenHeight/9*16, A_ScreenHeight" gap="6" margin="12" radius="16">
    <SubGrid id="tabs" row="0" col="0" colSpan="16" rows="1" columns="7" gap="6" margin="4" style="tabbar">
      <Cell id="tab_buttons" row="0" col="0" label="Speed" icon="RepeatMouseActionIcon" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_button_timing"/>
      </Cell>
      <Cell id="tab_pointers" row="0" col="1" label="Magnify" icon="ZoomToLocation" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_pointer_timing"/>
      </Cell>
      <Cell id="tab_styles" row="0" col="2" label="Indicators" icon="CirclesLeftRight" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_styles"/>
      </Cell>
      <Cell id="tab_assist" row="0" col="3" label="Assist" icon="IdeaIcon" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_assist"/>
      </Cell>
      <Cell id="tab_overlay" row="0" col="4" label="Tools" icon="LookToScrollActive" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_overlays"/>
      </Cell>
      <Cell id="tab_theme" row="0" col="5" label="Theme" icon="SettingsIcon" role="tab"/>
      <Cell id="tab_done" row="0" col="6" label="Done" icon="CollapseIcon">
        <ClosePage value="-self"/>
        <ClosePage value="main_settings"/>
      </Cell>
    </SubGrid>

    <Cell id="page_title" row="1" col="0" colSpan="16" label="Theme" caption="Appearance, accent, and progress variant" role="label" textStyle="title" style="plain"/>

    <SubGrid id="sec_appearance" row="2" col="0" colSpan="16" rowSpan="2" rows="2" columns="1" rowWeights="1,2" gap="6" margin="6" style="group">
      <Cell id="h_appearance" row="0" col="0" label="Appearance" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_appearance" row="1" col="0" rows="1" columns="4" gap="0" style="row">
        <Cell id="light" row="0" col="0" label="Light" role="choice" activeState="setting.theme.light" style="joinLeft" command="theme.light"/>
        <Cell id="light_tint" row="0" col="1" label="Light tint" role="choice" activeState="setting.theme.lightTinted" style="join" command="theme.lightTinted"/>
        <Cell id="dark_tint" row="0" col="2" label="Dark tint" role="choice" activeState="setting.theme.darkTinted" style="join" command="theme.darkTinted"/>
        <Cell id="dark" row="0" col="3" label="Dark" role="choice" activeState="setting.theme.dark" style="joinRight" command="theme.dark"/>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_schemes" row="4" col="0" colSpan="16" rowSpan="3" rows="2" columns="1" rowWeights="1,3" gap="6" margin="6" style="group">
      <Cell id="h_schemes" row="0" col="0" label="Accent" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_schemes" row="1" col="0" rows="1" columns="4" gap="8" style="row">
        <Cell id="pri_0" row="0" col="0" label="Blue" role="choice" activeState="setting.theme.primary.0" command="theme.primary.0"/>
        <Cell id="pri_1" row="0" col="1" label="Green" role="choice" activeState="setting.theme.primary.1" command="theme.primary.1"/>
        <Cell id="pri_2" row="0" col="2" label="Amber" role="choice" activeState="setting.theme.primary.2" command="theme.primary.2"/>
        <Cell id="pri_3" row="0" col="3" label="Red" role="choice" activeState="setting.theme.primary.3" command="theme.primary.3"/>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_progress" row="7" col="0" colSpan="16" rowSpan="3" rows="2" columns="1" rowWeights="1,3" gap="6" margin="6" style="group">
      <Cell id="h_progress" row="0" col="0" label="Progress" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_progress" row="1" col="0" rows="1" columns="4" gap="8" style="row">
        <Cell id="sec_0" row="0" col="0" label="Blue" role="choice" activeState="setting.theme.secondary.0" command="theme.secondary.0"/>
        <Cell id="sec_1" row="0" col="1" label="Green" role="choice" activeState="setting.theme.secondary.1" command="theme.secondary.1"/>
        <Cell id="sec_2" row="0" col="2" label="Amber" role="choice" activeState="setting.theme.secondary.2" command="theme.secondary.2"/>
        <Cell id="sec_3" row="0" col="3" label="Red" role="choice" activeState="setting.theme.secondary.3" command="theme.secondary.3"/>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_options" row="10" col="0" colSpan="16" rowSpan="2" rows="2" columns="1" rowWeights="1,1" gap="6" margin="6" style="group">
      <SubGrid id="row_saturation" row="0" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="sat_name" row="0" col="0" label="Saturation" caption="Five steps from quiet to vivid. Surface brightness stays put." role="label" style="plain"/>
        <SubGrid id="act_saturation" row="0" col="1" rows="1" columns="2" gap="0" style="row">
          <Cell id="sat_dec" row="0" col="0" label="−" style="joinLeft" command="settings.nudge.themeSaturation.dec"/>
          <Cell id="sat_inc" row="0" col="1" label="+" style="joinRight" command="settings.nudge.themeSaturation.inc"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_edit" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="edit_name" row="0" col="0" label="Edit colors" caption="Opens Custom on the role list." role="label" style="plain"/>
        <Cell id="edit_colors" row="0" col="1" label="Edit colors" icon="SettingsIcon" command="settings.theme.edit"/>
      </SubGrid>
    </SubGrid>
  </Grid>
</Page>
