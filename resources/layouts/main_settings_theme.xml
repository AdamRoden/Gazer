<Page id="main_settings_theme" name="Theme">
  <Style id="group" background="#00000000" thickness="1" radius="8"/>
  <Style id="row" background="#00000000" thickness="1" radius="6"/>
  <Style id="plain" background="#00000000" thickness="0" radius="0"/>
  <Style id="join" background="#00000000" thickness="0" radius="0"/>
  <Grid id="board" desktopMode="true" rows="9" columns="16" anchor="Top" offset="0,0" size="1600,1.0" gap="6" margin="12" aboveTaskbar="false" thickness="1" radius="4">
    <SubGrid id="tabs" row="0" col="0" colSpan="16" rows="1" columns="6" gap="6">
      <Cell id="tab_buttons" row="0" col="0" label="Button" role="tab">
        <Action id="Page" value="Close, Page, self"/>
        <Action id="Page" value="Open, Page, main_settings_button_timing"/>
      </Cell>
      <Cell id="tab_pointers" row="0" col="1" label="Pointer" role="tab">
        <Action id="Page" value="Close, Page, self"/>
        <Action id="Page" value="Open, Page, main_settings_pointer_timing"/>
      </Cell>
      <Cell id="tab_styles" row="0" col="2" label="Styles" role="tab">
        <Action id="Page" value="Close, Page, self"/>
        <Action id="Page" value="Open, Page, main_settings_styles"/>
      </Cell>
      <Cell id="tab_assist" row="0" col="3" label="Assist" role="tab">
        <Action id="Page" value="Close, Page, self"/>
        <Action id="Page" value="Open, Page, main_settings_assist"/>
      </Cell>
      <Cell id="tab_lts" row="0" col="4" label="LTS" role="tab">
        <Action id="Page" value="Close, Page, self"/>
        <Action id="Page" value="Open, Page, main_settings_lts"/>
      </Cell>
      <Cell id="tab_theme" row="0" col="5" label="Theme" role="tab" interactive="false"/>
    </SubGrid>

    <Cell id="page_title" row="1" col="0" colSpan="16" label="Theme" caption="Custom palette: pick colors, then set contrast to Low, Medium, or High." role="label" textStyle="title" style="plain"/>

    <SubGrid id="sec_palette" row="2" col="0" colSpan="16" rowSpan="7" rows="7" columns="1" rowWeights="1,2,2,2,2,2,2" gap="6" margin="6" style="group">
      <Cell id="h_palette" row="0" col="0" label="Palette" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_bg" row="1" col="0" rows="1" columns="1" gap="0" style="row">
        <Cell id="bg_name" row="0" col="0" label="Background" caption="Source color. Variant, foreground, and accent suggestions are generated from this." settingKey="customBgColor" cluster="swatch.bg" style="join">
          <Action id="Command" value="settings.edit.color.customBgColor"/>
        </Cell>
      </SubGrid>
      <SubGrid id="row_swatch" row="2" col="0" rows="1" columns="2" gap="0" style="row">
        <Cell id="var_sw" row="0" col="0" label="Variant" caption="Surface" settingKey="customSurfaceColor" cluster="swatch.pair" style="join">
          <Action id="Command" value="settings.edit.color.customSurfaceColor"/>
        </Cell>
        <Cell id="fg_sw" row="0" col="1" label="Foreground" caption="On background" settingKey="customTextColor" cluster="swatch.pair" style="join">
          <Action id="Command" value="settings.edit.color.customTextColor"/>
        </Cell>
      </SubGrid>
      <SubGrid id="row_accent" row="3" col="0" rows="1" columns="3" gap="0" style="row">
        <Cell id="pri_name" row="0" col="0" label="Primary" caption="Highlighted foreground." settingKey="customPrimaryColor" cluster="swatch.accent" style="join">
          <Action id="Command" value="settings.edit.color.customPrimaryColor"/>
        </Cell>
        <Cell id="sec_name" row="0" col="1" label="Secondary" caption="Progress colors." settingKey="customSecondaryColor" cluster="swatch.accent" style="join">
          <Action id="Command" value="settings.edit.color.customSecondaryColor"/>
        </Cell>
        <Cell id="ter_name" row="0" col="2" label="Tertiary" caption="Highlighted background." settingKey="customTertiaryColor" cluster="swatch.accent" style="join">
          <Action id="Command" value="settings.edit.color.customTertiaryColor"/>
        </Cell>
      </SubGrid>
      <SubGrid id="row_contrast" row="4" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="c_name" row="0" col="0" label="Contrast" caption="How far tones are pushed apart." role="label" style="plain"/>
        <SubGrid id="act_contrast" row="0" col="1" rows="1" columns="3" gap="0">
          <Cell id="c_low" row="0" col="0" label="Low" cluster="segment.contrast" activeState="setting.theme.contrast.low" style="join">
            <Action id="Command" value="settings.theme.contrast.low"/>
          </Cell>
          <Cell id="c_med" row="0" col="1" label="Medium" cluster="segment.contrast" activeState="setting.theme.contrast.medium" style="join">
            <Action id="Command" value="settings.theme.contrast.medium"/>
          </Cell>
          <Cell id="c_high" row="0" col="2" label="High" cluster="segment.contrast" activeState="setting.theme.contrast.high" style="join">
            <Action id="Command" value="settings.theme.contrast.high"/>
          </Cell>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_theme" row="5" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="mode_name" row="0" col="0" label="Use theme" caption="Custom applies this palette. Light / Dark use the built-in presets." role="label" style="plain"/>
        <SubGrid id="act_theme" row="0" col="1" rows="1" columns="3" gap="0">
          <Cell id="light" row="0" col="0" label="Light" cluster="segment.theme" activeState="setting.theme.light" style="join">
            <Action id="Command" value="theme.light"/>
          </Cell>
          <Cell id="dark" row="0" col="1" label="Dark" cluster="segment.theme" activeState="setting.theme.dark" style="join">
            <Action id="Command" value="theme.dark"/>
          </Cell>
          <Cell id="custom" row="0" col="2" label="Custom" cluster="segment.theme" activeState="setting.theme.custom" style="join">
            <Action id="Command" value="theme.custom"/>
          </Cell>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_flash" row="6" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="fl_name" row="0" col="0" label="Completion flash" caption="Flash after activation. Foreground uses the item text color; Custom picks a color." role="label" style="plain"/>
        <SubGrid id="act_flash" row="0" col="1" rows="1" columns="3" gap="0">
          <Cell id="fl_fg" row="0" col="0" label="Use Foreground" cluster="segment.flash" activeState="setting.flashUseForeground" style="join">
            <Action id="Command" value="settings.flash.foreground"/>
          </Cell>
          <Cell id="fl_custom" row="0" col="1" label="Custom" cluster="segment.flash" activeState="setting.flashUseCustom" style="join">
            <Action id="Command" value="settings.flash.custom"/>
          </Cell>
          <Cell id="fl_sw" row="0" col="2" label="Flash color" settingKey="flashColor" cluster="segment.flash" style="join">
            <Action id="Command" value="settings.edit.color.flashColor"/>
          </Cell>
        </SubGrid>
      </SubGrid>
    </SubGrid>
  </Grid>
</Page>
