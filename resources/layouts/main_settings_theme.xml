<Page id="main_settings_theme" name="Theme" radius="16">
  <Style id="group" thickness="0" radius="16"/>
  <Style id="row" background="#00000000" thickness="0" radius="0"/>
  <Style id="plain" background="#00000000" thickness="0" radius="0"/>
  <Style id="join" background="#00000000" thickness="0" radius="0"/>
  <Style id="joinLeft" background="#00000000" thickness="0" radius="10,0,0,10"/>
  <Style id="joinRight" background="#00000000" thickness="0" radius="0,10,10,0"/>
  <Style id="tabbar" thickness="0" radius="12"/>
  <Grid id="board" desktopMode="true" rows="12" columns="16" anchor="Top" offset="0,0" size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth), A_ScreenHeight" gap="8" margin="20" radius="16"
        rowWeights="1,0.85,1.15,1.15,1.15,1.15,1.15,1.15,1.15,1.15,1.15,1.15">
    <SubGrid id="tabs" row="0" col="0" colSpan="16" rows="1" columns="8" gap="6" margin="4" style="tabbar">
      <Cell id="tab_speed" row="0" col="0" label="Speed" icon="timer" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_speed"/>
      </Cell>
      <Cell id="tab_magnify" row="0" col="1" label="Magnify" icon="ZoomSettings" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_magnify"/>
      </Cell>
      <Cell id="tab_indicators" row="0" col="2" label="Indicators" icon="cycle" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_indicators"/>
      </Cell>
      <Cell id="tab_assist" row="0" col="3" label="Assist" icon="ideas" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_assist"/>
      </Cell>
      <Cell id="tab_tools" row="0" col="4" label="Tools" icon="lookToScroll" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_tools"/>
      </Cell>
      <Cell id="tab_theme" row="0" col="5" label="Theme" icon="palette" role="tab"/>
      <Cell id="tab_speech" row="0" col="6" label="Speech" icon="Speak" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_speech"/>
      </Cell>
      <Cell id="tab_done" row="0" col="7" label="Done" icon="keyboardHide">
        <CloseAllPages/>
      </Cell>
    </SubGrid>

    <Cell id="page_title" row="1" col="0" colSpan="16" label="Theme" caption="Background, surfaces, accent, and progress" role="label" textStyle="title" style="plain"/>

    <SubGrid id="theme_columns" row="2" col="0" rowSpan="10" colSpan="16" rows="1" columns="2" gap="16">
      <SubGrid id="sec_surfaces" row="0" col="0" rows="4" columns="1" rowWeights="0.9,1.3,1.6,1.8" gap="8" margin="8" style="group">
        <Cell id="h_surfaces" row="0" col="0" label="Background and Surface" role="label" textStyle="section" style="plain"/>
        <SubGrid id="row_appearance" row="1" col="0" rows="1" columns="3" gap="0" style="row">
          <Cell id="theme_l_d" row="0" col="0" label="Theme" role="label" style="plain"/>
          <Cell id="light" row="0" col="1" label="Light" role="choice" activeState="theme.light" style="joinLeft" command="theme.light"/>
          <Cell id="dark" row="0" col="2" label="Dark" role="choice" activeState="theme.dark" style="joinRight" command="theme.dark"/>
        </SubGrid>
        <SubGrid id="row_shade" row="2" col="0" rows="1" columns="7" gap="0" style="row">
          <Cell id="h_shade" row="0" col="0" colSpan="2" label="Shade" role="label" style="plain"/>
          <Cell id="shade_bg_0" row="0" col="2" role="choice" activeState="theme.brightness.0" style="joinLeft" command="theme.brightness.0"/>
          <Cell id="shade_bg_1" row="0" col="3" role="choice" activeState="theme.brightness.1" style="join" command="theme.brightness.1"/>
          <Cell id="shade_bg_2" row="0" col="4" role="choice" activeState="theme.brightness.2" style="join" command="theme.brightness.2"/>
          <Cell id="shade_bg_3" row="0" col="5" role="choice" activeState="theme.brightness.3" style="join" command="theme.brightness.3"/>
          <Cell id="shade_bg_4" row="0" col="6" role="choice" activeState="theme.brightness.4" style="joinRight" command="theme.brightness.4"/>
        </SubGrid>
        <SubGrid id="row_tint" row="3" col="0" rows="1" columns="9" gap="6" style="row">
          <Cell id="h_tint" row="0" col="0" colSpan="2" label="Tint" role="label" style="plain"/>
          <Cell id="tint_none" row="0" col="2" role="swatch" activeState="theme.tint.none" command="theme.tint.none"/>
          <Cell id="tint_primary" row="0" col="3" role="swatch" activeState="theme.tint.primary" command="theme.tint.primary"/>
          <Cell id="tint_complementary" row="0" col="4" role="swatch" activeState="theme.tint.complementary" command="theme.tint.complementary"/>
          <Cell id="tint_analogous1" row="0" col="5" role="swatch" activeState="theme.tint.analogous1" command="theme.tint.analogous1"/>
          <Cell id="tint_analogous2" row="0" col="6" role="swatch" activeState="theme.tint.analogous2" command="theme.tint.analogous2"/>
          <Cell id="tint_tertiary1" row="0" col="7" role="swatch" activeState="theme.tint.tertiary1" command="theme.tint.tertiary1"/>
          <Cell id="tint_tertiary2" row="0" col="8" role="swatch" activeState="theme.tint.tertiary2" command="theme.tint.tertiary2"/>
        </SubGrid>
      </SubGrid>

      <SubGrid id="sec_accents" row="0" col="1" rows="10" columns="1" rowWeights="0.85,1.1,1.1,0.7,1.15,1.15,1.15,1.15,1.15,1.15" gap="8" margin="8" style="group">
        <Cell id="h_accents" row="0" col="0" label="Accent and Progress" role="label" textStyle="section" style="plain"/>
        <SubGrid id="row_primary" row="1" col="0" rows="1" columns="2" gap="8" style="row">
          <Cell id="h_primary" row="0" col="0" label="Primary accent color" role="label" style="plain"/>
          <Cell id="p_swatch" row="0" col="1" role="swatch" settingKey="customPrimaryColor" command="settings.edit.color.customPrimaryColor"/>
        </SubGrid>
        <SubGrid id="row_progress" row="2" col="0" rows="1" columns="2" gap="8" style="row">
          <Cell id="h_progress" row="0" col="0" label="Progress" role="label" style="plain"/>
          <Cell id="s_swatch" row="0" col="1" role="swatch" settingKey="customSecondaryColor" command="settings.edit.color.customSecondaryColor"/>
        </SubGrid>
        <Cell id="h_suggestions" row="3" col="0" label="Secondary suggestions" role="label" textStyle="section" style="plain"/>
        <SubGrid id="row_pal_primary" row="4" col="0" rows="1" columns="11" gap="0" style="row">
          <Cell id="h_pal_primary" row="0" col="0" colSpan="2" label="Primary" role="label" style="plain"/>
