        <SubGrid id="row_pal_tertiary1" row="8" col="0" rows="1" columns="11" gap="0" style="row">
          <Cell id="h_pal_tertiary1" row="0" col="0" colSpan="2" label="Tertiary" role="label" style="plain"/>
          <Cell id="pal_tertiary1_9" row="0" col="2" style="joinLeft" command="settings.theme.shade.tertiary1.9"/>
