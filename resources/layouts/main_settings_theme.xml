<Page id="main_settings_theme" name="Theme" radius="16">
  <Style id="group" background="bg95" thickness="0" radius="16"/>
  <Style id="row" background="transparent" thickness="0" radius="0"/>
  <Style id="plain" background="transparent" thickness="0" radius="0"/>
  <Style id="join" background="transparent" thickness="0" radius="0"/>
  <Style id="joinLeft" background="transparent" thickness="0" radius="10,0,0,10"/>
  <Style id="joinRight" background="transparent" thickness="0" radius="0,10,10,0"/>
  <Grid id="board" desktopMode="true" rows="9" columns="16" anchor="Top" offset="0,0" size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth), A_ScreenHeight" gap="6" margin="12" radius="16">
    <Cell id="page_title" row="0" col="0" colSpan="16" label="Theme" caption="Background, accent, and progress" role="label" textStyle="title" style="plain"/>
    <SubGrid id="theme_columns" row="1" col="0" rowSpan="7" colSpan="16" rows="1" columns="2" gap="16">

      <SubGrid id="sec_surfaces" row="0" col="0" rows="6" columns="2" rowHeights="0.5*,1.5*,1.5*,1.5*,1.5*,1.5*" columnWidths="1*,3*" gap="8" margin="8" style="group">
        <Cell id="h_surfaces" row="0" col="0" colSpan="2" label="Background" role="label" textStyle="section" style="plain"/>
        <Cell id="theme_l_d" row="1" col="0" label="Theme" role="label" style="plain"/>
        <SubGrid id="row_appearance" row="1" col="1" rows="1" columns="2" gap="0" style="row">
          <Cell id="light" row="0" col="0" label="Light" role="choice" activeState="theme.light" style="joinLeft" command="theme.light"/>
          <Cell id="dark" row="0" col="1" label="Dark" role="choice" activeState="theme.dark" style="joinRight" command="theme.dark"/>
        </SubGrid>
        <Cell id="h_shade" row="2" col="0" label="Shade" role="label" style="plain"/>
        <SubGrid id="row_shade" row="2" col="1" rows="1" columns="5" gap="0" style="row">
          <Cell id="shade_bg_0" row="0" col="0" role="choice" activeState="theme.brightness.0" style="joinLeft" command="theme.brightness.0"/>
          <Cell id="shade_bg_1" row="0" col="1" role="choice" activeState="theme.brightness.1" style="join" command="theme.brightness.1"/>
          <Cell id="shade_bg_2" row="0" col="2" role="choice" activeState="theme.brightness.2" style="join" command="theme.brightness.2"/>
          <Cell id="shade_bg_3" row="0" col="3" role="choice" activeState="theme.brightness.3" style="join" command="theme.brightness.3"/>
          <Cell id="shade_bg_4" row="0" col="4" role="choice" activeState="theme.brightness.4" style="joinRight" command="theme.brightness.4"/>
        </SubGrid>
        <Cell id="h_tint" row="3" col="0" label="Tint" role="label" style="plain"/>
        <SubGrid id="row_tint" row="3" col="1" rows="1" columns="7" gap="6" style="row">
          <Cell id="tint_none" row="0" col="0" role="swatch" activeState="theme.tint.none" command="theme.tint.none"/>
          <Cell id="tint_primary" row="0" col="1" role="swatch" activeState="theme.tint.primary" command="theme.tint.primary"/>
          <Cell id="tint_complementary" row="0" col="2" role="swatch" activeState="theme.tint.complementary" command="theme.tint.complementary"/>
          <Cell id="tint_analogous1" row="0" col="3" role="swatch" activeState="theme.tint.analogous1" command="theme.tint.analogous1"/>
          <Cell id="tint_analogous2" row="0" col="4" role="swatch" activeState="theme.tint.analogous2" command="theme.tint.analogous2"/>
          <Cell id="tint_tertiary1" row="0" col="5" role="swatch" activeState="theme.tint.tertiary1" command="theme.tint.tertiary1"/>
          <Cell id="tint_tertiary2" row="0" col="6" role="swatch" activeState="theme.tint.tertiary2" command="theme.tint.tertiary2"/>
        </SubGrid>
        <Cell id="hv_name" row="4" col="0" label="Hover" caption="Defaults to progress color" role="label" style="plain"/>
        <SubGrid id="act_hover" row="4" col="1" rows="1" columns="3" columnWidths="2*,2*,1*" gap="6" style="row">
          <SubGrid id="act_hv_w" row="0" col="0" rows="1" columns="3" columnWidths="1*,2*,1*" gap="0" style="row">
            <Cell id="hv_dec" row="0" col="0" label="−" style="joinLeft" command="settings.nudge.hoverBorderWeight.dec"/>
            <Cell id="hv_val" row="0" col="1" label="—" role="value" settingKey="hoverBorderWeight" style="join"/>
            <Cell id="hv_inc" row="0" col="2" label="+" style="joinRight" command="settings.nudge.hoverBorderWeight.inc"/>
          </SubGrid>
          <Cell id="hv_custom" row="0" col="1" label="Custom" role="toggle" activeState="settings.hover.custom.toggle" command="settings.hover.custom.toggle"/>
          <Cell id="hv_sw" row="0" col="2" role="swatch" settingKey="hoverColor" visibleWhen="hover_custom" command="settings.edit.color.hoverColor"/>
        </SubGrid>
        <Cell id="fl_name" row="5" col="0" label="Flash" caption="Defaults to foreground" role="label" style="plain"/>
        <SubGrid id="act_flash" row="5" col="1" rows="1" columns="3" columnWidths="2*,2*,1*" gap="6" style="row">
          <SubGrid id="act_fl_ms" row="0" col="0" rows="1" columns="3" columnWidths="1*,2*,1*" gap="0" style="row">
            <Cell id="fl_dec" row="0" col="0" label="−" style="joinLeft" command="settings.nudge.flashMs.dec"/>
            <Cell id="fl_val" row="0" col="1" label="—" role="value" settingKey="flashMs" style="join"/>
            <Cell id="fl_inc" row="0" col="2" label="+" style="joinRight" command="settings.nudge.flashMs.inc"/>
          </SubGrid>
          <Cell id="fl_custom" row="0" col="1" label="Custom" role="toggle" activeState="settings.flash.custom.toggle" command="settings.flash.custom.toggle"/>
          <Cell id="fl_sw" row="0" col="2" role="swatch" settingKey="flashColor" visibleWhen="flash_custom" command="settings.edit.color.flashColor"/>
        </SubGrid>
      </SubGrid>

      <SubGrid id="sec_accents" row="0" col="1" rows="10" columns="2" rowHeights="*,1.5*,*,1.15*,1.15*,1.15*,1.15*,1.15*,1.15*,1.15*" columnWidths="1*,4*" gap="8" margin="8" style="group">
        <Cell id="h_accents" row="0" col="0" colSpan="2" label="Accent Colors" role="label" textStyle="section" style="plain"/>
        <SubGrid id="row_primary" row="1" col="0" colSpan="2" rows="1" columns="4" gap="8" style="row">
          <Cell id="pc" row="0" col="0" label="Highlight" role="label" style="plain"/>
          <Cell id="p_swatch" row="0" col="1" role="swatch" settingKey="customPrimaryColor" command="settings.edit.color.customPrimaryColor"/>
          <Cell id="sc" row="0" col="2" label="Progress" role="label" style="plain"/>
          <Cell id="s_swatch" row="0" col="3" role="swatch" settingKey="customSecondaryColor" command="settings.edit.color.customSecondaryColor"/>
        </SubGrid>
        <Cell id="h_suggestions" row="2" col="0" colSpan="2" label="Recommended Progress Choices" role="label" textStyle="section" style="plain"/>
        <Cell id="h_pal_primary" row="3" col="0" label="Primary" role="label" style="plain"/>
        <SubGrid id="row_pal_primary" row="3" col="1" rows="1" columns="9" gap="0" style="row">
          <Cell id="pal_primary_9" row="0" col="0" style="joinLeft" command="settings.theme.shade.primary.9"/>
          <Cell id="pal_primary_8" row="0" col="1" style="join" command="settings.theme.shade.primary.8"/>
          <Cell id="pal_primary_7" row="0" col="2" style="join" command="settings.theme.shade.primary.7"/>
          <Cell id="pal_primary_6" row="0" col="3" style="join" command="settings.theme.shade.primary.6"/>
          <Cell id="pal_primary_5" row="0" col="4" style="join" command="settings.theme.shade.primary.5"/>
          <Cell id="pal_primary_4" row="0" col="5" style="join" command="settings.theme.shade.primary.4"/>
          <Cell id="pal_primary_3" row="0" col="6" style="join" command="settings.theme.shade.primary.3"/>
          <Cell id="pal_primary_2" row="0" col="7" style="join" command="settings.theme.shade.primary.2"/>
          <Cell id="pal_primary_1" row="0" col="8" style="joinRight" command="settings.theme.shade.primary.1"/>
        </SubGrid>
        <Cell id="h_pal_complementary" row="4" col="0" label="Complementary" role="label" style="plain"/>
        <SubGrid id="row_pal_complementary" row="4" col="1" rows="1" columns="9" gap="0" style="row">
          <Cell id="pal_complementary_9" row="0" col="0" style="joinLeft" command="settings.theme.shade.complementary.9"/>
          <Cell id="pal_complementary_8" row="0" col="1" style="join" command="settings.theme.shade.complementary.8"/>
          <Cell id="pal_complementary_7" row="0" col="2" style="join" command="settings.theme.shade.complementary.7"/>
          <Cell id="pal_complementary_6" row="0" col="3" style="join" command="settings.theme.shade.complementary.6"/>
          <Cell id="pal_complementary_5" row="0" col="4" style="join" command="settings.theme.shade.complementary.5"/>
          <Cell id="pal_complementary_4" row="0" col="5" style="join" command="settings.theme.shade.complementary.4"/>
          <Cell id="pal_complementary_3" row="0" col="6" style="join" command="settings.theme.shade.complementary.3"/>
          <Cell id="pal_complementary_2" row="0" col="7" style="join" command="settings.theme.shade.complementary.2"/>
          <Cell id="pal_complementary_1" row="0" col="8" style="joinRight" command="settings.theme.shade.complementary.1"/>
        </SubGrid>
        <Cell id="h_pal_analogous1" row="5" col="0" label="Analogous 1" role="label" style="plain"/>
        <SubGrid id="row_pal_analogous1" row="5" col="1" rows="1" columns="9" gap="0" style="row">
          <Cell id="pal_analogous1_9" row="0" col="0" style="joinLeft" command="settings.theme.shade.analogous1.9"/>
          <Cell id="pal_analogous1_8" row="0" col="1" style="join" command="settings.theme.shade.analogous1.8"/>
          <Cell id="pal_analogous1_7" row="0" col="2" style="join" command="settings.theme.shade.analogous1.7"/>
          <Cell id="pal_analogous1_6" row="0" col="3" style="join" command="settings.theme.shade.analogous1.6"/>
          <Cell id="pal_analogous1_5" row="0" col="4" style="join" command="settings.theme.shade.analogous1.5"/>
          <Cell id="pal_analogous1_4" row="0" col="5" style="join" command="settings.theme.shade.analogous1.4"/>
          <Cell id="pal_analogous1_3" row="0" col="6" style="join" command="settings.theme.shade.analogous1.3"/>
          <Cell id="pal_analogous1_2" row="0" col="7" style="join" command="settings.theme.shade.analogous1.2"/>
          <Cell id="pal_analogous1_1" row="0" col="8" style="joinRight" command="settings.theme.shade.analogous1.1"/>
        </SubGrid>
        <Cell id="h_pal_analogous2" row="6" col="0" label="Analogous 2" role="label" style="plain"/>
        <SubGrid id="row_pal_analogous2" row="6" col="1" rows="1" columns="9" gap="0" style="row">
          <Cell id="pal_analogous2_9" row="0" col="0" style="joinLeft" command="settings.theme.shade.analogous2.9"/>
          <Cell id="pal_analogous2_8" row="0" col="1" style="join" command="settings.theme.shade.analogous2.8"/>
          <Cell id="pal_analogous2_7" row="0" col="2" style="join" command="settings.theme.shade.analogous2.7"/>
          <Cell id="pal_analogous2_6" row="0" col="3" style="join" command="settings.theme.shade.analogous2.6"/>
          <Cell id="pal_analogous2_5" row="0" col="4" style="join" command="settings.theme.shade.analogous2.5"/>
          <Cell id="pal_analogous2_4" row="0" col="5" style="join" command="settings.theme.shade.analogous2.4"/>
          <Cell id="pal_analogous2_3" row="0" col="6" style="join" command="settings.theme.shade.analogous2.3"/>
          <Cell id="pal_analogous2_2" row="0" col="7" style="join" command="settings.theme.shade.analogous2.2"/>
          <Cell id="pal_analogous2_1" row="0" col="8" style="joinRight" command="settings.theme.shade.analogous2.1"/>
        </SubGrid>
        <Cell id="h_pal_tertiary1" row="7" col="0" label="Tertiary 1" role="label" style="plain"/>
        <SubGrid id="row_pal_tertiary1" row="7" col="1" rows="1" columns="9" gap="0" style="row">
          <Cell id="pal_tertiary1_9" row="0" col="0" style="joinLeft" command="settings.theme.shade.tertiary1.9"/>
          <Cell id="pal_tertiary1_8" row="0" col="1" style="join" command="settings.theme.shade.tertiary1.8"/>
          <Cell id="pal_tertiary1_7" row="0" col="2" style="join" command="settings.theme.shade.tertiary1.7"/>
          <Cell id="pal_tertiary1_6" row="0" col="3" style="join" command="settings.theme.shade.tertiary1.6"/>
          <Cell id="pal_tertiary1_5" row="0" col="4" style="join" command="settings.theme.shade.tertiary1.5"/>
          <Cell id="pal_tertiary1_4" row="0" col="5" style="join" command="settings.theme.shade.tertiary1.4"/>
          <Cell id="pal_tertiary1_3" row="0" col="6" style="join" command="settings.theme.shade.tertiary1.3"/>
          <Cell id="pal_tertiary1_2" row="0" col="7" style="join" command="settings.theme.shade.tertiary1.2"/>
          <Cell id="pal_tertiary1_1" row="0" col="8" style="joinRight" command="settings.theme.shade.tertiary1.1"/>
        </SubGrid>
        <Cell id="h_pal_tertiary2" row="8" col="0" label="Tertiary 2" role="label" style="plain"/>
        <SubGrid id="row_pal_tertiary2" row="8" col="1" rows="1" columns="9" gap="0" style="row">
          <Cell id="pal_tertiary2_9" row="0" col="0" style="joinLeft" command="settings.theme.shade.tertiary2.9"/>
          <Cell id="pal_tertiary2_8" row="0" col="1" style="join" command="settings.theme.shade.tertiary2.8"/>
          <Cell id="pal_tertiary2_7" row="0" col="2" style="join" command="settings.theme.shade.tertiary2.7"/>
          <Cell id="pal_tertiary2_6" row="0" col="3" style="join" command="settings.theme.shade.tertiary2.6"/>
          <Cell id="pal_tertiary2_5" row="0" col="4" style="join" command="settings.theme.shade.tertiary2.5"/>
          <Cell id="pal_tertiary2_4" row="0" col="5" style="join" command="settings.theme.shade.tertiary2.4"/>
          <Cell id="pal_tertiary2_3" row="0" col="6" style="join" command="settings.theme.shade.tertiary2.3"/>
          <Cell id="pal_tertiary2_2" row="0" col="7" style="join" command="settings.theme.shade.tertiary2.2"/>
          <Cell id="pal_tertiary2_1" row="0" col="8" style="joinRight" command="settings.theme.shade.tertiary2.1"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>
  </Grid>
</Page>
