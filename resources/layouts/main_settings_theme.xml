<?xml version="1.0" encoding="UTF-8"?>
<Page id="main_settings_theme" name="Theme" radius="16">
  <Style id="row" background="transparent" thickness="0" radius="0"/>
  <Style id="join" background="transparent" thickness="0" radius="0"/>
  <Style id="plain" background="transparent" thickness="0" radius="0"/>
  <Style id="button" background="transparent" thickness="0" radius="10"/>
  <Style id="joinLeft" background="transparent" thickness="0" radius="10,0,0,10"/>
  <Style id="group" background="bg95" thickness="0" radius="16"/>
  <Style id="joinRight" background="transparent" thickness="0" radius="0,10,10,0"/>
  <Grid id="board" rows="2" columns="2" desktopMode="true" anchor="Top" offset="0,0" size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth),A_ScreenHeight" gap="12" rowHeights="96,*" columnWidths="*,72" radius="16">
    <Row id="titlebar" columns="2" span="2" gap="8" columnWidths="*,160" style="plain">
      <Label id="page_title" style="plain" label="Theme" caption="Background, accent, and progress" textStyle="title"/>
      <Button id="tab_done" style="button" label="Close" icon="keyboardHide" textStyle="row" closeAllPages="true"/>
    </Row>
    <Column id="scroller" rows="2" row="1" gap="12" rowHeights="552,640" scroll="true">
      <Grid id="sec_surfaces" rows="6" columns="2" gap="8" padding="8" rowHeights="48,96,80,80,96,96" columnWidths="*,3*" style="group">
        <Label id="h_surfaces" style="plain" label="Background" textStyle="section" span="2"/>
        <Label style="plain" label="Theme" row="1"/>
        <Label id="h_shade" style="plain" label="Shade" row="2"/>
        <Label id="h_tint" style="plain" label="Tint" row="3"/>
        <Label id="hv_name" style="plain" label="Hover" caption="Defaults to progress color" row="4"/>
        <Label id="fl_name" style="plain" label="Flash" caption="Defaults to foreground" row="5"/>
        <Row columns="2" row="1" col="1" style="row">
          <Choice id="light" style="joinLeft" label="Light" bind="theme.light" command="theme.light"/>
          <Choice id="dark" style="joinRight" label="Dark" bind="theme.dark" command="theme.dark"/>
        </Row>
        <Row columns="5" row="2" col="1" style="row">
          <Choice id="shade_bg_0" style="joinLeft" bind="theme.brightness.0" command="theme.brightness.0"/>
          <Choice id="shade_bg_1" style="join" bind="theme.brightness.1" command="theme.brightness.1"/>
          <Choice id="shade_bg_2" style="join" bind="theme.brightness.2" command="theme.brightness.2"/>
          <Choice id="shade_bg_3" style="join" bind="theme.brightness.3" command="theme.brightness.3"/>
          <Choice id="shade_bg_4" style="joinRight" bind="theme.brightness.4" command="theme.brightness.4"/>
        </Row>
        <Row columns="7" row="3" col="1" gap="6" style="row">
          <Swatch id="tint_none" bind="theme.tint.none" command="theme.tint.none"/>
          <Swatch id="tint_primary" bind="theme.tint.primary" command="theme.tint.primary"/>
          <Swatch id="tint_complementary" bind="theme.tint.complementary" command="theme.tint.complementary"/>
          <Swatch id="tint_analogous1" bind="theme.tint.analogous1" command="theme.tint.analogous1"/>
          <Swatch id="tint_analogous2" bind="theme.tint.analogous2" command="theme.tint.analogous2"/>
          <Swatch id="tint_tertiary1" bind="theme.tint.tertiary1" command="theme.tint.tertiary1"/>
          <Swatch id="tint_tertiary2" bind="theme.tint.tertiary2" command="theme.tint.tertiary2"/>
        </Row>
        <Row id="act_hover" columns="3" row="4" col="1" gap="6" columnWidths="2*,2*,*" style="row">
          <Switch id="hv_custom" style="button" label="Custom" bind="settings.hover.custom.toggle" col="1" command="settings.hover.custom.toggle"/>
          <Swatch id="hv_sw" settingKey="hoverColor" visibleWhen="hover_custom" col="2" command="settings.edit.color.hoverColor"/>
          <Row id="act_hv_w" columns="3" columnWidths="*,2*,*" style="row">
            <Button style="joinLeft" label="−" command="settings.nudge.hoverBorderWeight.dec"/>
            <Label id="hv_val" style="join" label="—" settingKey="hoverBorderWeight" role="value"/>
            <Button style="joinRight" label="+" command="settings.nudge.hoverBorderWeight.inc"/>
          </Row>
        </Row>
        <Row id="act_flash" columns="3" row="5" col="1" gap="6" columnWidths="2*,2*,*" style="row">
          <Switch id="fl_custom" style="button" label="Custom" bind="settings.flash.custom.toggle" col="1" command="settings.flash.custom.toggle"/>
          <Swatch id="fl_sw" settingKey="flashColor" visibleWhen="flash_custom" col="2" command="settings.edit.color.flashColor"/>
          <Row columns="3" columnWidths="*,2*,*" style="row">
            <Button style="joinLeft" label="−" command="settings.nudge.flashMs.dec"/>
            <Label id="fl_val" style="join" label="—" settingKey="flashMs" role="value"/>
            <Button style="joinRight" label="+" command="settings.nudge.flashMs.inc"/>
          </Row>
        </Row>
      </Grid>
      <Grid id="sec_accents" rows="9" columns="2" gap="8" padding="8" rowHeights="48,80,48,64,64,64,64,64,64" columnWidths="*,4*" style="group">
        <Label id="h_accents" style="plain" label="Accent Colors" textStyle="section" span="2"/>
        <Label id="h_suggestions" style="plain" label="Recommended Progress Choices" textStyle="section" row="2" span="2"/>
        <Label id="h_pal_primary" style="plain" label="Primary" row="3"/>
        <Label id="h_pal_complementary" style="plain" label="Complementary" row="4"/>
        <Label id="h_pal_analogous1" style="plain" label="Analogous 1" row="5"/>
        <Label id="h_pal_analogous2" style="plain" label="Analogous 2" row="6"/>
        <Label id="h_pal_tertiary1" style="plain" label="Tertiary 1" row="7"/>
        <Label id="h_pal_tertiary2" style="plain" label="Tertiary 2" row="8"/>
        <Row columns="4" row="1" span="2" gap="8" style="row">
          <Label id="pc" style="plain" label="Highlight"/>
          <Swatch id="p_swatch" settingKey="customPrimaryColor" command="settings.edit.color.customPrimaryColor"/>
          <Label id="sc" style="plain" label="Progress"/>
          <Swatch id="s_swatch" settingKey="customSecondaryColor" command="settings.edit.color.customSecondaryColor"/>
        </Row>
        <Row id="row_pal_primary" columns="9" row="3" col="1" style="row">
          <Button id="pal_primary_9" style="joinLeft" command="settings.theme.shade.primary.9"/>
          <Button id="pal_primary_8" style="join" command="settings.theme.shade.primary.8"/>
          <Button id="pal_primary_7" style="join" command="settings.theme.shade.primary.7"/>
          <Button id="pal_primary_6" style="join" command="settings.theme.shade.primary.6"/>
          <Button id="pal_primary_5" style="join" command="settings.theme.shade.primary.5"/>
          <Button id="pal_primary_4" style="join" command="settings.theme.shade.primary.4"/>
          <Button id="pal_primary_3" style="join" command="settings.theme.shade.primary.3"/>
          <Button id="pal_primary_2" style="join" command="settings.theme.shade.primary.2"/>
          <Button id="pal_primary_1" style="joinRight" command="settings.theme.shade.primary.1"/>
        </Row>
        <Row columns="9" row="4" col="1" style="row">
          <Button id="pal_complementary_9" style="joinLeft" command="settings.theme.shade.complementary.9"/>
          <Button id="pal_complementary_8" style="join" command="settings.theme.shade.complementary.8"/>
          <Button id="pal_complementary_7" style="join" command="settings.theme.shade.complementary.7"/>
          <Button id="pal_complementary_6" style="join" command="settings.theme.shade.complementary.6"/>
          <Button id="pal_complementary_5" style="join" command="settings.theme.shade.complementary.5"/>
          <Button id="pal_complementary_4" style="join" command="settings.theme.shade.complementary.4"/>
          <Button id="pal_complementary_3" style="join" command="settings.theme.shade.complementary.3"/>
          <Button id="pal_complementary_2" style="join" command="settings.theme.shade.complementary.2"/>
          <Button id="pal_complementary_1" style="joinRight" command="settings.theme.shade.complementary.1"/>
        </Row>
        <Row id="row_pal_analogous1" columns="9" row="5" col="1" style="row">
          <Button id="pal_analogous1_9" style="joinLeft" command="settings.theme.shade.analogous1.9"/>
          <Button id="pal_analogous1_8" style="join" command="settings.theme.shade.analogous1.8"/>
          <Button id="pal_analogous1_7" style="join" command="settings.theme.shade.analogous1.7"/>
          <Button id="pal_analogous1_6" style="join" command="settings.theme.shade.analogous1.6"/>
          <Button id="pal_analogous1_5" style="join" command="settings.theme.shade.analogous1.5"/>
          <Button id="pal_analogous1_4" style="join" command="settings.theme.shade.analogous1.4"/>
          <Button id="pal_analogous1_3" style="join" command="settings.theme.shade.analogous1.3"/>
          <Button id="pal_analogous1_2" style="join" command="settings.theme.shade.analogous1.2"/>
          <Button id="pal_analogous1_1" style="joinRight" command="settings.theme.shade.analogous1.1"/>
        </Row>
        <Row id="row_pal_analogous2" columns="9" row="6" col="1" style="row">
          <Button id="pal_analogous2_9" style="joinLeft" command="settings.theme.shade.analogous2.9"/>
          <Button id="pal_analogous2_8" style="join" command="settings.theme.shade.analogous2.8"/>
          <Button id="pal_analogous2_7" style="join" command="settings.theme.shade.analogous2.7"/>
          <Button id="pal_analogous2_6" style="join" command="settings.theme.shade.analogous2.6"/>
          <Button id="pal_analogous2_5" style="join" command="settings.theme.shade.analogous2.5"/>
          <Button id="pal_analogous2_4" style="join" command="settings.theme.shade.analogous2.4"/>
          <Button id="pal_analogous2_3" style="join" command="settings.theme.shade.analogous2.3"/>
          <Button id="pal_analogous2_2" style="join" command="settings.theme.shade.analogous2.2"/>
          <Button id="pal_analogous2_1" style="joinRight" command="settings.theme.shade.analogous2.1"/>
        </Row>
        <Row id="row_pal_tertiary1" columns="9" row="7" col="1" style="row">
          <Button id="pal_tertiary1_9" style="joinLeft" command="settings.theme.shade.tertiary1.9"/>
          <Button id="pal_tertiary1_8" style="join" command="settings.theme.shade.tertiary1.8"/>
          <Button id="pal_tertiary1_7" style="join" command="settings.theme.shade.tertiary1.7"/>
          <Button id="pal_tertiary1_6" style="join" command="settings.theme.shade.tertiary1.6"/>
          <Button id="pal_tertiary1_5" style="join" command="settings.theme.shade.tertiary1.5"/>
          <Button id="pal_tertiary1_4" style="join" command="settings.theme.shade.tertiary1.4"/>
          <Button id="pal_tertiary1_3" style="join" command="settings.theme.shade.tertiary1.3"/>
          <Button id="pal_tertiary1_2" style="join" command="settings.theme.shade.tertiary1.2"/>
          <Button id="pal_tertiary1_1" style="joinRight" command="settings.theme.shade.tertiary1.1"/>
        </Row>
        <Row id="row_pal_tertiary2" columns="9" row="8" col="1" style="row">
          <Button id="pal_tertiary2_9" style="joinLeft" command="settings.theme.shade.tertiary2.9"/>
          <Button id="pal_tertiary2_8" style="join" command="settings.theme.shade.tertiary2.8"/>
          <Button id="pal_tertiary2_7" style="join" command="settings.theme.shade.tertiary2.7"/>
          <Button id="pal_tertiary2_6" style="join" command="settings.theme.shade.tertiary2.6"/>
          <Button id="pal_tertiary2_5" style="join" command="settings.theme.shade.tertiary2.5"/>
          <Button id="pal_tertiary2_4" style="join" command="settings.theme.shade.tertiary2.4"/>
          <Button id="pal_tertiary2_3" style="join" command="settings.theme.shade.tertiary2.3"/>
          <Button id="pal_tertiary2_2" style="join" command="settings.theme.shade.tertiary2.2"/>
          <Button id="pal_tertiary2_1" style="joinRight" command="settings.theme.shade.tertiary2.1"/>
        </Row>
      </Grid>
    </Column>
    <Card id="page_scroll" rows="3" row="1" col="1" gap="6" rowHeights="72,*,72" style="group">
      <Button id="set_scroll_up" style="button" icon="ArrowUp" role="scrollUp" command="settings.scroll.up"/>
      <Button caption="0,1,1" role="scrollbar" scanGrace="400"/>
      <Button id="set_scroll_down" style="button" icon="ArrowDown" role="scrollDown" command="settings.scroll.down"/>
    </Card>
  </Grid>
</Page>
