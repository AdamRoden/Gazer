      <Cell id="pal_triadic2_0" row="0" col="11" style="joinRight" command="settings.theme.shade.triadic2.0"/>
    </SubGrid>

    <SubGrid id="row_hue" row="9" col="0" colSpan="16" rows="1" columns="16" gap="6" style="row">
      <Cell id="edit_h" row="0" col="0" colSpan="2" label="Hue" command="settings.color.scrub.h"/>
      <Cell id="dec_h" row="0" col="2" label="−" style="joinLeft" command="settings.color.nudge.h.dec"/>
      <Cell id="track_h" row="0" col="3" colSpan="12" label="Hue" role="slider" caption="h"/>
      <Cell id="inc_h" row="0" col="15" label="+" style="joinRight" command="settings.color.nudge.h.inc"/>
    </SubGrid>
    <SubGrid id="row_sat" row="10" col="0" colSpan="16" rows="1" columns="16" gap="6" style="row">
      <Cell id="edit_s" row="0" col="0" colSpan="2" label="Saturation" command="settings.color.scrub.s"/>
      <Cell id="dec_s" row="0" col="2" label="−" style="joinLeft" command="settings.color.nudge.s.dec"/>
      <Cell id="track_s" row="0" col="3" colSpan="12" label="Saturation" role="slider" caption="s"/>
      <Cell id="inc_s" row="0" col="15" label="+" style="joinRight" command="settings.color.nudge.s.inc"/>
    </SubGrid>
    <SubGrid id="row_light" row="11" col="0" colSpan="16" rows="1" columns="16" gap="6" style="row">
      <Cell id="edit_l" row="0" col="0" colSpan="2" label="Lightness" command="settings.color.scrub.l"/>
      <Cell id="dec_l" row="0" col="2" label="−" style="joinLeft" command="settings.color.nudge.l.dec"/>
      <Cell id="track_l" row="0" col="3" colSpan="12" label="Lightness" role="slider" caption="l"/>
      <Cell id="inc_l" row="0" col="15" label="+" style="joinRight" command="settings.color.nudge.l.inc"/>
    </SubGrid>
  </Grid>
</Page>
