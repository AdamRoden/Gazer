<Page id="main_settings_theme" name="Theme" radius="16">
  <Style id="group" thickness="0" radius="16"/>
  <Style id="row" background="#00000000" thickness="0" radius="0"/>
  <Style id="plain" background="#00000000" thickness="0" radius="0"/>
  <Style id="join" background="#00000000" thickness="0" radius="0"/>
  <Style id="joinLeft" background="#00000000" thickness="0" radius="10,0,0,10"/>
  <Style id="joinRight" background="#00000000" thickness="0" radius="0,10,10,0"/>
  <Style id="tabbar" thickness="0" radius="12"/>
  <Grid id="board" desktopMode="true" rows="12" columns="16" anchor="Top" offset="0,0" size="A_ScreenHeight/9*16, A_ScreenHeight" gap="8" margin="20" radius="16"
        rowWeights="1,1.1,1.35,0.9,0.72,0.72,0.72,0.72,0.72,1.25,1.25,1.25">
    <SubGrid id="tabs" row="0" col="0" colSpan="16" rows="1" columns="8" gap="6" margin="4" style="tabbar">
      <Cell id="tab_speed" row="0" col="0" label="Speed" icon="timer" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_speed"/>
      </Cell>
      <Cell id="tab_magnify" row="0" col="1" label="Magnify" icon="ZoomSettings" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_magnify"/>
      </Cell>
      <Cell id="tab_indicators" row="0" col="2" label="Indicators" icon="cycle" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_indicators"/>
      </Cell>
      <Cell id="tab_assist" row="0" col="3" label="Assist" icon="ideas" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_assist"/>
      </Cell>
      <Cell id="tab_tools" row="0" col="4" label="Tools" icon="lookToScroll" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_tools"/>
      </Cell>
      <Cell id="tab_theme" row="0" col="5" label="Theme" icon="palette" role="tab"/>
      <Cell id="tab_speech" row="0" col="6" label="Speech" icon="Speak" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_speech"/>
      </Cell>
      <Cell id="tab_done" row="0" col="7" label="Done" icon="keyboardHide">
        <CloseAllPages/>
      </Cell>
    </SubGrid>

    <SubGrid id="sec_appearance" row="1" col="0" colSpan="16" rows="1" columns="4" gap="0" style="row">
      <Cell id="light" row="0" col="0" label="Light" role="choice" activeState="theme.light" style="joinLeft" command="theme.light"/>
      <Cell id="light_tint" row="0" col="1" label="Light tint" role="choice" activeState="theme.lightTinted" style="join" command="theme.lightTinted"/>
      <Cell id="dark_tint" row="0" col="2" label="Dark tint" role="choice" activeState="theme.darkTinted" style="join" command="theme.darkTinted"/>
      <Cell id="dark" row="0" col="3" label="Dark" role="choice" activeState="theme.dark" style="joinRight" command="theme.dark"/>
    </SubGrid>

    <SubGrid id="sec_selected" row="2" col="0" colSpan="16" rows="1" columns="3" gap="8" style="row">
      <Cell id="hex" row="0" col="0" label="#" command="settings.color.editHex"/>
      <Cell id="p_swatch" row="0" col="1" label="P" caption="Primary" role="choice" activeState="settings.theme.assign.primary" command="settings.theme.assign.primary"/>
      <Cell id="s_swatch" row="0" col="2" label="S" caption="Secondary" role="choice" activeState="settings.theme.assign.secondary" command="settings.theme.assign.secondary"/>
    </SubGrid>

    <Cell id="sp_mid" row="3" col="0" colSpan="16" role="label" style="plain"/>

    <SubGrid id="row_pal_primary" row="4" col="0" colSpan="16" rows="1" columns="12" gap="0" style="row">
      <Cell id="h_pal_primary" row="0" col="0" colSpan="2" label="Primary" role="label" style="plain"/>
      <Cell id="pal_primary_9" row="0" col="2" style="joinLeft" command="settings.theme.shade.primary.9"/>
      <Cell id="pal_primary_8" row="0" col="3" style="join" command="settings.theme.shade.primary.8"/>
      <Cell id="pal_primary_7" row="0" col="4" style="join" command="settings.theme.shade.primary.7"/>
      <Cell id="pal_primary_6" row="0" col="5" style="join" command="settings.theme.shade.primary.6"/>
      <Cell id="pal_primary_5" row="0" col="6" style="join" command="settings.theme.shade.primary.5"/>
      <Cell id="pal_primary_4" row="0" col="7" style="join" command="settings.theme.shade.primary.4"/>
      <Cell id="pal_primary_3" row="0" col="8" style="join" command="settings.theme.shade.primary.3"/>
      <Cell id="pal_primary_2" row="0" col="9" style="join" command="settings.theme.shade.primary.2"/>
      <Cell id="pal_primary_1" row="0" col="10" style="join" command="settings.theme.shade.primary.1"/>
      <Cell id="pal_primary_0" row="0" col="11" style="joinRight" command="settings.theme.shade.primary.0"/>
    </SubGrid>
    <SubGrid id="row_pal_complementary" row="5" col="0" colSpan="16" rows="1" columns="12" gap="0" style="row">
      <Cell id="h_pal_complementary" row="0" col="0" colSpan="2" label="Complementary" role="label" style="plain"/>
      <Cell id="pal_complementary_9" row="0" col="2" style="joinLeft" command="settings.theme.shade.complementary.9"/>
      <Cell id="pal_complementary_8" row="0" col="3" style="join" command="settings.theme.shade.complementary.8"/>
      <Cell id="pal_complementary_7" row="0" col="4" style="join" command="settings.theme.shade.complementary.7"/>
      <Cell id="pal_complementary_6" row="0" col="5" style="join" command="settings.theme.shade.complementary.6"/>
      <Cell id="pal_complementary_5" row="0" col="6" style="join" command="settings.theme.shade.complementary.5"/>
      <Cell id="pal_complementary_4" row="0" col="7" style="join" command="settings.theme.shade.complementary.4"/>
      <Cell id="pal_complementary_3" row="0" col="8" style="join" command="settings.theme.shade.complementary.3"/>
      <Cell id="pal_complementary_2" row="0" col="9" style="join" command="settings.theme.shade.complementary.2"/>
      <Cell id="pal_complementary_1" row="0" col="10" style="join" command="settings.theme.shade.complementary.1"/>
      <Cell id="pal_complementary_0" row="0" col="11" style="joinRight" command="settings.theme.shade.complementary.0"/>
    </SubGrid>
    <SubGrid id="row_pal_analogous1" row="6" col="0" colSpan="16" rows="1" columns="12" gap="0" style="row">
      <Cell id="h_pal_analogous1" row="0" col="0" colSpan="2" label="Analogous" role="label" style="plain"/>
      <Cell id="pal_analogous1_9" row="0" col="2" style="joinLeft" command="settings.theme.shade.analogous1.9"/>
      <Cell id="pal_analogous1_8" row="0" col="3" style="join" command="settings.theme.shade.analogous1.8"/>
      <Cell id="pal_analogous1_7" row="0" col="4" style="join" command="settings.theme.shade.analogous1.7"/>
      <Cell id="pal_analogous1_6" row="0" col="5" style="join" command="settings.theme.shade.analogous1.6"/>
      <Cell id="pal_analogous1_5" row="0" col="6" style="join" command="settings.theme.shade.analogous1.5"/>
      <Cell id="pal_analogous1_4" row="0" col="7" style="join" command="settings.theme.shade.analogous1.4"/>
      <Cell id="pal_analogous1_3" row="0" col="8" style="join" command="settings.theme.shade.analogous1.3"/>
      <Cell id="pal_analogous1_2" row="0" col="9" style="join" command="settings.theme.shade.analogous1.2"/>
      <Cell id="pal_analogous1_1" row="0" col="10" style="join" command="settings.theme.shade.analogous1.1"/>
      <Cell id="pal_analogous1_0" row="0" col="11" style="joinRight" command="settings.theme.shade.analogous1.0"/>
    </SubGrid>
    <SubGrid id="row_pal_triadic1" row="7" col="0" colSpan="16" rows="1" columns="12" gap="0" style="row">
      <Cell id="h_pal_triadic1" row="0" col="0" colSpan="2" label="Triadic" role="label" style="plain"/>
      <Cell id="pal_triadic1_9" row="0" col="2" style="joinLeft" command="settings.theme.shade.triadic1.9"/>
      <Cell id="pal_triadic1_8" row="0" col="3" style="join" command="settings.theme.shade.triadic1.8"/>
      <Cell id="pal_triadic1_7" row="0" col="4" style="join" command="settings.theme.shade.triadic1.7"/>
      <Cell id="pal_triadic1_6" row="0" col="5" style="join" command="settings.theme.shade.triadic1.6"/>
      <Cell id="pal_triadic1_5" row="0" col="6" style="join" command="settings.theme.shade.triadic1.5"/>
      <Cell id="pal_triadic1_4" row="0" col="7" style="join" command="settings.theme.shade.triadic1.4"/>
      <Cell id="pal_triadic1_3" row="0" col="8" style="join" command="settings.theme.shade.triadic1.3"/>
      <Cell id="pal_triadic1_2" row="0" col="9" style="join" command="settings.theme.shade.triadic1.2"/>
      <Cell id="pal_triadic1_1" row="0" col="10" style="join" command="settings.theme.shade.triadic1.1"/>
      <Cell id="pal_triadic1_0" row="0" col="11" style="joinRight" command="settings.theme.shade.triadic1.0"/>
    </SubGrid>
    <SubGrid id="row_pal_triadic2" row="8" col="0" colSpan="16" rows="1" columns="12" gap="0" style="row">
      <Cell id="h_pal_triadic2" row="0" col="0" colSpan="2" label="" role="label" style="plain"/>
      <Cell id="pal_triadic2_9" row="0" col="2" style="joinLeft" command="settings.theme.shade.triadic2.9"/>
      <Cell id="pal_triadic2_8" row="0" col="3" style="join" command="settings.theme.shade.triadic2.8"/>
