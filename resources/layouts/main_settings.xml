<Page id="main_settings" name="Settings" radius="16" background="bg95">
  <Style id="plain" background="transparent" thickness="0" radius="0"/>
  <Grid id="board" desktopMode="true" rows="3" columns="4" anchor="Top" offset="0,0" background="bg100"
        size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth), A_ScreenHeight" gap="72" margin="90" radius="16"
        rowHeights="*,2*,2*">
    <Cell id="page_title" row="0" col="0" colSpan="4" label="Settings" role="label" textStyle="title" style="plain"/>
    <Cell id="open_dwell" row="1" col="0" label="Dwell" caption="Presets, grace, and progress"
          icon="timer" hostPage="main_settings_host, main_settings_dwell"/>
    <Cell id="open_zoom" row="1" col="1" label="Zoom" caption="Zoom window, foresight, and markers"
          icon="ZoomSettings" hostPage="main_settings_host, main_settings_zoom"/>
    <Cell id="open_place" row="1" col="2" label="Place" caption="Click placement and ComboMouse"
          icon="mouseMove" hostPage="main_settings_host, main_settings_place"/>
    <Cell id="open_gaze" row="1" col="3" label="Gaze" caption="Follow, lens, and look-to maps"
          icon="eye" hostPage="main_settings_host, main_settings_gaze"/>
    <Cell id="open_head" row="2" col="0" label="Head" caption="Head pose maps"
          icon="HeadPreview" hostPage="main_settings_host, main_settings_head_pose"/>
    <Cell id="open_speak" row="2" col="1" label="Speak" caption="Composer voice and predictions"
          icon="Speak" hostPage="main_settings_host, main_settings_speak"/>
    <Cell id="open_theme" row="2" col="2" label="Theme" caption="Appearance and Material palettes"
          icon="palette" hostPage="main_settings_host, main_settings_theme"/>
    <Cell id="open_setup" row="2" col="3" label="Setup" caption="Tracker, pad, capture, and session"
          icon="settings" hostPage="main_settings_host, main_settings_setup"/>
  </Grid>
</Page>
