<Page id="main_settings" name="Settings" radius="16">
  <Style id="group" thickness="0" radius="16"/>
  <Style id="plain" background="#00000000" thickness="0" radius="0"/>
  <Grid id="board" desktopMode="true" rows="4" columns="3" anchor="Top" offset="0,0"
        size="A_ScreenHeight/9*16, A_ScreenHeight" gap="72" margin="90" radius="16"
        rowWeights="1,2,2,2">
    <Cell id="page_title" row="0" col="0" colSpan="3" label="Settings" role="label" textStyle="title" style="plain"/>
    <Cell id="open_speed" row="1" col="0" label="Speed" caption="Presets, dwell, and pointer time"
          icon="timer" openPage="main_settings_speed"/>
    <Cell id="open_magnify" row="1" col="1" label="Magnify" caption="Magnify pick, foresight, and zoom window"
          icon="ZoomSettings" openPage="main_settings_magnify"/>
    <Cell id="open_indicators" row="1" col="2" label="Indicators" caption="Progress and pick markers"
          icon="cycle" openPage="main_settings_indicators"/>
    <Cell id="open_assist" row="2" col="0" label="Assist" caption="Tracker, lens, and helpers"
          icon="ideas" openPage="main_settings_assist"/>
    <Cell id="open_tools" row="2" col="1" label="Tools" caption="Look to scroll and ComboMouse"
          icon="lookToScroll" openPage="main_settings_tools"/>
    <Cell id="open_theme" row="2" col="2" label="Theme" caption="Appearance, accent, and progress"
          icon="palette" openPage="main_settings_theme"/>
    <Cell id="open_speech" row="3" col="0" label="Speech" caption="ElevenLabs key, voice engine, and speed"
          icon="Speak" openPage="main_settings_speech"/>
    <Cell id="done" row="3" col="1" colSpan="1" label="Done" icon="keyboardHide" closePage="true"/>
  </Grid>
</Page>
