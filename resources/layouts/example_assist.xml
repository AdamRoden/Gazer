<?xml version="1.0" encoding="UTF-8"?>
<Page id="example_assist" name="Assist" autoClose="true">
  <Row id="board" columns="10" anchor="Bottom" offset="0,0" size="1200,150" gap="10" autoClose="true">
    <Button label="Gaze Magnifier" icon="MagnifyTool" bind="magnifier" command="toggleMagnifier"/>
    <Button label="Show gaze" icon="Eye" bind="gazeReticle" command="toggleGazeReticle"/>
    <Button label="Gaze mouse" icon="MouseMagneticCursor" bind="gazeMouseFollow" command="toggleGazeMouseFollow"/>
    <Button label="Move mouse (dwell)" icon="mouseMove" bind="mouseMoveToGaze" command="mouseMoveToGaze"/>
    <Button label="Gaze click loop" icon="LoopingAction" bind="mouseMoveToGazeClickLoop" command="mouseMoveToGazeClickLoop"/>
    <Button label="Magnify pick" icon="ZoomConfirm" bind="mouseMoveMagPick" command="toggleMouseMoveMagPick"/>
    <Button label="LookToScroll" icon="lookToScroll" bind="lookToScroll" id="lts" command="toggleLookToScroll"/>
    <Button label="ComboMouse" icon="comboMouse" bind="comboMouse" command="toggleComboMouse"/>
    <Button label="Edit page" icon="editSquare" command="openPageEditor"/>
    <Button id="main" label="Main" icon="menu">
      <ClosePage/>
      <ShowLayers value="1,2"/>
    </Button>
  </Row>
</Page>
