<Page id="main_settings_pointer_timing" name="Pointer timing">
  <Grid id="board" desktopMode="true" rows="12" columns="16" anchor="Top" offset="0,0" size="1600,1.0" gap="6" margin="12" aboveTaskbar="false" thickness="1" radius="4">
    <SubGrid id="tabs" row="0" col="0" colSpan="16" rows="1" columns="6" gap="6">
      <Cell id="tab_buttons" row="0" col="0" label="Button" role="tab">
        <Action id="Page" value="Close, Page, self"/>
        <Action id="Page" value="Open, Page, main_settings_button_timing"/>
      </Cell>
      <Cell id="tab_pointers" row="0" col="1" label="Pointer" role="tab" interactive="false"/>
      <Cell id="tab_styles" row="0" col="2" label="Styles" role="tab">
        <Action id="Page" value="Close, Page, self"/>
        <Action id="Page" value="Open, Page, main_settings_styles"/>
      </Cell>
      <Cell id="tab_assist" row="0" col="3" label="Assist" role="tab">
        <Action id="Page" value="Close, Page, self"/>
        <Action id="Page" value="Open, Page, main_settings_assist"/>
      </Cell>
      <Cell id="tab_lts" row="0" col="4" label="LTS" role="tab">
        <Action id="Page" value="Close, Page, self"/>
        <Action id="Page" value="Open, Page, main_settings_lts"/>
      </Cell>
      <Cell id="tab_theme" row="0" col="5" label="Theme" role="tab">
        <Action id="Page" value="Close, Page, self"/>
        <Action id="Page" value="Open, Page, main_settings_theme"/>
      </Cell>
    </SubGrid>

    <Cell id="page_title" row="1" col="0" colSpan="16" label="Pointer timing" caption="Pointer aim timeout, dwell, foresight, and zoom dwell" role="label" textStyle="title"/>
    <Cell id="h_aim" row="2" col="0" colSpan="16" label="Aim" role="label" textStyle="section"/>
    <Cell id="pg_label" row="3" col="0" colSpan="6" label="Pointer grace" caption="Cancel pointer aim if no target is selected within this many ms (0 = off)." role="label"/>
    <Cell id="pg_dec" row="3" col="8" label="−" cluster="stepper.pg" clusterSlot="dec">
    <Action id="Command" value="settings.nudge.mouseMoveSelectTimeoutMs.dec"/>
    </Cell>
    <Cell id="pg_val" row="3" col="9" colSpan="2" label="—" role="label" settingKey="mouseMoveSelectTimeoutMs" cluster="stepper.pg" clusterSlot="value"/>
    <Cell id="pg_inc" row="3" col="11" label="+" cluster="stepper.pg" clusterSlot="inc">
    <Action id="Command" value="settings.nudge.mouseMoveSelectTimeoutMs.inc"/>
    </Cell>
    <Cell id="pg_edit" row="3" col="12" label="Edit…" cluster="stepper.pg" clusterSlot="edit">
    <Action id="Command" value="settings.edit.mouseMoveSelectTimeoutMs"/>
    </Cell>
    <Cell id="pd_label" row="4" col="0" colSpan="6" label="Pointer dwell" caption="Dwell time for the final cursor / click placement (ms)." role="label"/>
    <Cell id="pd_dec" row="4" col="8" label="−" cluster="stepper.pd" clusterSlot="dec">
    <Action id="Command" value="settings.nudge.mouseMoveDwellMs.dec"/>
    </Cell>
    <Cell id="pd_val" row="4" col="9" colSpan="2" label="—" role="label" settingKey="mouseMoveDwellMs" cluster="stepper.pd" clusterSlot="value"/>
    <Cell id="pd_inc" row="4" col="11" label="+" cluster="stepper.pd" clusterSlot="inc">
    <Action id="Command" value="settings.nudge.mouseMoveDwellMs.inc"/>
    </Cell>
    <Cell id="pd_edit" row="4" col="12" label="Edit…" cluster="stepper.pd" clusterSlot="edit">
    <Action id="Command" value="settings.edit.mouseMoveDwellMs"/>
    </Cell>
    <Cell id="h_fs" row="5" col="0" colSpan="16" label="Foresight" role="label" textStyle="section"/>
    <Cell id="fsd_label" row="6" col="0" colSpan="6" label="Foresight dwell" caption="How long to gaze at a desktop point before Foresight stores it (ms). Kept for 2 seconds." role="label"/>
    <Cell id="fsd_dec" row="6" col="8" label="−" cluster="stepper.fsd" clusterSlot="dec">
    <Action id="Command" value="settings.nudge.mouseMoveForesightDwellMs.dec"/>
    </Cell>
    <Cell id="fsd_val" row="6" col="9" colSpan="2" label="—" role="label" settingKey="mouseMoveForesightDwellMs" cluster="stepper.fsd" clusterSlot="value"/>
    <Cell id="fsd_inc" row="6" col="11" label="+" cluster="stepper.fsd" clusterSlot="inc">
    <Action id="Command" value="settings.nudge.mouseMoveForesightDwellMs.inc"/>
    </Cell>
    <Cell id="fsd_edit" row="6" col="12" label="Edit…" cluster="stepper.fsd" clusterSlot="edit">
    <Action id="Command" value="settings.edit.mouseMoveForesightDwellMs"/>
    </Cell>
    <Cell id="fs_on" row="7" col="0" colSpan="8" icon="AutoModeIcon" label="Foresight" role="toggle" activeState="mouseMoveForesight">
    <Action id="Command" value="toggleMouseMoveForesight"/>
    </Cell>
    <Cell id="fs_dbl" row="7" col="8" colSpan="8" icon="ZoomToLocation" label="Bonus zoom" role="toggle" activeState="mouseMoveForesightDoubleZoom">
    <Action id="Command" value="toggleMouseMoveForesightDoubleZoom"/>
    </Cell>
    <Cell id="h_zoom" row="8" col="0" colSpan="16" label="Zoom" role="label" textStyle="section"/>
    <Cell id="zd_label" row="9" col="0" colSpan="6" label="Zoom dwell" caption="Dwell time to choose the region to magnify (ms)." role="label"/>
    <Cell id="zd_dec" row="9" col="8" label="−" cluster="stepper.zd" clusterSlot="dec">
    <Action id="Command" value="settings.nudge.magPickDwellMs.dec"/>
    </Cell>
    <Cell id="zd_val" row="9" col="9" colSpan="2" label="—" role="label" settingKey="magPickDwellMs" cluster="stepper.zd" clusterSlot="value"/>
    <Cell id="zd_inc" row="9" col="11" label="+" cluster="stepper.zd" clusterSlot="inc">
    <Action id="Command" value="settings.nudge.magPickDwellMs.inc"/>
    </Cell>
    <Cell id="zd_edit" row="9" col="12" label="Edit…" cluster="stepper.zd" clusterSlot="edit">
    <Action id="Command" value="settings.edit.magPickDwellMs"/>
    </Cell>
    <Cell id="z_on" row="10" col="0" colSpan="8" icon="ZoomToLocation" label="Zoom" role="toggle" activeState="mouseMoveMagPick">
    <Action id="Command" value="toggleMouseMoveMagPick"/>
    </Cell>
    <Cell id="z_center" row="10" col="8" colSpan="8" icon="LookToScrollBoundsScreenCentredIcon" label="Screen-centered" role="toggle" activeState="!mouseMoveMagPickCenter">
    <Action id="Command" value="toggleMouseMoveMagPickCenter"/>
    </Cell>
  </Grid>
</Page>
