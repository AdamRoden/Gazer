<Page id="main_settings_admin" name="Admin" radius="16">
  <Style id="group" background="bg95" thickness="0" radius="16"/>
  <Style id="row" background="transparent" thickness="0" radius="0"/>
  <Style id="plain" background="transparent" thickness="0" radius="0"/>
  <Style id="join" background="transparent" thickness="0" radius="0"/>
  <Style id="joinLeft" background="transparent" thickness="0" radius="10,0,0,10"/>
  <Style id="joinRight" background="transparent" thickness="0" radius="0,10,10,0"/>
  <Grid id="board" desktopMode="true" rows="11" columns="16" anchor="Top" offset="0,0" size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth), A_ScreenHeight" gap="6" margin="12" radius="16">
    <Cell id="page_title" row="0" col="0" colSpan="16" label="Admin" caption="Tracker, ViGEm, speech, and capture" role="label" textStyle="title" style="plain"/>

    <SubGrid id="sec_tr" row="1" col="0" colSpan="16" rowSpan="2" rows="2" columns="1" rowHeights="*,2*" gap="6" margin="6" style="group">
      <Cell id="h_tr" row="0" col="0" label="Tracker" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_tr" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="tr_l" row="0" col="0" label="Tracker" caption="Applies on next start." role="label" style="plain"/>
        <SubGrid id="act_tr" row="0" col="1" rows="1" columns="3" gap="0" style="row">
          <Cell id="tr_a" row="0" col="0" label="Auto Tobii" role="choice" activeState="settings.tracker.auto" style="joinLeft" command="settings.tracker.auto"/>
          <Cell id="tr_m" row="0" col="1" label="Mouse" role="choice" activeState="settings.tracker.mouse" style="join" command="settings.tracker.mouse"/>
          <Cell id="preview" row="0" col="2" label="Head preview" icon="HeadPreview" style="joinRight" command="openPreview"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_vigem" row="3" col="0" colSpan="16" rowSpan="2" rows="2" columns="1" rowHeights="*,2*" gap="6" margin="6" style="group">
      <Cell id="h_vigem" row="0" col="0" label="Virtual Xbox pad" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_vigem" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="vigem_status" row="0" col="0" label="ViGEm" caption="Not installed. Dwell Install to download the official setup." role="label" style="plain"/>
        <SubGrid id="act_vigem" row="0" col="1" rows="1" columns="2" gap="0" style="row">
          <Cell id="vigem_refresh" row="0" col="0" label="Recheck" icon="restart" style="joinLeft" command="settings.vigem.refresh"/>
          <Cell id="vigem_install" row="0" col="1" label="Download / UAC" icon="sportsEsports" style="joinRight" command="settings.vigem.install"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_speech" row="5" col="0" colSpan="16" rowSpan="4" rows="4" columns="1" rowHeights="*,2*,2*,2*" gap="6" margin="6" style="group">
      <Cell id="h_speech" row="0" col="0" label="Speech" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_key" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="key_status" row="0" col="0" label="No API key" role="value" style="plain"/>
        <Cell id="key_edit" row="0" col="1" label="Paste key" icon="contentPaste" command="settings.speech.editKey"/>
      </SubGrid>
      <SubGrid id="row_eng" row="2" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="eng_l" row="0" col="0" label="Composer voice" caption="Eleven when a key and voice id are set, otherwise SAPI. XML Speak stays SAPI."
              role="label" style="plain"/>
        <SubGrid id="act_eng" row="0" col="1" rows="1" columns="3" gap="0" style="row">
          <Cell id="m_sapi" row="0" col="0" label="SAPI" role="choice" activeState="settings.speech.model.sapi"
                style="joinLeft" command="settings.speech.model.sapi"/>
          <Cell id="m_flash" row="0" col="1" label="Eleven Flash" role="choice" activeState="settings.speech.model.eleven_flash_v2_5"
                style="join" command="settings.speech.model.eleven_flash_v2_5"/>
          <Cell id="m_v3" row="0" col="2" label="Eleven v3" role="choice" activeState="settings.speech.model.eleven_v3"
                style="joinRight" command="settings.speech.model.eleven_v3"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_spd" row="3" col="0" rows="1" columns="2" gap="6" style="row">
        <SubGrid id="act_spd" row="0" col="0" rows="1" columns="4" gap="0" style="row">
          <Cell id="spd_l" row="0" col="0" label="Speed" caption="0.5–2.0 for Eleven and SAPI."
                role="label" style="plain"/>
          <Cell id="spd_dec" row="0" col="1" label="−" style="joinLeft" command="settings.nudge.speechSpeed.dec"/>
          <Cell id="speed_value" row="0" col="2" label="1.0" role="value" settingKey="speechSpeed" style="join"/>
          <Cell id="spd_inc" row="0" col="3" label="+" style="joinRight" command="settings.nudge.speechSpeed.inc"/>
        </SubGrid>
        <SubGrid id="act_vol" row="0" col="1" rows="1" columns="4" gap="0" style="row">
          <Cell id="vol_l" row="0" col="0" label="Boost" caption="1–5× louder for ElevenLabs clips."
                role="label" style="plain"/>
          <Cell id="vol_dec" row="0" col="1" label="−" style="joinLeft" command="settings.nudge.speechVolume.dec"/>
          <Cell id="volume_value" row="0" col="2" label="1.0×" role="value" settingKey="speechVolume" style="join"/>
          <Cell id="vol_inc" row="0" col="3" label="+" style="joinRight" command="settings.nudge.speechVolume.inc"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_capture" row="9" col="0" colSpan="16" rowSpan="2" rows="2" columns="1" rowHeights="*,2*" gap="6" margin="6" style="group">
      <Cell id="h_capture" row="0" col="0" label="Screen capture" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_capture" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="cap_label" row="0" col="0" label="Screenshots" caption="All includes overlays (for documentation). Pages keeps boards and hides look-to, the reticle, and the lens. None hides boards and those overlays." role="label" style="plain"/>
        <SubGrid id="act_capture" row="0" col="1" rows="1" columns="3" gap="0" style="row">
          <Cell id="cap_all" row="0" col="0" label="All" role="choice" activeState="settings.capture.all" style="joinLeft" command="settings.capture.all"/>
          <Cell id="cap_pages" row="0" col="1" label="Pages" role="choice" activeState="settings.capture.pages" style="join" command="settings.capture.pages"/>
          <Cell id="cap_none" row="0" col="2" label="None" role="choice" activeState="settings.capture.none" style="joinRight" command="settings.capture.none"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>
  </Grid>
</Page>
