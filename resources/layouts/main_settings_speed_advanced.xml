<Page id="main_settings_speed_advanced" name="Advanced speed" radius="16">
  <Style id="group" background="bg95" thickness="0" radius="16"/>
  <Style id="row" background="transparent" thickness="0" radius="0"/>
  <Style id="plain" background="transparent" thickness="0" radius="0"/>
  <Style id="join" background="transparent" thickness="0" radius="0"/>
  <Style id="joinLeft" background="transparent" thickness="0" radius="10,0,0,10"/>
  <Style id="joinRight" background="transparent" thickness="0" radius="0,10,10,0"/>
  <Grid id="board" desktopMode="true" rows="4" columns="16" anchor="Top" offset="0,0" size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth), A_ScreenHeight" gap="6" margin="12" radius="16"
  rowHeights="0.6*,1.8*,1.4*,1.8*">
    <Cell id="page_title" row="0" col="0" colSpan="16" label="Advanced speed" caption="Scan grace, blink, pointer grace, foresight hold, and auto-close" role="label" textStyle="title" style="plain"/>

    <SubGrid id="sec_grace" row="1" col="0" colSpan="16" rows="4" columns="1" rowHeights="*,2*,2*,2*" gap="6" margin="6" style="group">
      <Cell id="h_grace" row="0" col="0" label="Grace" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_grace" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="grace_label" row="0" col="0" label="Blink grace" caption="Blink without canceling dwell." role="label" style="plain"/>
        <SubGrid id="act_grace" row="0" col="1" rows="1" columns="9" gap="0" style="row">
          <Cell id="grace_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.dwellGraceMs.dec"/>
          <Cell id="grace_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="dwellGraceMs" style="join"/>
          <Cell id="grace_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.dwellGraceMs.inc"/>
          <Cell id="grace_edit" row="0" col="7" colSpan="2" icon="editSquare" label="Edit…" style="joinRight" command="settings.edit.dwellGraceMs"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_scan" row="2" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="scan_label" row="0" col="0" label="Scan grace" caption="Time on-target before dwell starts." role="label" style="plain"/>
        <SubGrid id="act_scan" row="0" col="1" rows="1" columns="9" gap="0" style="row">
          <Cell id="scan_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.scanGraceMs.dec"/>
          <Cell id="scan_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="scanGraceMs" style="join"/>
          <Cell id="scan_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.scanGraceMs.inc"/>
          <Cell id="scan_edit" row="0" col="7" colSpan="2" icon="editSquare" label="Edit…" style="joinRight" command="settings.edit.scanGraceMs"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_pg" row="3" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="pg_label" row="0" col="0" label="Pointer grace" caption="Time before an unresolved pointer pick action is canceled. 0 = off." role="label" style="plain"/>
        <SubGrid id="act_pg" row="0" col="1" rows="1" columns="9" gap="0" style="row">
          <Cell id="pg_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.mouseMoveSelectTimeoutMs.dec"/>
          <Cell id="pg_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="mouseMoveSelectTimeoutMs" style="join"/>
          <Cell id="pg_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.mouseMoveSelectTimeoutMs.inc"/>
          <Cell id="pg_edit" row="0" col="7" colSpan="2" icon="editSquare" label="Edit…" style="joinRight" command="settings.edit.mouseMoveSelectTimeoutMs"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_fs" row="2" col="0" colSpan="16" rows="3" columns="1" rowHeights="*,2*,2*" gap="6" margin="6" style="group">
      <Cell id="h_fs" row="0" col="0" label="Foresight" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_fsd" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="fsd_label" row="0" col="0" label="Foresight dwell" caption="Gaze this long to store a point." role="label" style="plain"/>
        <SubGrid id="act_fsd" row="0" col="1" rows="1" columns="9" gap="0" style="row">
          <Cell id="fsd_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.mouseMoveForesightDwellMs.dec"/>
          <Cell id="fsd_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="mouseMoveForesightDwellMs" style="join"/>
          <Cell id="fsd_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.mouseMoveForesightDwellMs.inc"/>
          <Cell id="fsd_edit" row="0" col="7" colSpan="2" icon="editSquare" label="Edit…" style="joinRight" command="settings.edit.mouseMoveForesightDwellMs"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_fsh" row="2" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="fsh_label" row="0" col="0" label="Foresight hold" caption="How long a stored point lasts." role="label" style="plain"/>
        <SubGrid id="act_fsh" row="0" col="1" rows="1" columns="9" gap="0" style="row">
          <Cell id="fsh_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.mouseMoveForesightHoldMs.dec"/>
          <Cell id="fsh_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="mouseMoveForesightHoldMs" style="join"/>
          <Cell id="fsh_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.mouseMoveForesightHoldMs.inc"/>
          <Cell id="fsh_edit" row="0" col="7" colSpan="2" icon="editSquare" label="Edit…" style="joinRight" command="settings.edit.mouseMoveForesightHoldMs"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_session" row="3" col="0" colSpan="16" rows="3" columns="1" rowHeights="*,2*,2*" gap="6" margin="6" style="group">
      <Cell id="h_session" row="0" col="0" label="Session" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_ac" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="ac_label" row="0" col="0" label="Auto-close boards" caption="Close idle boards that opted in." role="label" style="plain"/>
        <Cell id="ac_on" row="0" col="1" label="Auto-close" role="toggle" activeState="settings.session.layoutAutoClose.toggle" style="join" command="settings.session.layoutAutoClose.toggle"/>
      </SubGrid>
      <SubGrid id="row_aci" row="2" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="aci_label" row="0" col="0" label="Auto-close idle" caption="Idle time before those boards close." role="label" style="plain"/>
        <SubGrid id="act_aci" row="0" col="1" rows="1" columns="9" gap="0" style="row">
          <Cell id="aci_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.layoutAutoCloseIdleMs.dec"/>
          <Cell id="aci_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="layoutAutoCloseIdleMs" style="join"/>
          <Cell id="aci_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.layoutAutoCloseIdleMs.inc"/>
          <Cell id="aci_edit" row="0" col="7" colSpan="2" icon="editSquare" label="Edit…" style="joinRight" command="settings.edit.layoutAutoCloseIdleMs"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>
  </Grid>
</Page>
