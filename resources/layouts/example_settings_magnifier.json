{
  "schemaVersion": 1,
  "id": "example_settings_magnifier",
  "name": "Magnifier",
  "description": "Label · − · value · + · Edit",
  "uiStyle": "fluent",
  "window": { "anchor": "center", "widthPx": 1100, "heightPx": 560, "marginPx": 16 },
  "grid": { "columns": 5, "rows": 4, "gapPx": 10, "marginPx": 56 },
  "dwell": { "enabled": true, "ms": [650], "progressStyle": "radial" },
  "items": [
    { "id": "z_l", "role": "label", "label": "Zoom", "caption": "Magnification factor under gaze.", "row": 0, "col": 0 },
    { "id": "z_d", "label": "−", "row": 0, "col": 1, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.magZoom.dec" } },
    { "id": "z_v", "role": "value", "settingKey": "magZoom", "label": "—", "row": 0, "col": 2 },
    { "id": "z_i", "label": "+", "row": 0, "col": 3, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.magZoom.inc" } },
    { "id": "z_e", "label": "Edit…", "row": 0, "col": 4, "style": { "background": "#0a7ea4", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.edit.magZoom" } },

    { "id": "l_l", "role": "label", "label": "Lens size", "caption": "Lens diameter in pixels.", "row": 1, "col": 0 },
    { "id": "l_d", "label": "−", "row": 1, "col": 1, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.magLensSize.dec" } },
    { "id": "l_v", "role": "value", "settingKey": "magLensSize", "label": "—", "row": 1, "col": 2 },
    { "id": "l_i", "label": "+", "row": 1, "col": 3, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.magLensSize.inc" } },
    { "id": "l_e", "label": "Edit…", "row": 1, "col": 4, "style": { "background": "#0a7ea4", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.edit.magLensSize" } },

    { "id": "f_l", "role": "label", "label": "Follow", "caption": "Sticky / Balanced / Snappy tracking.", "row": 2, "col": 0 },
    { "id": "f_s", "label": "Sticky", "activeState": "setting.magFollow.0", "row": 2, "col": 1, "style": { "background": "#3d3a5c", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.mag.follow.sticky" } },
    { "id": "f_v", "role": "value", "settingKey": "magFollowProfile", "label": "—", "row": 2, "col": 2 },
    { "id": "f_b", "label": "Balanced", "activeState": "setting.magFollow.1", "row": 2, "col": 3, "style": { "background": "#4a4768", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.mag.follow.balanced" } },
    { "id": "f_n", "label": "Snappy", "activeState": "setting.magFollow.2", "row": 2, "col": 4, "style": { "background": "#5a5678", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.mag.follow.snappy" } },

    { "id": "back", "label": "← Settings", "row": 3, "col": 0, "colSpan": 2, "style": { "background": "#0a7ea4", "foreground": "#fff" }, "action": { "type": "loadLayout", "layoutId": "example_settings" } },
    { "id": "tog", "label": "Toggle lens", "activeState": "magnifier", "row": 3, "col": 2, "colSpan": 2, "style": { "background": "#6b5b95", "foreground": "#fff" }, "action": { "type": "command", "name": "toggleMagnifier" } },
    { "id": "close", "label": "Close", "row": 3, "col": 4, "style": { "background": "#4a5568", "foreground": "#fff" }, "action": { "type": "closeLayout" } }
  ]
}
