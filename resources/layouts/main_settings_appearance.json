{
  "schemaVersion": 1,
  "id": "main_settings_appearance",
  "name": "Progress & flash",
  "description": "Radial / fill / border highlights, colors, and completion flash",
  "uiStyle": "fluent",
  "window": { "anchor": "TopCenter", "widthPx": 1260, "height": 100, "marginPx": 0 },
  "grid": { "columns": 5, "rows": 10, "gapPx": 10, "marginPx": 100 },
  "items": [
    { "id": "timing", "label": "Timing", "row": 0, "col": 0, "action": { "type": "loadLayout", "layoutId": "main_settings_timing" } },
    { "id": "magnifier", "label": "Magnifier", "row": 0, "col": 1, "action": { "type": "loadLayout", "layoutId": "main_settings_magnifier" } },
    { "id": "lts", "label": "Look↕Scroll", "row": 0, "col": 2, "action": { "type": "loadLayout", "layoutId": "main_settings_lts" } },
    {"id": "appearance","label": "Appearance","row": 0,"col": 3,"action": { "type": "loadLayout", "layoutId": "main_settings_appearance" }},
    {"id": "assist","label": "Assist tools","row": 0,"col": 4,"action": { "type": "loadLayout", "layoutId": "main_settings_assist" }},
  
    { "id": "t_name", "role": "label", "label": "Theme", "caption": "Dark / Light / Custom", "row": 2, "col": 0 },
    { "id": "light", "label": "Light", "activeState": "setting.theme.light", "row": 2, "col": 2, "action": { "type": "command", "name": "theme.light" } },
    { "id": "dark", "label": "Dark", "activeState": "setting.theme.dark", "row": 2, "col": 3, "action": { "type": "command", "name": "theme.dark" } },
    { "id": "custom", "label": "Custom", "activeState": "setting.theme.custom", "row": 2, "col": 4, "action": { "type": "command", "name": "theme.custom" } },
    
    { "id": "pc_name", "role": "label", "label": "Progress color", "caption": "Color of the progress effects.", "row": 3, "col": 0 },
    { "id": "pc_col", "label": "Ring", "row": 3, "col": 2, "action": { "type": "command", "name": "settings.edit.color.progressColor" } },
    { "id": "f_col", "label": "Fill", "row": 3, "col": 3, "action": { "type": "command", "name": "settings.edit.color.progressFillColor" } },
    { "id": "b_col", "label": "Border", "row": 3, "col": 4, "action": { "type": "command", "name": "settings.edit.color.progressBorderColor" } },

    { "id": "r_name", "role": "label", "label": "Activator Progress", "caption": "Progress styles for the activators.", "row": 4, "col": 0 },
    { "id": "r_tog", "label": "Ring", "activeState": "setting.progressRadial", "row": 4, "col": 2, "action": { "type": "command", "name": "settings.progress.radial.toggle" } },
    { "id": "f_tog", "label": "Fill", "activeState": "setting.progressFill", "row": 4, "col": 3, "action": { "type": "command", "name": "settings.progress.fill.toggle" } },
    { "id": "b_tog", "label": "Border", "activeState": "setting.progressBorder", "row": 4, "col": 4, "action": { "type": "command", "name": "settings.progress.border.toggle" } },
    
    { "id": "mr_name", "role": "label", "label": "Mouse Progress", "caption": "Progress styles for the mouse-move.", "row": 5, "col": 0 },
    { "id": "mr_r", "label": "Ring", "activeState": "setting.mouseProgressRadial", "row": 5, "col": 2, "action": { "type": "command", "name": "settings.mouseProgress.radial.toggle" } },
    { "id": "mr_f", "label": "Fill", "activeState": "setting.mouseProgressFill", "row": 5, "col": 3, "action": { "type": "command", "name": "settings.mouseProgress.fill.toggle" } },
    { "id": "mr_b", "label": "Border", "activeState": "setting.mouseProgressBorder", "row": 5, "col": 4, "action": { "type": "command", "name": "settings.mouseProgress.border.toggle" } },

    { "id": "fl_name", "role": "label", "label": "Completion flash", "caption": "Brief flash after activation — on/off and one color for border and fill.", "row": 6, "col": 0 },
    { "id": "fl_val", "role": "value", "settingKey": "flashOnComplete", "label": "—", "row": 6, "col": 1 },
    { "id": "fl_tog", "label": "Toggle", "activeState": "setting.flashOnComplete", "row": 6, "col": 2, "action": { "type": "command", "name": "settings.flash.toggle" } },
    { "id": "fl_col", "label": "Color", "row": 6, "col": 3, "colSpan": 2, "action": { "type": "command", "name": "settings.edit.color.flashColor" } },

    { "id": "fd_label", "role": "label", "label": "Flash duration", "caption": "How long the completion flash is shown (ms).", "row": 7, "col": 0 },
    { "id": "fd_dec", "label": "−", "row": 7, "col": 2, "action": { "type": "command", "name": "settings.nudge.flashMs.dec" } },
    { "id": "fd_val", "role": "value", "settingKey": "flashMs", "label": "—", "row": 7, "col": 3 },
    { "id": "fd_inc", "label": "+", "row": 7, "col": 4, "action": { "type": "command", "name": "settings.nudge.flashMs.inc" } },

    { "id": "close", "label": "Close", "row": 9, "col": 2, "colSpan": 1, "action": { "type": "closeLayout" } }
  ]
}
