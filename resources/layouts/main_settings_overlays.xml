<Page id="main_settings_overlays" name="Look to scroll and ComboMouse" thickness="1" radius="4">
  <Style id="group" background="#00000000" thickness="1" radius="8"/>
  <Style id="row" background="#00000000" thickness="1" radius="6"/>
  <Style id="plain" background="#00000000" thickness="0" radius="0"/>
  <Style id="join" background="#00000000" thickness="0" radius="0"/>
  <Grid id="board" desktopMode="true" rows="11" columns="16" anchor="Top" offset="0,0" size="A_ScreenHeight/9*16, A_ScreenHeight" gap="6" margin="12" thickness="1" radius="4">
    <SubGrid id="tabs" row="0" col="0" colSpan="16" rows="1" columns="6" gap="6">
      <Cell id="tab_buttons" row="0" col="0" label="Button" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_button_timing"/>
      </Cell>
      <Cell id="tab_pointers" row="0" col="1" label="Pointer" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_pointer_timing"/>
      </Cell>
      <Cell id="tab_styles" row="0" col="2" label="Styles" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_styles"/>
      </Cell>
      <Cell id="tab_assist" row="0" col="3" label="Assist" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_assist"/>
      </Cell>
      <Cell id="tab_overlay" row="0" col="4" label="Overlay" role="tab" interactive="false"/>
      <Cell id="tab_theme" row="0" col="5" label="Theme" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_theme"/>
      </Cell>
    </SubGrid>

    <SubGrid id="sec_dist" row="1" col="0" colSpan="16" rowSpan="5" rows="5" columns="1" rowWeights="1,2,2,2,2" gap="6" margin="6" style="group">
      <Cell id="h_dist" row="0" col="0" label="Look to scroll" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_dz" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="dz_l" row="0" col="0" label="Deadzone" caption="No-scroll radius around cursor (px)." role="label" style="plain"/>
        <SubGrid id="act_dz" row="0" col="1" rows="1" columns="7" gap="0" style="row">
          <Cell id="dz_dec" row="0" col="0" label="−" style="join" command="settings.nudge.ltsDeadzonePx.dec"/>
          <Cell id="dz_val" row="0" col="1" colSpan="3" label="—" role="value" settingKey="ltsDeadzonePx" style="join"/>
          <Cell id="dz_inc" row="0" col="4" label="+" style="join" command="settings.nudge.ltsDeadzonePx.inc"/>
          <Cell id="dz_edit" row="0" col="5" colSpan="2" label="Edit…" style="join" command="settings.edit.ltsDeadzonePx"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_fo" row="2" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="fo_l" row="0" col="0" label="Falloff" caption="Distance to full speed past deadzone (px)." role="label" style="plain"/>
        <SubGrid id="act_fo" row="0" col="1" rows="1" columns="7" gap="0" style="row">
          <Cell id="fo_dec" row="0" col="0" label="−" style="join" command="settings.nudge.ltsFalloffPx.dec"/>
          <Cell id="fo_val" row="0" col="1" colSpan="3" label="—" role="value" settingKey="ltsFalloffPx" style="join"/>
          <Cell id="fo_inc" row="0" col="4" label="+" style="join" command="settings.nudge.ltsFalloffPx.inc"/>
          <Cell id="fo_edit" row="0" col="5" colSpan="2" label="Edit…" style="join" command="settings.edit.ltsFalloffPx"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_accel" row="3" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="accel_label" row="0" col="0" label="Accel / s" caption="Speed growth while outside deadzone. Peak rate is 1, 5, 10, 20, or 40 from the plus menu." role="label" style="plain"/>
        <SubGrid id="act_accel" row="0" col="1" rows="1" columns="7" gap="0" style="row">
          <Cell id="accel_dec" row="0" col="0" label="−" style="join" command="settings.nudge.ltsAccelPerSec.dec"/>
          <Cell id="accel_val" row="0" col="1" colSpan="3" label="—" role="value" settingKey="ltsAccelPerSec" style="join"/>
          <Cell id="accel_inc" row="0" col="4" label="+" style="join" command="settings.nudge.ltsAccelPerSec.inc"/>
          <Cell id="accel_edit" row="0" col="5" colSpan="2" label="Edit…" style="join" command="settings.edit.ltsAccelPerSec"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_ind" row="4" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="ind_l" row="0" col="0" label="Scroll Style" caption="Fan wedge, stretching orb, or hub/menu only." role="label" style="plain"/>
        <SubGrid id="act_ind" row="0" col="1" rows="1" columns="3" gap="0" style="row">
          <Cell id="ind_fan" row="0" col="0" label="Fan" activeState="setting.ltsIndicator.0" style="join" command="settings.lts.indicator.fan"/>
          <Cell id="ind_orb" row="0" col="1" label="Orb" activeState="setting.ltsIndicator.1" style="join" command="settings.lts.indicator.orb"/>
          <Cell id="ind_pause" row="0" col="2" label="Pause" activeState="setting.ltsIndicator.2" style="join" command="settings.lts.indicator.pause"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_combo" row="6" col="0" colSpan="16" rowSpan="5" rows="5" columns="1" rowWeights="1,2,2,2,2" gap="6" margin="6" style="group">
      <Cell id="h_combo" row="0" col="0" label="ComboMouse" caption="Dwell to place, then drift and click from the pie." role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_combo_inner" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="ci_l" row="0" col="0" label="Inner radius" caption="Inner edge of the drift ring (px)." role="label" style="plain"/>
        <SubGrid id="act_ci" row="0" col="1" rows="1" columns="7" gap="0" style="row">
          <Cell id="ci_dec" row="0" col="0" label="−" style="join" command="settings.nudge.comboInnerRadiusPx.dec"/>
          <Cell id="ci_val" row="0" col="1" colSpan="3" label="—" role="value" settingKey="comboInnerRadiusPx" style="join"/>
          <Cell id="ci_inc" row="0" col="4" label="+" style="join" command="settings.nudge.comboInnerRadiusPx.inc"/>
          <Cell id="ci_edit" row="0" col="5" colSpan="2" label="Edit…" style="join" command="settings.edit.comboInnerRadiusPx"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_combo_shared" row="2" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="cs_l" row="0" col="0" label="Shared radius" caption="Where the drift ring meets the command pie (px)." role="label" style="plain"/>
        <SubGrid id="act_cs" row="0" col="1" rows="1" columns="7" gap="0" style="row">
          <Cell id="cs_dec" row="0" col="0" label="−" style="join" command="settings.nudge.comboSharedRadiusPx.dec"/>
          <Cell id="cs_val" row="0" col="1" colSpan="3" label="—" role="value" settingKey="comboSharedRadiusPx" style="join"/>
          <Cell id="cs_inc" row="0" col="4" label="+" style="join" command="settings.nudge.comboSharedRadiusPx.inc"/>
          <Cell id="cs_edit" row="0" col="5" colSpan="2" label="Edit…" style="join" command="settings.edit.comboSharedRadiusPx"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_combo_outer" row="3" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="co_l" row="0" col="0" label="Outer radius" caption="Outer edge of the command pie (px)." role="label" style="plain"/>
        <SubGrid id="act_co" row="0" col="1" rows="1" columns="7" gap="0" style="row">
          <Cell id="co_dec" row="0" col="0" label="−" style="join" command="settings.nudge.comboOuterRadiusPx.dec"/>
          <Cell id="co_val" row="0" col="1" colSpan="3" label="—" role="value" settingKey="comboOuterRadiusPx" style="join"/>
          <Cell id="co_inc" row="0" col="4" label="+" style="join" command="settings.nudge.comboOuterRadiusPx.inc"/>
          <Cell id="co_edit" row="0" col="5" colSpan="2" label="Edit…" style="join" command="settings.edit.comboOuterRadiusPx"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_combo_style" row="4" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="combo_style_l" row="0" col="0" label="ComboMouse Style" caption="Inner and outer color and opacity." role="label" style="plain"/>
        <SubGrid id="row_combo_colors" row="0" col="1" rows="1" columns="3" gap="0" style="row">
          <Cell id="combo_on" row="0" col="0" label="Toggle" icon="PieSlice5" role="toggle" activeState="comboMouse" style="join" command="toggleComboMouse"/>
          <Cell id="cic_sw" row="0" col="1" label="Inner ring" caption="Color and opacity of the drift ring." settingKey="comboInnerColor" style="join" command="settings.edit.color.comboInnerColor"/>
          <Cell id="coc_sw" row="0" col="2" label="Outer ring" caption="Color and opacity of the command slices." settingKey="comboOuterColor" style="join" command="settings.edit.color.comboOuterColor"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>
  </Grid>
</Page>
