<Page id="main_settings_head_pose" name="Head" radius="16">
  <Style id="group" thickness="0" radius="16"/>
  <Style id="row" background="#00000000" thickness="0" radius="0"/>
  <Style id="plain" background="#00000000" thickness="0" radius="0"/>
  <Style id="join" background="#00000000" thickness="0" radius="0"/>
  <Style id="joinLeft" background="#00000000" thickness="0" radius="10,0,0,10"/>
  <Style id="joinRight" background="#00000000" thickness="0" radius="0,10,10,0"/>
  <Style id="tabbar" thickness="0" radius="12"/>
  <Grid id="board" desktopMode="true" rows="10" columns="16" anchor="Top" offset="0,0"
        size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth), A_ScreenHeight" gap="6" margin="12" radius="16">
    <SubGrid id="tabs" row="0" col="0" colSpan="16" rows="1" columns="9" gap="6" margin="4" style="tabbar">
      <Cell id="tab_speed" row="0" col="0" label="Speed" icon="timer" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_speed"/>
      </Cell>
      <Cell id="tab_magnify" row="0" col="1" label="Magnify" icon="ZoomSettings" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_magnify"/>
      </Cell>
      <Cell id="tab_indicators" row="0" col="2" label="Indicators" icon="cycle" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_indicators"/>
      </Cell>
      <Cell id="tab_assist" row="0" col="3" label="Assist" icon="ideas" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_assist"/>
      </Cell>
      <Cell id="tab_tools" row="0" col="4" label="Tools" icon="lookToScroll" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_tools"/>
      </Cell>
      <Cell id="tab_theme" row="0" col="5" label="Theme" icon="palette" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_theme"/>
      </Cell>
      <Cell id="tab_speech" row="0" col="6" label="Speech" icon="Speak" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_speech"/>
      </Cell>
      <Cell id="tab_head" row="0" col="7" label="Head" icon="HeadPreview" role="tab"/>
      <Cell id="tab_done" row="0" col="8" label="Done" icon="keyboardHide">
        <CloseAllPages/>
      </Cell>
    </SubGrid>

    <Cell id="page_title" row="1" col="0" colSpan="16" label="Head pose"
          caption="Map yaw, pitch, roll, and position to pointer, scroll, gaze, pad, or a command"
          role="label" textStyle="title" style="plain"/>

    <SubGrid id="sec_preview" row="2" col="0" colSpan="8" rowSpan="8" rows="4" columns="1"
             rowWeights="1,5,1,3" gap="6" margin="6" style="group">
      <Cell id="h_preview" row="0" col="0" label="Head Pose" role="label" textStyle="section" style="plain"/>
      <Cell id="head_preview" row="1" col="0" label="Head Preview" role="headpreview" style="plain"/>
      <SubGrid id="row_axes" row="2" col="0" rows="1" columns="6" gap="0" style="row">
        <Cell id="axis_yaw" row="0" col="0" label="Yaw" role="choice" activeState="headPose.chart.axis.yaw"
              style="joinLeft" command="headPose.chart.axis.yaw"/>
        <Cell id="axis_pitch" row="0" col="1" label="Pitch" role="choice" activeState="headPose.chart.axis.pitch"
              style="join" command="headPose.chart.axis.pitch"/>
        <Cell id="axis_roll" row="0" col="2" label="Roll" role="choice" activeState="headPose.chart.axis.roll"
              style="join" command="headPose.chart.axis.roll"/>
        <Cell id="axis_x" row="0" col="3" label="X" role="choice" activeState="headPose.chart.axis.x"
              style="join" command="headPose.chart.axis.x"/>
        <Cell id="axis_y" row="0" col="4" label="Y" role="choice" activeState="headPose.chart.axis.y"
              style="join" command="headPose.chart.axis.y"/>
        <Cell id="axis_z" row="0" col="5" label="Z" role="choice" activeState="headPose.chart.axis.z"
              style="joinRight" command="headPose.chart.axis.z"/>
      </SubGrid>
      <Cell id="pose_curve" row="3" col="0" label="in → out" role="curvefield"/>
    </SubGrid>

    <SubGrid id="sec_maps" row="2" col="8" colSpan="8" rowSpan="8" rows="4" columns="1"
             rowWeights="1,1,5,1" gap="6" margin="6" style="group">
      <Cell id="h_maps" row="0" col="0" label="Map" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_maps_actions" row="1" col="0" rows="1" columns="3" gap="6" style="row">
        <Cell id="hp_enable" row="0" col="0" label="Enable" role="toggle" activeState="headPose.enabled"
              style="joinLeft" command="headPose.enabled.toggle"/>
        <Cell id="hp_recenter" row="0" col="1" label="Recenter" caption="Zero all six axes at current pose" icon="Refocus"
              style="join" command="headPose.recenter"/>
        <Cell id="hp_add" row="0" col="2" label="Add Map" icon="add" style="joinRight" command="headPose.addMap"/>
      </SubGrid>
      <SubGrid id="maps" row="2" col="0" rows="1" columns="6" gap="4" style="row">
        <Cell id="maps_empty" row="0" col="0" colSpan="6" label="No maps" caption="Add a map to send head motion to the pointer or a command."
              role="label" style="plain"/>
      </SubGrid>
      <Cell id="maps_hint" row="3" col="0" label="Each map sends one axis to an output"
            caption="Edit to choose destination and scale the input→output curve." role="label" style="plain"/>
    </SubGrid>
  </Grid>
</Page>
