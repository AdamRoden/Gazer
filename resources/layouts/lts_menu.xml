<Page id="lts_menu" name="Look to scroll">
  <Style id="hub" background="#990C0E12" foreground="#FFFFFFFF" border="#99FFFFFF" thickness="2" radius="0" blur="15" progressStyle="radial"/>
  <Style id="slow" background="#59FFC428" foreground="#FFFFFFFF" border="#B3FFC428" thickness="2" radius="900,0,0,900" blur="15" progressStyle="radial"/>
  <Style id="fast" background="#5930C458" foreground="#FFFFFFFF" border="#B330C458" thickness="2" radius="0,900,900,0" blur="15" progressStyle="radial"/>
  <Style id="quit" background="#59E83830" foreground="#FFFFFFFF" border="#B3E83830" thickness="2" radius="0,0,900,900" blur="15" progressStyle="radial"/>
  <Style id="reset" background="#59388CFF" foreground="#FFFFFFFF" border="#B3388CFF" thickness="2" radius="900,900,0,0" blur="15" progressStyle="radial"/>

  <Grid id="plus" desktopMode="true" rows="3" columns="3" anchor="Center" offset="0,0" size="0.25h,0.25h" gap="0" margin="0" shell="true" background="#00000000" thickness="0">
    <Cell id="north" row="0" col="1" style="reset" icon="RestartIcon">
      <Action id="Command" value="lts.reset"/>
    </Cell>
    <Cell id="west" row="1" col="0" style="slow" icon="LookToScrollSpeedSlowIcon">
      <Action id="Command" value="lts.speed.slower"/>
    </Cell>
    <Cell id="east" row="1" col="2" style="fast" icon="LookToScrollSpeedFastIcon">
      <Action id="Command" value="lts.speed.faster"/>
    </Cell>
    <Cell id="south" row="2" col="1" style="quit" icon="QuitIcon">
      <Action id="Command" value="lts.quit"/>
    </Cell>
    <Cell id="hub" row="1" col="1" style="hub" label="5" icon="PlayButtonIcon">
      <Action id="Command" value="lts.resume"/>
    </Cell>
  </Grid>
</Page>
