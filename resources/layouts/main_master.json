{
  "schemaVersion": 2,
  "id": "main_master",
  "name": "Dock",
  "description": "Persistent root. Window omitted for a headless dock.",
  "master": true,
  "children": [
    { "id": "home", "layoutId": "main_drawer", "visibleWhen": "expanded" },
    { "id": "quit", "layoutId": "main_quit_confirm", "visibleWhen": "quitConfirm" }
  ],
  "items": [
    {
      "id": "e1",
      "label": "Main",
      "unbounded": true,
      "dwellExempt": true,
      "visibleWhen": "!expanded",
      "dwellRegion": {
        "screenAnchor": "bottomCenter",
        "widthPx": 300,
        "heightPx": 200,
        "yPx": 100
      },
      "actions": [{ "type": "command", "name": "resumeDwell" },{ "type": "command", "name": "expandMaster" }]
    },
    {
      "id": "e2",
      "label": "Sleep",
      "unbounded": true,
      "dwellRegion": {
        "screenAnchor": "bottomCenter",
        "widthPx": 300,
        "heightPx": 200,
        "xPx": 400,
        "yPx": 100
      },
      "actions": [{ "type": "command", "name": "toggleDwellSuspend" }]
    }
  ]
}
