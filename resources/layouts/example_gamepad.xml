<?xml version="1.0" encoding="UTF-8"?>
<Page id="example_gamepad" name="Gamepad" radius="16" progressStyle="radial">
  <Style id="pad" background="transparent" thickness="0" radius="0"/>
  <Style id="faceX" background="blue70" radius="900"/>
  <Style id="faceY" background="yellow80" radius="900"/>
  <Style id="faceA" background="green70" radius="900"/>
  <Style id="faceB" background="red80" radius="900"/>
  <Style id="shoulder" background="neutral70" radius="14"/>
  <Style id="stickDir" background="teal70" radius="900"/>
  <Style id="meta" background="neutral60" radius="16"/>
  <Style id="trigger" background="orange70" radius="14"/>
  <Style id="close" background="indigo60" radius="16"/>
  <Style id="stickWell" background="bg80" thickness="0" radius="900"/>
  <Style id="stickHub" background="teal50" radius="900"/>
  <Style id="dpad" background="indigo60" radius="14"/>
  <Style id="guide" background="green60" radius="900"/>
  <Grid id="board" rows="9" columns="15" anchor="Center" offset="0,0" size="1.28h,0.76" gap="8" padding="16" rowHeights="2*,2*,3*,3*,3*,2*,3*,3*,3*" columnWidths="2*,3*,3*,3*,2*,2*,2*,3*,2*,2*,2*,3*,3*,3*,2*" background="transparent" thickness="0" radius="64">
    <Button id="lt" style="trigger" label="LT" caption="Hold" col="1" span="3" command="gamepad.lt"/>
    <Button style="guide" label="Xbox" col="7" command="gamepad.guide"/>
    <Button style="trigger" label="RT" caption="Hold" col="11" span="3" command="gamepad.rt"/>
    <Button style="close" label="Close" icon="AlignBottom" col="14" closePage="true"/>
    <Button style="shoulder" label="LB" row="1" col="1" span="3" command="gamepad.lb"/>
    <Button style="meta" label="View" row="1" col="5" command="gamepad.back"/>
    <Button style="meta" label="Menu" row="1" col="9" command="gamepad.start"/>
    <Button style="shoulder" label="RB" row="1" col="11" span="3" command="gamepad.rb"/>
    <Button style="meta" label="L3" row="5" col="2" command="gamepad.l3"/>
    <Button id="analog_center" style="meta" label="Release analog" row="5" col="7">
      <Command value="lookTo.leftStick.quit"/>
      <Command value="lookTo.rightStick.quit"/>
      <Command value="gamepad.analog.center"/>
    </Button>
    <Button style="meta" label="R3" row="5" col="12" command="gamepad.r3"/>
    <Grid id="left_stick" rows="3" columns="3" row="2" col="1" rowSpan="3" colSpan="3" gap="6" padding="4" style="stickWell">
      <Button style="stickDir" icon="ArrowPointingToTopLeft" command="gamepad.ls.nw"/>
      <Button style="stickDir" icon="ArrowPointingToTop" col="1" command="gamepad.ls.n"/>
      <Button style="stickDir" icon="ArrowPointingToTopRight" col="2" command="gamepad.ls.ne"/>
      <Button style="stickDir" icon="ArrowPointingToLeft" row="1" command="gamepad.ls.w"/>
      <Button id="ls_hub" style="stickHub" label="LS" icon="sportsEsports" caption="Look-to" bind="lookToLeftStick" row="1" col="1" command="lookToLeftStick"/>
      <Button style="stickDir" icon="ArrowPointingToRight" row="1" col="2" command="gamepad.ls.e"/>
      <Button style="stickDir" icon="ArrowPointingToBottomLeft" row="2" command="gamepad.ls.sw"/>
      <Button style="stickDir" icon="ArrowPointingToBottom" row="2" col="1" command="gamepad.ls.s"/>
      <Button style="stickDir" icon="ArrowPointingToBottomRight" row="2" col="2" command="gamepad.ls.se"/>
    </Grid>
    <Grid id="face" rows="3" columns="3" row="2" col="11" rowSpan="3" colSpan="3" gap="10" padding="4" style="pad">
      <Button style="faceY" label="Y" textStyle="key" col="1" command="gamepad.y"/>
      <Button style="faceX" label="X" textStyle="key" row="1" command="gamepad.x"/>
      <Button style="faceB" label="B" textStyle="key" row="1" col="2" command="gamepad.b"/>
      <Button id="btn_a" style="faceA" label="A" textStyle="key" row="2" col="1" command="gamepad.a"/>
    </Grid>
    <Grid id="dpad" rows="3" columns="3" row="6" col="1" rowSpan="3" colSpan="3" gap="8" padding="4" style="pad">
      <Button id="dpad_up" style="dpad" icon="ArrowPointingToTop" col="1" command="gamepad.dpad.up"/>
      <Button style="dpad" icon="ArrowPointingToLeft" row="1" command="gamepad.dpad.left"/>
      <Label style="pad" label="D-pad" row="1" col="1"/>
      <Button style="dpad" icon="ArrowPointingToRight" row="1" col="2" command="gamepad.dpad.right"/>
      <Button style="dpad" icon="ArrowPointingToBottom" row="2" col="1" command="gamepad.dpad.down"/>
    </Grid>
    <Grid id="right_stick" rows="3" columns="3" row="6" col="11" rowSpan="3" colSpan="3" gap="6" padding="4" style="stickWell">
      <Button style="stickDir" icon="ArrowPointingToTopLeft" command="gamepad.rs.nw"/>
      <Button style="stickDir" icon="ArrowPointingToTop" col="1" command="gamepad.rs.n"/>
      <Button style="stickDir" icon="ArrowPointingToTopRight" col="2" command="gamepad.rs.ne"/>
      <Button style="stickDir" icon="ArrowPointingToLeft" row="1" command="gamepad.rs.w"/>
      <Button id="rs_hub" style="stickHub" label="RS" icon="sportsEsports" caption="Look-to" bind="lookToRightStick" row="1" col="1" command="lookToRightStick"/>
      <Button style="stickDir" icon="ArrowPointingToRight" row="1" col="2" command="gamepad.rs.e"/>
      <Button style="stickDir" icon="ArrowPointingToBottomLeft" row="2" command="gamepad.rs.sw"/>
      <Button style="stickDir" icon="ArrowPointingToBottom" row="2" col="1" command="gamepad.rs.s"/>
      <Button style="stickDir" icon="ArrowPointingToBottomRight" row="2" col="2" command="gamepad.rs.se"/>
    </Grid>
  </Grid>
</Page>
