{
  "schemaVersion": 1,
  "id": "main_settings_buttons",
  "name": "Buttons",
  "description": "Board dwell timing, activator progress, and completion flash",
  "uiStyle": "fluent",
  "window": { "anchor": "TopCenter", "widthPx": 1600, "height": 100, "marginPx": 0 },
  "grid": { "columns": 16, "rows": 13, "gapPx": 10, "marginPx": 50 },
  "items": [
    { "id": "buttons", "label": "Buttons", "row": 1, "col": 0, "colSpan": 2, "action": { "type": "loadLayout", "layoutId": "main_settings_buttons" } },
    { "id": "pointers", "label": "Pointers", "row": 2, "col": 0, "colSpan": 2, "action": { "type": "loadLayout", "layoutId": "main_settings_pointers" } },
    { "id": "assist", "label": "Assist tools", "row": 3, "col": 0, "colSpan": 2, "action": { "type": "loadLayout", "layoutId": "main_settings_assist" } },
    { "id": "theme", "label": "Theme", "row": 4, "col": 0, "colSpan": 2, "action": { "type": "loadLayout", "layoutId": "main_settings_theme" } },
    { "id": "close", "label": "Close", "row": 11, "col": 0, "colSpan": 2, "action": { "type": "closeLayout" } },

    { "id": "grace_label", "role": "label", "label": "Blink grace", "caption": "Blink window without canceling dwell (ms).", "row": 1, "col": 3, "colSpan": 4 },
    { "id": "grace_dec", "label": "−", "row": 1, "col": 8, "colSpan": 1, "action": { "type": "command", "name": "settings.nudge.dwellGraceMs.dec" } },
    { "id": "grace_value", "role": "value", "settingKey": "dwellGraceMs", "label": "—", "row": 1, "col": 9, "colSpan": 2 },
    { "id": "grace_inc", "label": "+", "row": 1, "col": 11, "colSpan": 1, "action": { "type": "command", "name": "settings.nudge.dwellGraceMs.inc" } },
    { "id": "grace_edit", "label": "Edit…", "row": 1, "col": 12, "action": { "type": "command", "name": "settings.edit.dwellGraceMs" } },

    { "id": "scan_label", "role": "label", "label": "Scan grace", "caption": "Time on-target before dwell progress starts (ms).", "row": 2, "col": 3, "colSpan": 4 },
    { "id": "scan_dec", "label": "−", "row": 2, "col": 8, "colSpan": 1 },
    { "id": "scan_value", "role": "value", "settingKey": "scanGraceMs", "label": "—", "row": 2, "col": 9, "colSpan": 2 },
    { "id": "scan_inc", "label": "+", "row": 2, "col": 11, "colSpan": 1 },
    { "id": "scan_edit", "label": "Edit…", "row": 2, "col": 12, "action": { "type": "command", "name": "settings.edit.scanGraceMs" } },

    { "id": "dwell_label", "role": "label", "label": "Dwell sequence", "caption": "Comma-separated ms steps while holding. Last step repeats forever.", "row": 3, "col": 3, "colSpan": 4 },
    { "id": "dwell_value", "role": "value", "settingKey": "dwellMs", "label": "—", "row": 3, "col": 8, "colSpan": 4 },
    { "id": "dwell_edit", "label": "Edit…", "row": 3, "col": 12, "action": { "type": "command", "name": "settings.edit.dwellMs" } },

    { "id": "fd_label", "role": "label", "label": "Flash duration", "caption": "How long the completion flash is shown (ms).", "row": 4, "col": 3, "colSpan": 4 },
    { "id": "fd_dec", "label": "−", "row": 4, "col": 8, "colSpan": 1, "action": { "type": "command", "name": "settings.nudge.flashMs.dec" } },
    { "id": "fd_val", "role": "value", "settingKey": "flashMs", "label": "—", "row": 4, "col": 9, "colSpan": 2 },
    { "id": "fd_inc", "label": "+", "row": 4, "col": 11, "colSpan": 1, "action": { "type": "command", "name": "settings.nudge.flashMs.inc" } },

    { "id": "fl_name", "role": "label", "label": "Completion flash", "caption": "Flash after activation. Foreground uses the item text color; Custom picks a color.", "row": 5, "col": 3, "colSpan": 4 },
    { "id": "fl_fg", "label": "Use Foreground", "activeState": "setting.flashUseForeground", "row": 5, "col": 8, "colSpan": 2, "action": { "type": "command", "name": "settings.flash.foreground" } },
    { "id": "fl_custom", "label": "Custom", "activeState": "setting.flashUseCustom", "row": 5, "col": 10, "colSpan": 2, "action": { "type": "command", "name": "settings.flash.custom" } },

    { "id": "r_name", "role": "label", "label": "Activator Progress", "caption": "Progress styles for board cells.", "row": 6, "col": 3, "colSpan": 4 },
    { "id": "r_tog", "label": "Ring", "activeState": "setting.progressRadial", "row": 6, "col": 8, "colSpan": 1, "action": { "type": "command", "name": "settings.progress.radial.toggle" } },
    { "id": "f_tog", "label": "Fill", "activeState": "setting.progressFill", "row": 6, "col": 9, "colSpan": 1, "action": { "type": "command", "name": "settings.progress.fill.toggle" } },
    { "id": "b_tog", "label": "Border", "activeState": "setting.progressBorder", "row": 6, "col": 10, "colSpan": 1, "action": { "type": "command", "name": "settings.progress.border.toggle" } },

    { "id": "p_label", "role": "label", "label": "Quick presets", "caption": "Slow / Normal / Fast single-step packages.", "row": 9, "col": 3, "colSpan": 3 },
    { "id": "p_slow", "label": "Slow", "row": 9, "col": 7, "colSpan": 2, "action": { "type": "command", "name": "settings.dwell.slow" } },
    { "id": "p_norm", "label": "Normal", "row": 9, "col": 9, "colSpan": 2, "action": { "type": "command", "name": "settings.dwell.normal" } },
    { "id": "p_fast", "label": "Fast", "row": 9, "col": 11, "colSpan": 2, "action": { "type": "command", "name": "settings.dwell.fast" } }
  ]
}