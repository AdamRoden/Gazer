{
  "schemaVersion": 1,
  "id": "example_settings_timing",
  "name": "Timing",
  "description": "Label · − · value · + · Edit  ·  sequence e.g. 600,300,100,600 (last step holds forever)",
  "uiStyle": "fluent",
  "window": { "anchor": "center", "widthPx": 1100, "heightPx": 640, "marginPx": 16 },
  "grid": { "columns": 5, "rows": 5, "gapPx": 10, "marginPx": 56 },
  "dwell": { "enabled": true, "ms": [650], "progressStyle": "radial" },
  "items": [
    { "id": "dwell_label", "role": "label", "label": "Dwell sequence", "caption": "Comma-separated ms steps while holding (e.g. 600,300,100,600). Last step repeats forever.", "row": 0, "col": 0 },
    { "id": "dwell_dec", "label": "−", "row": 0, "col": 1, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.dwellMs.dec" } },
    { "id": "dwell_value", "role": "value", "settingKey": "dwellMs", "label": "—", "row": 0, "col": 2 },
    { "id": "dwell_inc", "label": "+", "row": 0, "col": 3, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.dwellMs.inc" } },
    { "id": "dwell_edit", "label": "Edit…", "row": 0, "col": 4, "style": { "background": "#0a7ea4", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.edit.dwellMs" } },

    { "id": "grace_label", "role": "label", "label": "Blink grace", "caption": "Blink window without canceling dwell (ms).", "row": 1, "col": 0 },
    { "id": "grace_dec", "label": "−", "row": 1, "col": 1, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.dwellGraceMs.dec" } },
    { "id": "grace_value", "role": "value", "settingKey": "dwellGraceMs", "label": "—", "row": 1, "col": 2 },
    { "id": "grace_inc", "label": "+", "row": 1, "col": 3, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.dwellGraceMs.inc" } },
    { "id": "grace_edit", "label": "Edit…", "row": 1, "col": 4, "style": { "background": "#0a7ea4", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.edit.dwellGraceMs" } },

    { "id": "mm_label", "role": "label", "label": "Mouse-move dwell", "caption": "Dwell time for cursor placement (ms).", "row": 2, "col": 0 },
    { "id": "mm_dec", "label": "−", "row": 2, "col": 1, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.mouseMoveDwellMs.dec" } },
    { "id": "mm_value", "role": "value", "settingKey": "mouseMoveDwellMs", "label": "—", "row": 2, "col": 2 },
    { "id": "mm_inc", "label": "+", "row": 2, "col": 3, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.mouseMoveDwellMs.inc" } },
    { "id": "mm_edit", "label": "Edit…", "row": 2, "col": 4, "style": { "background": "#0a7ea4", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.edit.mouseMoveDwellMs" } },

    { "id": "p_label", "role": "label", "label": "Quick presets", "caption": "Slow / Normal / Fast single-step packages.", "row": 3, "col": 0 },
    { "id": "p_slow", "label": "Slow", "row": 3, "col": 1, "style": { "background": "#264653", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.dwell.slow" } },
    { "id": "p_norm", "label": "Normal", "row": 3, "col": 2, "style": { "background": "#2a9d8f", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.dwell.normal" } },
    { "id": "p_fast", "label": "Fast", "row": 3, "col": 3, "colSpan": 2, "style": { "background": "#e9c46a", "foreground": "#1a1a1a" }, "action": { "type": "command", "name": "settings.dwell.fast" } },

    { "id": "pause_dwell", "label": "Pause dwell", "activeState": "dwellSuspend", "row": 4, "col": 0, "style": { "background": "#8b5a2b", "foreground": "#fff" }, "action": { "type": "command", "name": "toggleDwellSuspend" } },
    { "id": "back", "label": "← Settings", "row": 4, "col": 1, "colSpan": 2, "style": { "background": "#0a7ea4", "foreground": "#fff" }, "action": { "type": "loadLayout", "layoutId": "example_settings" } },
    { "id": "close", "label": "Close", "row": 4, "col": 3, "colSpan": 2, "style": { "background": "#4a5568", "foreground": "#fff" }, "action": { "type": "closeLayout" } }
  ]
}
