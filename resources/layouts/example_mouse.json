{
  "schemaVersion": 1,
  "id": "example_mouse",
  "name": "Mouse",
  "window": {
    "anchor": "bottomCenter",
    "widthPx": 1100,
    "heightPx": 360
  },
  "grid": {
    "columns": 9,
    "rows": 3,
    "gapPx": 8,
    "marginPx": 8
  },
  "items": [
    { "id": "lclick", "label": "Left", "icon": "MouseLeftClick", "row": 0, "col": 0,
      "style": { "background": "#1b4332", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "mouseLeftClick" } },
    { "id": "ldbl", "label": "L×2", "icon": "MouseLeftDoubleClick", "row": 0, "col": 1,
      "style": { "background": "#1b4332", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "mouseLeftDoubleClick" } },
    { "id": "rclick", "label": "Right", "icon": "MouseRightClick", "row": 0, "col": 2,
      "style": { "background": "#2d6a4f", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "mouseRightClick" } },
    { "id": "rdbl", "label": "R×2", "icon": "MouseRightButtonDoubleClick", "row": 0, "col": 3,
      "style": { "background": "#2d6a4f", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "mouseRightDoubleClick" } },
    { "id": "mclick", "label": "Middle", "icon": "MouseMiddleClick", "row": 0, "col": 4,
      "style": { "background": "#40916c", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "mouseMiddleClick" } },
    { "id": "ldownup", "label": "L Hold", "icon": "MouseLeftDownUp", "activeState": "mouse.leftHold",
      "row": 0, "col": 5,
      "style": { "background": "#9b2226", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "mouseLeftDownUp" } },
    { "id": "rdownup", "label": "R Hold", "icon": "MouseRightDownUp", "activeState": "mouse.rightHold",
      "row": 0, "col": 6,
      "style": { "background": "#9b2226", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "mouseRightDownUp" } },
    { "id": "mdownup", "label": "M Hold", "icon": "MouseMiddleDownUp", "activeState": "mouse.middleHold",
      "row": 0, "col": 7,
      "style": { "background": "#9b2226", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "mouseMiddleDownUp" } },
    { "id": "move_lclick", "label": "Move+L", "icon": "MouseLeftButtonClick",
      "activeState": "mouseMoveAndLeftClick", "row": 0, "col": 8,
      "style": { "background": "#e9c46a", "foreground": "#1a1a1a" },
      "action": { "type": "command", "name": "mouseMoveAndLeftClick" } },

    { "id": "nudge_up", "label": "Up", "icon": "ArrowPointingToTop", "row": 1, "col": 0,
      "style": { "background": "#264653", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "mouseMoveUp" } },
    { "id": "nudge_left", "label": "Left", "icon": "ArrowPointingToLeft", "row": 1, "col": 1,
      "style": { "background": "#264653", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "mouseMoveLeft" } },
    { "id": "nudge_right", "label": "Right", "icon": "ArrowPointingToRight", "row": 1, "col": 2,
      "style": { "background": "#264653", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "mouseMoveRight" } },
    { "id": "nudge_down", "label": "Down", "icon": "ArrowPointingToBottom", "row": 1, "col": 3,
      "style": { "background": "#264653", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "mouseMoveDown" } },
    { "id": "sc_up", "label": "Scroll ↑", "icon": "MouseScrollToTop", "row": 1, "col": 4,
      "style": { "background": "#1d3557", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "mouseScrollUp" } },
    { "id": "sc_down", "label": "Scroll ↓", "icon": "MouseScrollToBottom", "row": 1, "col": 5,
      "style": { "background": "#1d3557", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "mouseScrollDown" } },
    { "id": "sc_left", "label": "Scroll ←", "icon": "MouseScrollToLeft", "row": 1, "col": 6,
      "style": { "background": "#1d3557", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "mouseScrollLeft" } },
    { "id": "sc_right", "label": "Scroll →", "icon": "MouseScrollToRight", "row": 1, "col": 7,
      "style": { "background": "#1d3557", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "mouseScrollRight" } },
    { "id": "move_rclick", "label": "Move+R", "icon": "MouseRightButtonClick",
      "activeState": "mouseMoveAndRightClick", "row": 1, "col": 8,
      "style": { "background": "#f4a261", "foreground": "#1a1a1a" },
      "action": { "type": "command", "name": "mouseMoveAndRightClick" } },

    { "id": "dwell_move", "label": "Move to…", "icon": "MouseMoveTo", "activeState": "mouseDwellMove",
      "row": 2, "col": 0,
      "style": { "background": "#e9c46a", "foreground": "#1a1a1a" },
      "action": { "type": "command", "name": "mouseDwellMove" } },
    { "id": "mag_pick", "label": "Mag pick", "icon": "ZoomToLocation", "activeState": "mouseMoveMagPick",
      "row": 2, "col": 1,
      "style": { "background": "#f4a261", "foreground": "#1a1a1a" },
      "action": { "type": "command", "name": "toggleMouseMoveMagPick" } },
    { "id": "mag_center", "label": "Mag @dwell", "icon": "LookToScrollBoundsScreenPoint", "activeState": "mouseMoveMagPickCenter",
      "row": 2, "col": 2,
      "style": { "background": "#e76f51", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "toggleMouseMoveMagPickCenter" } },
    { "id": "movestep", "label": "Step 40 px", "icon": "SizeAndPosition", "row": 2, "col": 3,
      "style": { "background": "#3d4f66", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "cycleMouseMoveAmount" } },
    { "id": "scrstep", "label": "Scroll ×3", "icon": "LookToScrollSpeedMedium", "row": 2, "col": 4,
      "style": { "background": "#3d4f66", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "cycleMouseScrollAmount" } },
    { "id": "click_loop", "label": "Gaze click\nloop", "icon": "RepeatMouseAction", "activeState": "loop.gazeClick",
      "row": 2, "col": 5,
      "style": { "background": "#c1121f", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "mouseDwellClickLoop" } },
    { "id": "mag", "label": "Lens", "icon": "MouseMagnifier", "activeState": "magnifier",
      "row": 2, "col": 6,
      "style": { "background": "#6a4c93", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "toggleMagnifier" } },
    { "id": "lts", "label": "Look↕Scroll", "icon": "LookToScrollActive", "activeState": "lookToScroll",
      "row": 2, "col": 7,
      "style": { "background": "#0a7ea4", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "toggleLookToScroll" } },
    { "id": "main", "label": "Main", "icon": "Menu", "row": 2, "col": 8,
      "style": { "background": "#0a7ea4", "foreground": "#ffffff" },
      "action": { "type": "loadLayout", "layoutId": "main_drawer" } }
  ]
}
