<?xml version="1.0" encoding="UTF-8"?>
<Page id="main_update" name="Update" radius="16">
  <Style id="plain" background="transparent" thickness="0" radius="0"/>
  <Style id="button" background="transparent" thickness="0" radius="10"/>
  <Grid id="board" rows="3" columns="2" desktopMode="true" anchor="Top" offset="0,24" size="880,300" gap="8" padding="16" rowHeights="64,*,72" radius="16">
    <Label id="update_title" style="plain" label="Update" textStyle="title" span="2"/>
    <Label id="update_body" style="plain" label="Checking for updates" row="1" span="2"/>
    <Button id="update_now" style="button" label="Update now" row="2" command="settings.update.now"/>
    <Button style="button" label="Later" row="2" col="1" command="settings.update.later"/>
  </Grid>
</Page>
