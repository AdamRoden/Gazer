{
  "schemaVersion": 1,
  "id": "main_settings_theme",
  "name": "Theme",
  "description": "Custom palette: pick colors, then set contrast to Low, Medium, or High.",
  "uiStyle": "fluent",
  "window": { "anchor": "TopCenter", "widthPx": 1260, "height": 100, "marginPx": 0 },
  "grid": { "columns": 6, "rows": 10, "gapPx": 10, "marginPx": 100 },
  "items": [
    { "id": "buttons", "label": "Buttons", "row": 0, "col": 0, "action": { "type": "loadLayout", "layoutId": "main_settings_buttons" } },
    { "id": "pointers", "label": "Pointers", "row": 0, "col": 1, "action": { "type": "loadLayout", "layoutId": "main_settings_pointers" } },
    { "id": "lts", "label": "Look↕Scroll", "row": 0, "col": 2, "action": { "type": "loadLayout", "layoutId": "main_settings_lts" } },
    { "id": "theme", "label": "Theme", "row": 0, "col": 3 },
    { "id": "assist", "label": "Assist tools", "row": 0, "col": 4, "action": { "type": "loadLayout", "layoutId": "main_settings_assist" } },

    { "id": "bg_name", "role": "swatch", "label": "Background", "caption": "Source color. Variant, foreground, and accent suggestions are generated from this.", "settingKey": "customBgColor", "interactive": true, "row": 2, "col": 0, "colSpan": 2, "action": { "type": "command", "name": "settings.edit.color.customBgColor" } },
    { "id": "var_sw", "role": "swatch", "label": "Variant", "caption": "Surface", "settingKey": "customSurfaceColor", "interactive": true, "row": 2, "col": 2, "action": { "type": "command", "name": "settings.edit.color.customSurfaceColor" } },
    { "id": "fg_sw", "role": "swatch", "label": "Foreground", "caption": "On background", "settingKey": "customTextColor", "interactive": true, "row": 2, "col": 3, "colSpan": 2, "action": { "type": "command", "name": "settings.edit.color.customTextColor" } },

    { "id": "pri_name", "role": "swatch", "label": "Primary", "caption": "Highlighted foreground.", "settingKey": "customPrimaryColor", "interactive": true, "row": 3, "col": 0, "colSpan": 2, "action": { "type": "command", "name": "settings.edit.color.customPrimaryColor" } },
    { "id": "sec_name", "role": "swatch", "label": "Secondary", "caption": "Progress colors.", "settingKey": "customSecondaryColor", "interactive": true, "row": 3, "col": 2, "colSpan": 2, "action": { "type": "command", "name": "settings.edit.color.customSecondaryColor" } },
    { "id": "ter_name", "role": "swatch", "label": "Tertiary", "caption": "Highlighted background.", "settingKey": "customTertiaryColor", "interactive": true, "row": 3, "col": 4, "colSpan": 2, "action": { "type": "command", "name": "settings.edit.color.customTertiaryColor" } },

    { "id": "c_name", "role": "label", "label": "Contrast", "caption": "How far tones are pushed apart.", "row": 4, "col": 0 },
    { "id": "c_low", "label": "Low", "activeState": "setting.theme.contrast.low", "row": 4, "col": 2, "action": { "type": "command", "name": "settings.theme.contrast.low" } },
    { "id": "c_med", "label": "Medium", "activeState": "setting.theme.contrast.medium", "row": 4, "col": 3, "action": { "type": "command", "name": "settings.theme.contrast.medium" } },
    { "id": "c_high", "label": "High", "activeState": "setting.theme.contrast.high", "row": 4, "col": 4, "action": { "type": "command", "name": "settings.theme.contrast.high" } },

    { "id": "mode_name", "role": "label", "label": "Use theme", "caption": "Custom applies this palette. Light / Dark use the built-in presets.", "row": 5, "col": 0 },
    { "id": "light", "label": "Light", "activeState": "setting.theme.light", "row": 5, "col": 2, "action": { "type": "command", "name": "theme.light" } },
    { "id": "dark", "label": "Dark", "activeState": "setting.theme.dark", "row": 5, "col": 3, "action": { "type": "command", "name": "theme.dark" } },
    { "id": "custom", "label": "Custom", "activeState": "setting.theme.custom", "row": 5, "col": 4, "action": { "type": "command", "name": "theme.custom" } },

    { "id": "close", "label": "Close", "row": 9, "col": 2, "colSpan": 2, "action": { "type": "closeLayout" } }
  ]
}
