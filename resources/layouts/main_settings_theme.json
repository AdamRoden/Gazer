{
  "schemaVersion": 1,
  "id": "main_settings_theme",
  "name": "Theme",
  "description": "Custom palette: pick colors, then set contrast to Low, Medium, or High.",
  "window": {
    "anchor": "TopCenter",
    "widthPx": 1600,
    "height": 100,
    "marginPx": 0,
    "style": {
      "radius": 8,
      "borderWidth": 1,
      "background": "#000000"
    }
  },
  "style": {
    "radius": 4
  },
  "grid": {
    "columns": 16,
    "rows": 12,
    "gapPx": 6,
    "marginPx": 12,
    "marginX": 5
  },
  "items": [
    {
      "id": "page_title",
      "role": "label",
      "textStyle": "title",
      "label": "Theme",
      "caption": "Custom palette: pick colors, then set contrast to Low, Medium, or High.",
      "row": 1,
      "col": 0,
      "colSpan": 16
    },
    {
      "id": "h_palette",
      "role": "label",
      "textStyle": "section",
      "label": "Palette",
      "row": 2,
      "col": 0,
      "colSpan": 16
    },
    {
      "id": "bg_name",
      "label": "Background",
      "caption": "Source color. Variant, foreground, and accent suggestions are generated from this.",
      "settingKey": "customBgColor",
      "interactive": true,
      "row": 3,
      "col": 0,
      "colSpan": 12,
      "action": {
        "type": "command",
        "name": "settings.edit.color.customBgColor"
      }
    },
    {
      "id": "var_sw",
      "label": "Variant",
      "caption": "Surface",
      "settingKey": "customSurfaceColor",
      "interactive": true,
      "row": 4,
      "col": 0,
      "colSpan": 8,
      "action": {
        "type": "command",
        "name": "settings.edit.color.customSurfaceColor"
      }
    },
    {
      "id": "fg_sw",
      "label": "Foreground",
      "caption": "On background",
      "settingKey": "customTextColor",
      "interactive": true,
      "row": 4,
      "col": 8,
      "colSpan": 4,
      "action": {
        "type": "command",
        "name": "settings.edit.color.customTextColor"
      }
    },
    {
      "id": "pri_name",
      "label": "Primary",
      "caption": "Highlighted foreground.",
      "settingKey": "customPrimaryColor",
      "interactive": true,
      "row": 5,
      "col": 0,
      "colSpan": 4,
      "action": {
        "type": "command",
        "name": "settings.edit.color.customPrimaryColor"
      }
    },
    {
      "id": "sec_name",
      "label": "Secondary",
      "caption": "Progress colors.",
      "settingKey": "customSecondaryColor",
      "interactive": true,
      "row": 5,
      "col": 4,
      "colSpan": 4,
      "action": {
        "type": "command",
        "name": "settings.edit.color.customSecondaryColor"
      }
    },
    {
      "id": "ter_name",
      "label": "Tertiary",
      "caption": "Highlighted background.",
      "settingKey": "customTertiaryColor",
      "interactive": true,
      "row": 5,
      "col": 8,
      "colSpan": 4,
      "action": {
        "type": "command",
        "name": "settings.edit.color.customTertiaryColor"
      }
    },
    {
      "id": "c_name",
      "role": "label",
      "label": "Contrast",
      "caption": "How far tones are pushed apart.",
      "row": 6,
      "col": 0,
      "colSpan": 6
    },
    {
      "id": "c_low",
      "label": "Low",
      "activeState": "setting.theme.contrast.low",
      "row": 6,
      "col": 8,
      "colSpan": 2,
      "action": {
        "type": "command",
        "name": "settings.theme.contrast.low"
      },
      "cluster": "segment.contrast"
    },
    {
      "id": "c_med",
      "label": "Medium",
      "activeState": "setting.theme.contrast.medium",
      "row": 6,
      "col": 10,
      "colSpan": 2,
      "action": {
        "type": "command",
        "name": "settings.theme.contrast.medium"
      },
      "cluster": "segment.contrast"
    },
    {
      "id": "c_high",
      "label": "High",
      "activeState": "setting.theme.contrast.high",
      "row": 6,
      "col": 12,
      "colSpan": 2,
      "action": {
        "type": "command",
        "name": "settings.theme.contrast.high"
      },
      "cluster": "segment.contrast"
    },
    {
      "id": "mode_name",
      "role": "label",
      "label": "Use theme",
      "caption": "Custom applies this palette. Light / Dark use the built-in presets.",
      "row": 7,
      "col": 0,
      "colSpan": 6
    },
    {
      "id": "light",
      "label": "Light",
      "activeState": "setting.theme.light",
      "row": 7,
      "col": 8,
      "colSpan": 2,
      "action": {
        "type": "command",
        "name": "theme.light"
      },
      "cluster": "segment.theme"
    },
    {
      "id": "dark",
      "label": "Dark",
      "activeState": "setting.theme.dark",
      "row": 7,
      "col": 10,
      "colSpan": 2,
      "action": {
        "type": "command",
        "name": "theme.dark"
      },
      "cluster": "segment.theme"
    },
    {
      "id": "custom",
      "label": "Custom",
      "activeState": "setting.theme.custom",
      "row": 7,
      "col": 12,
      "colSpan": 2,
      "action": {
        "type": "command",
        "name": "theme.custom"
      },
      "cluster": "segment.theme"
    },
    {
      "id": "fl_name",
      "role": "label",
      "label": "Completion flash",
      "caption": "Flash after activation. Foreground uses the item text color; Custom picks a color.",
      "row": 8,
      "col": 0,
      "colSpan": 6
    },
    {
      "id": "fl_fg",
      "label": "Use Foreground",
      "activeState": "setting.flashUseForeground",
      "row": 8,
      "col": 8,
      "colSpan": 2,
      "action": {
        "type": "command",
        "name": "settings.flash.foreground"
      },
      "cluster": "segment.flash"
    },
    {
      "id": "fl_custom",
      "label": "Custom",
      "activeState": "setting.flashUseCustom",
      "row": 8,
      "col": 10,
      "colSpan": 2,
      "action": {
        "type": "command",
        "name": "settings.flash.custom"
      },
      "cluster": "segment.flash"
    },
    {
      "id": "fl_sw",
      "label": "Flash color",
      "settingKey": "flashColor",
      "interactive": true,
      "row": 8,
      "col": 12,
      "colSpan": 4,
      "action": {
        "type": "command",
        "name": "settings.edit.color.flashColor"
      }
    }
  ]
}
