<Page id="main_settings_pointer" name="Pointer" radius="16">
  <Style id="group" background="bg95" thickness="0" radius="16"/>
  <Style id="row" background="transparent" thickness="0" radius="0"/>
  <Style id="plain" background="transparent" thickness="0" radius="0"/>
  <Style id="join" background="transparent" thickness="0" radius="0"/>
  <Style id="joinLeft" background="transparent" thickness="0" radius="10,0,0,10"/>
  <Style id="joinRight" background="transparent" thickness="0" radius="0,10,10,0"/>
  <Style id="button" background="transparent" thickness="0" radius="10"/>
  <Grid id="board" desktopMode="true" rows="2" columns="2" anchor="Top" offset="0,0" size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth), A_ScreenHeight" gap="12" margin="0" radius="16"
        rowHeights="96,*" columnWidths="*,72">
    <SubGrid id="titlebar" row="0" col="0" colSpan="2" rows="1" columns="2" columnWidths="*,160" gap="8" margin="0" style="plain">
      <Cell id="page_title" row="0" col="0" label="Pointer" caption="Click placement and the zoom window." role="label" textStyle="title" style="plain"/>
      <Cell id="tab_done" row="0" col="1" label="Close" icon="keyboardHide" textStyle="row" style="button" closeAllPages="true"/>
    </SubGrid>
    <SubGrid id="scroller" row="1" col="0" scroll="true" rows="2" columns="1" rowHeights="584,792" gap="12" margin="0">
      <SubGrid id="sec_place" row="0" col="0" rows="6" columns="1" rowHeights="48,96,96,96,96,96" gap="8" margin="8" style="group">
        <Cell id="h_place" row="0" col="0" label="Place" role="label" textStyle="section" style="plain"/>
        <SubGrid id="row_test" row="1" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="test_label" row="0" col="0" label="Try" caption="Dwell Move to… to place the cursor." role="label" style="plain"/>
          <Cell id="test_move" row="0" col="1" icon="mouseMove" label="Move to…" activeState="mouseMoveToGaze" style="button" command="mouseMoveToGaze"/>
        </SubGrid>
        <SubGrid id="row_pd" row="2" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="pd_label" row="0" col="0" label="Pointer dwell" caption="Dwell to place the cursor." role="label" style="plain"/>
          <SubGrid id="act_pd" row="0" col="1" rows="1" columns="9" gap="0" style="row">
            <Cell id="pd_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.mouseMoveDwellMs.dec"/>
            <Cell id="pd_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="mouseMoveDwellMs" style="join"/>
            <Cell id="pd_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.mouseMoveDwellMs.inc"/>
            <Cell id="pd_edit" row="0" col="7" colSpan="2" icon="editSquare" label="Edit…" style="joinRight" command="settings.edit.mouseMoveDwellMs"/>
          </SubGrid>
        </SubGrid>
        <SubGrid id="row_pg" row="3" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="pg_label" row="0" col="0" label="Pointer grace" caption="Time before an unfinished Move-to is canceled. 0 = off." role="label" style="plain"/>
          <SubGrid id="act_pg" row="0" col="1" rows="1" columns="9" gap="0" style="row">
            <Cell id="pg_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.mouseMoveSelectTimeoutMs.dec"/>
            <Cell id="pg_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="mouseMoveSelectTimeoutMs" style="join"/>
            <Cell id="pg_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.mouseMoveSelectTimeoutMs.inc"/>
            <Cell id="pg_edit" row="0" col="7" colSpan="2" icon="editSquare" label="Edit…" style="joinRight" command="settings.edit.mouseMoveSelectTimeoutMs"/>
          </SubGrid>
        </SubGrid>
        <SubGrid id="row_pp" row="4" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="pp_label" row="0" col="0" label="Pointer progress" caption="What you see while placing the cursor." role="label" style="plain"/>
          <SubGrid id="act_pp" row="0" col="1" rows="1" columns="3" gap="0" style="row">
            <Cell id="pp_r" row="0" col="0" label="Ring" role="toggle" activeState="settings.mouseProgress.radial.toggle" style="joinLeft" command="settings.mouseProgress.radial.toggle"/>
            <Cell id="pp_pie" row="0" col="1" label="Pie" role="toggle" activeState="settings.mouseProgress.pie.toggle" style="join" command="settings.mouseProgress.pie.toggle"/>
            <Cell id="pp_f" row="0" col="2" label="Fill" role="toggle" activeState="settings.mouseProgress.fill.toggle" style="joinRight" command="settings.mouseProgress.fill.toggle"/>
          </SubGrid>
        </SubGrid>
        <SubGrid id="row_pi" row="5" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="pi_label" row="0" col="0" label="Final pick" caption="Markers while choosing the zoom region and at the click point." role="label" style="plain"/>
          <SubGrid id="act_pi" row="0" col="1" rows="1" columns="3" gap="0" style="row">
            <Cell id="pi_cur" row="0" col="0" label="Cursor" role="toggle" activeState="settings.mousePickStyle.cursor.toggle" style="joinLeft" command="settings.mousePickStyle.cursor.toggle"/>
            <Cell id="pi_dot" row="0" col="1" label="Dot" role="toggle" activeState="settings.mousePickStyle.dot.toggle" style="join" command="settings.mousePickStyle.dot.toggle"/>
            <Cell id="pi_xh" row="0" col="2" label="Crosshair" role="toggle" activeState="settings.mousePickStyle.crosshair.toggle" style="joinRight" command="settings.mousePickStyle.crosshair.toggle"/>
          </SubGrid>
        </SubGrid>
      </SubGrid>
      <SubGrid id="sec_magnify" row="1" col="0" rows="8" columns="1" rowHeights="48,96,96,96,96,96,96,96" gap="8" margin="8" style="group">
        <Cell id="h_magnify" row="0" col="0" label="Magnify" role="label" textStyle="section" style="plain"/>
        <SubGrid id="row_mode" row="1" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="zm_pre_l" row="0" col="0" label="Magnify pick" caption="Open a static zoom, then place the click." role="label" style="plain"/>
          <Cell id="zm_pre" row="0" col="1" icon="ZoomConfirm" label="On" role="toggle" activeState="mouseMoveMagPick" style="button" command="toggleMouseMoveMagPick"/>
        </SubGrid>
        <SubGrid id="row_zd" row="2" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="zd_label" row="0" col="0" label="Zoom dwell" caption="Dwell to choose the zoom region." role="label" style="plain"/>
          <SubGrid id="act_zd" row="0" col="1" rows="1" columns="9" gap="0" style="row">
            <Cell id="zd_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.magPickDwellMs.dec"/>
            <Cell id="zd_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="magPickDwellMs" style="join"/>
            <Cell id="zd_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.magPickDwellMs.inc"/>
            <Cell id="zd_edit" row="0" col="7" colSpan="2" icon="editSquare" label="Edit…" style="joinRight" command="settings.edit.magPickDwellMs"/>
          </SubGrid>
        </SubGrid>
        <SubGrid id="row_zl" row="3" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="zl_label" row="0" col="0" label="Zoom level" caption="Static magnification." role="label" style="plain"/>
          <SubGrid id="act_zl" row="0" col="1" rows="1" columns="9" gap="0" style="row">
            <Cell id="zl_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.pickZoom.dec"/>
            <Cell id="zl_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="pickZoom" style="join"/>
            <Cell id="zl_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.pickZoom.inc"/>
            <Cell id="zl_edit" row="0" col="7" colSpan="2" icon="editSquare" label="Edit…" style="joinRight" command="settings.edit.pickZoom"/>
          </SubGrid>
        </SubGrid>
        <SubGrid id="row_zs" row="4" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="zs_label" row="0" col="0" label="Zoom size" caption="Side length of the zoom window." role="label" style="plain"/>
          <SubGrid id="act_zs" row="0" col="1" rows="1" columns="9" gap="0" style="row">
            <Cell id="zs_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.pickWindowPx.dec"/>
            <Cell id="zs_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="pickWindowPx" style="join"/>
            <Cell id="zs_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.pickWindowPx.inc"/>
            <Cell id="zs_edit" row="0" col="7" colSpan="2" icon="editSquare" label="Edit…" style="joinRight" command="settings.edit.pickWindowPx"/>
          </SubGrid>
        </SubGrid>
        <SubGrid id="row_full" row="5" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="zs_full_l" row="0" col="0" label="Fill screen" caption="Use the short side of the screen." role="label" style="plain"/>
          <Cell id="zs_full" row="0" col="1" icon="FillScreen" label="On" role="toggle" activeState="mouseMoveMagPickFullScreen" style="button" command="toggleMouseMoveMagPickFullScreen"/>
        </SubGrid>
        <SubGrid id="row_shape" row="6" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="zs_shape_l" row="0" col="0" label="Shape" caption="Circle or square zoom window." role="label" style="plain"/>
          <SubGrid id="act_shape" row="0" col="1" rows="1" columns="2" gap="0" style="row">
            <Cell id="zs_round" row="0" col="0" label="Round" role="choice" activeState="settings.pickWindow.round" style="joinLeft" command="settings.pickWindow.round"/>
            <Cell id="zs_sq" row="0" col="1" label="Square" role="choice" activeState="settings.pickWindow.square" style="joinRight" command="settings.pickWindow.square"/>
          </SubGrid>
        </SubGrid>
        <SubGrid id="row_pos" row="7" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="zs_pos_l" row="0" col="0" label="Position" caption="Center on the gaze point or the screen." role="label" style="plain"/>
          <SubGrid id="act_pos" row="0" col="1" rows="1" columns="2" gap="0" style="row">
            <Cell id="z_gaze" row="0" col="0" icon="MagnifyAtPoint" label="Gaze point" role="choice" activeState="settings.pickCenter.gaze" style="joinLeft" command="settings.pickCenter.gaze"/>
            <Cell id="z_center" row="0" col="1" icon="MagnifyAtCenter" label="Screen center" role="choice" activeState="settings.pickCenter.screen" style="joinRight" command="settings.pickCenter.screen"/>
          </SubGrid>
        </SubGrid>
      </SubGrid>
    </SubGrid>
    <SubGrid id="page_scroll" row="1" col="1" rows="3" columns="1" rowHeights="72,*,72" gap="6" margin="0" style="group">
      <Cell id="set_scroll_up" row="0" col="0" icon="ArrowUp" role="scrollUp" style="button" command="settings.scroll.up"/>
      <Cell id="set_scroll_track" row="1" col="0" role="scrollbar" caption="0,1,1" scanGrace="400"/>
      <Cell id="set_scroll_down" row="2" col="0" icon="ArrowDown" role="scrollDown" style="button" command="settings.scroll.down"/>
    </SubGrid>
  </Grid>
</Page>
