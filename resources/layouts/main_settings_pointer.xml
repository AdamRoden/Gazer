<?xml version="1.0" encoding="UTF-8"?>
<Page id="main_settings_pointer" name="Pointer" radius="16">
  <Style id="row" background="transparent" thickness="0" radius="0"/>
  <Style id="join" background="transparent" thickness="0" radius="0"/>
  <Style id="plain" background="transparent" thickness="0" radius="0"/>
  <Style id="button" background="transparent" thickness="0" radius="10"/>
  <Style id="joinLeft" background="transparent" thickness="0" radius="10,0,0,10"/>
  <Style id="group" background="bg95" thickness="0" radius="16"/>
  <Style id="joinRight" background="transparent" thickness="0" radius="0,10,10,0"/>
  <Grid id="board" rows="2" columns="2" desktopMode="true" anchor="Top" offset="0,0" size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth),A_ScreenHeight" gap="12" rowHeights="96,*" columnWidths="*,72" radius="16">
    <Row id="titlebar" columns="2" span="2" gap="8" columnWidths="*,160" style="plain">
      <Label id="page_title" style="plain" label="Pointer" caption="Click placement and the zoom window." textStyle="title"/>
      <Button id="tab_done" style="button" label="Close" icon="keyboardHide" textStyle="row" closeAllPages="true"/>
    </Row>
    <Column id="scroller" rows="2" row="1" gap="12" rowHeights="584,792" scroll="true">
      <Card id="sec_place" rows="6" gap="8" padding="8" rowHeights="48,96,96,96,96,96" style="group">
        <Label id="h_place" style="plain" label="Place" textStyle="section"/>
        <Row id="row_test" columns="2" gap="6" style="row">
          <Label id="test_label" style="plain" label="Try" caption="Dwell Move to… to place the cursor."/>
          <Button id="test_move" style="button" label="Move to…" icon="mouseMove" bind="mouseMoveToGaze" command="mouseMoveToGaze"/>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Pointer dwell" caption="Dwell to place the cursor."/>
          <Row columns="9" style="row">
            <Button style="joinLeft" label="−" span="2" command="settings.nudge.mouseMoveDwellMs.dec"/>
            <Label id="pd_val" style="join" label="—" settingKey="mouseMoveDwellMs" role="value" span="3"/>
            <Button style="join" label="+" span="2" command="settings.nudge.mouseMoveDwellMs.inc"/>
            <Button style="joinRight" label="Edit…" icon="editSquare" span="2" command="settings.edit.mouseMoveDwellMs"/>
          </Row>
        </Row>
        <Row id="row_pg" columns="2" gap="6" style="row">
          <Label style="plain" label="Pointer grace" caption="Time before an unfinished Move-to is canceled. 0 = off."/>
          <Row columns="9" style="row">
            <Button style="joinLeft" label="−" span="2" command="settings.nudge.mouseMoveSelectTimeoutMs.dec"/>
            <Label id="pg_val" style="join" label="—" settingKey="mouseMoveSelectTimeoutMs" role="value" span="3"/>
            <Button style="join" label="+" span="2" command="settings.nudge.mouseMoveSelectTimeoutMs.inc"/>
            <Button style="joinRight" label="Edit…" icon="editSquare" span="2" command="settings.edit.mouseMoveSelectTimeoutMs"/>
          </Row>
        </Row>
        <Row id="row_pp" columns="2" gap="6" style="row">
          <Label id="pp_label" style="plain" label="Pointer progress" caption="What you see while placing the cursor."/>
          <Row id="act_pp" columns="3" style="row">
            <Switch id="pp_r" style="joinLeft" label="Ring" bind="settings.mouseProgress.radial.toggle" command="settings.mouseProgress.radial.toggle"/>
            <Switch style="join" label="Pie" bind="settings.mouseProgress.pie.toggle" command="settings.mouseProgress.pie.toggle"/>
            <Switch style="joinRight" label="Fill" bind="settings.mouseProgress.fill.toggle" command="settings.mouseProgress.fill.toggle"/>
          </Row>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Final pick" caption="Markers while choosing the zoom region and at the click point."/>
          <Row columns="3" style="row">
            <Switch id="pi_cur" style="joinLeft" label="Cursor" bind="settings.mousePickStyle.cursor.toggle" command="settings.mousePickStyle.cursor.toggle"/>
            <Switch id="pi_dot" style="join" label="Dot" bind="settings.mousePickStyle.dot.toggle" command="settings.mousePickStyle.dot.toggle"/>
            <Switch id="pi_xh" style="joinRight" label="Crosshair" bind="settings.mousePickStyle.crosshair.toggle" command="settings.mousePickStyle.crosshair.toggle"/>
          </Row>
        </Row>
      </Card>
      <Card id="sec_magnify" rows="8" gap="8" padding="8" rowHeights="48,96,96,96,96,96,96,96" style="group">
        <Label id="h_magnify" style="plain" label="Magnify" textStyle="section"/>
        <Row id="row_mode" columns="2" gap="6" style="row">
          <Label style="plain" label="Magnify pick" caption="Open a static zoom, then place the click."/>
          <Switch id="zm_pre" style="button" label="On" icon="ZoomConfirm" bind="mouseMoveMagPick" command="toggleMouseMoveMagPick"/>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Zoom dwell" caption="Dwell to choose the zoom region."/>
          <Row columns="9" style="row">
            <Button style="joinLeft" label="−" span="2" command="settings.nudge.magPickDwellMs.dec"/>
            <Label id="zd_val" style="join" label="—" settingKey="magPickDwellMs" role="value" span="3"/>
            <Button style="join" label="+" span="2" command="settings.nudge.magPickDwellMs.inc"/>
            <Button style="joinRight" label="Edit…" icon="editSquare" span="2" command="settings.edit.magPickDwellMs"/>
          </Row>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Zoom level" caption="Static magnification."/>
          <Row columns="9" style="row">
            <Button style="joinLeft" label="−" span="2" command="settings.nudge.pickZoom.dec"/>
            <Label id="zl_val" style="join" label="—" settingKey="pickZoom" role="value" span="3"/>
            <Button style="join" label="+" span="2" command="settings.nudge.pickZoom.inc"/>
            <Button style="joinRight" label="Edit…" icon="editSquare" span="2" command="settings.edit.pickZoom"/>
          </Row>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label id="zs_label" style="plain" label="Zoom size" caption="Side length of the zoom window."/>
          <Row id="act_zs" columns="9" style="row">
            <Button style="joinLeft" label="−" span="2" command="settings.nudge.pickWindowPx.dec"/>
            <Label id="zs_val" style="join" label="—" settingKey="pickWindowPx" role="value" span="3"/>
            <Button style="join" label="+" span="2" command="settings.nudge.pickWindowPx.inc"/>
            <Button id="zs_edit" style="joinRight" label="Edit…" icon="editSquare" span="2" command="settings.edit.pickWindowPx"/>
          </Row>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label id="zs_full_l" style="plain" label="Fill screen" caption="Use the short side of the screen."/>
          <Switch id="zs_full" style="button" label="On" icon="FillScreen" bind="mouseMoveMagPickFullScreen" command="toggleMouseMoveMagPickFullScreen"/>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Shape" caption="Circle or square zoom window."/>
          <Row columns="2" style="row">
            <Choice style="joinLeft" label="Round" bind="settings.pickWindow.round" command="settings.pickWindow.round"/>
            <Choice style="joinRight" label="Square" bind="settings.pickWindow.square" command="settings.pickWindow.square"/>
          </Row>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Position" caption="Center on the gaze point or the screen."/>
          <Row columns="2" style="row">
            <Choice style="joinLeft" label="Gaze point" icon="MagnifyAtPoint" bind="settings.pickCenter.gaze" command="settings.pickCenter.gaze"/>
            <Choice style="joinRight" label="Screen center" icon="MagnifyAtCenter" bind="settings.pickCenter.screen" command="settings.pickCenter.screen"/>
          </Row>
        </Row>
      </Card>
    </Column>
    <Card id="page_scroll" rows="3" row="1" col="1" gap="6" rowHeights="72,*,72" style="group">
      <Button id="set_scroll_up" style="button" icon="ArrowUp" role="scrollUp" command="settings.scroll.up"/>
      <Button caption="0,1,1" role="scrollbar" scanGrace="400"/>
      <Button id="set_scroll_down" style="button" icon="ArrowDown" role="scrollDown" command="settings.scroll.down"/>
    </Card>
  </Grid>
</Page>
