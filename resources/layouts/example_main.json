{
  "schemaVersion": 1,
  "id": "example_main",
  "name": "Main",
  "uiStyle": "fluent",
  "session": {
    "role": "masterShell",
    "masterGroup": "home",
    "isHome": true,
    "collapseLayoutId": "example_main_collapsed"
  },
  "window": {
    "anchor": "bottomCenter",
    "widthPx": 1080,
    "heightPx": 150,
    "marginPx": 0
  },
  "grid": {
    "columns": 8,
    "rows": 1,
    "gapPx": 10,
    "marginPx": 10
  },
  "items": [
    {
      "id": "open_keyboard",
      "label": "Keyboard",
      "row": 0,
      "col": 0,
      "style": { "background": "#771d3557", "foreground": "#ffffff" },
      "action": { "type": "openLayout", "layoutId": "example_keyboard" }
    },
    {
      "id": "open_mouse",
      "label": "Mouse",
      "row": 0,
      "col": 1,
      "style": { "background": "#772d6a4f", "foreground": "#ffffff" },
      "action": { "type": "openLayout", "layoutId": "example_mouse" }
    },
    {
      "id": "open_assist",
      "label": "Assist ★",
      "row": 0,
      "col": 2,
      "style": { "background": "#776a4c93", "foreground": "#ffffff" },
      "action": { "type": "openLayout", "layoutId": "example_assist" }
    },
    {
      "id": "open_settings",
      "label": "Settings ⚙",
      "row": 0,
      "col": 3,
      "style": { "background": "#774a5568", "foreground": "#ffffff" },
      "action": { "type": "openLayout", "layoutId": "example_settings" }
    },
    {
      "id": "close",
      "label": "Close",
      "row": 0,
      "col": 4,
      "style": { "background": "#443d4f66", "foreground": "#ffffff" },
      "action": { "type": "loadLayout", "layoutId": "example_main_collapsed" }
    },
    {
      "id": "close_all",
      "label": "Close All",
      "row": 0,
      "col": 5,
      "style": { "background": "#22495057", "foreground": "#ffffff" },
      "actions": [{ "type": "command", "name": "closeOtherViews" }, { "type": "loadLayout", "layoutId": "example_main_collapsed" }]
    },
    {
      "id": "dwell_suspend",
      "label": "Pause dwell",
      "row": 0,
      "col": 6,
      "activeState": "dwellSuspend",
      "style": { "background": "#995c4d7a", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "toggleDwellSuspend" }
    },
    {
      "id": "quit",
      "label": "Quit",
      "row": 0,
      "col": 7,
      "style": { "background": "#9b2226", "foreground": "#ffffff" },
      "action": { "type": "loadLayout", "layoutId": "example_quit_confirm" }
    }
  ]
}
