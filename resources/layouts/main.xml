<Page id="main" master="true" name="Dock" background="#aa000000" blur="15" radius="16" thickness="0">
  <Style id="chip" background="#99000000" blur="15" radius="900,900,0,0" progressStyle="border, fillup"/>
  <Style id="drawer" background="#aa000000"/>
  <Style id="quitPrompt" background="#ee000000" radius="12"/>
  <Style id="quitYes" background="#9b2226" foreground="#ffffff" radius="12"/>
  <Style id="quitNo" background="#2d6a4f" foreground="#ffffff" radius="12"/>

  <Zone id="mainChip" anchor="Bottom" offset="0,0" size="200,100"
        dwellOffset="0,300" dwellSize="300,200"
        style="chip" label="Main" icon="menu" suspendExempt="true" visibleWhen="!expanded" shell="true">
    <Command value="resumeDwell"/>
    <ShowLayers value="1,2"/>
  </Zone>
  <Zone id="sleep" anchor="Bottom" offset="400,0" size="200,100"
        dwellOffset="0,300" dwellSize="300,200"
        style="chip" label="Sleep" icon="Sleep"
        activeState="dwellSuspend" shell="true" command="toggleDwellSuspend"/>

  <Grid id="drawer" desktopMode="false" rows="1" columns="10"
        anchor="Bottom" offset="0,0" size="1320,150" style="drawer" gap="10" margin="10"
        layers="2" drawerMotion="true" autoClose="true" shell="true" >
    <Cell id="open_keyboard" row="0" col="0" label="Keyboard" icon="keyboardKeys" openPage="qwerty_main"/>
    <Cell id="open_compose" row="0" col="1" label="Speak" icon="Speak" command="compose.open"/>
    <Cell id="open_mouse" row="0" col="2" label="Mouse" icon="mouse" openPage="example_mouse"/>
    <Cell id="open_assist" row="0" col="3" label="Assist" icon="ideas" openPage="example_assist"/>
    <Cell id="open_right" row="0" col="4" label="More" icon="moreHoriz" openPage="uw_qwerty"/>
    <Cell id="open_settings" row="0" col="5" label="Settings" icon="settings" openPage="main_settings"/>
    <Cell id="close" row="0" col="6" label="Dismiss" icon="AlignBottom" showLayers="1"/>
    <Cell id="close_all" row="0" col="7" label="Close All" icon="CloseAll">
      <CloseAllPages/>
      <ShowLayers value="1,2"/>
    </Cell>
    <Cell id="dwell_suspend" row="0" col="8" label="Pause dwell" icon="Sleep" activeState="dwellSuspend" command="toggleDwellSuspend"/>
    <Cell id="quit" row="0" col="9" label="Quit" icon="powerOnOff">
      <ShowLayers value="1,3"/>
    </Cell>
  </Grid>

  <Grid id="quit" desktopMode="true" rows="2" columns="2"
        anchor="Center" offset="0,0" size="480,220" style="quitPrompt"
        gap="12" margin="16" layers="3" shell="true">
    <Cell id="prompt" row="0" col="0" colSpan="2" label="Quit Gazer?" role="label" background="#ee222222"/>
    <Cell id="yes_quit" row="1" col="0" label="Yes" icon="check" style="quitYes" command="quitApp"/>
    <Cell id="no_stay" row="1" col="1" label="No" icon="close" style="quitNo">
      <ShowLayers value="1,2"/>
    </Cell>
  </Grid>
</Page>
