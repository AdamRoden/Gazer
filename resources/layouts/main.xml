<Page id="main" master="true" name="Dock" background="#aa000000" blur="15" radius="16" thickness="0">
  <Style id="chip" background="#99000000" blur="15" radius="900,900,0,0" progressStyle="border, fillup"/>
  <Style id="drawer" background="#aa000000"/>
  <Style id="quitPrompt" background="#ee000000" radius="12"/>
  <Style id="quitYes" background="#9b2226" foreground="#ffffff" radius="12"/>
  <Style id="quitNo" background="#2d6a4f" foreground="#ffffff" radius="12"/>

  <Zone id="mainChip" anchor="Bottom" offset="0,0" size="200,100"
        dwellOffset="0,300" dwellSize="300,200"
        style="chip" label="Main" icon="Menu" suspendExempt="true" visibleWhen="!expanded" shell="true">
    <Command value="resumeDwell"/>
    <ShowGrid value="drawer"/>
  </Zone>
  <Zone id="sleep" anchor="Bottom" offset="400,0" size="200,100"
        dwellOffset="0,300" dwellSize="300,200"
        style="chip" label="Sleep" icon="Sleep"
        activeState="dwellSuspend" shell="true" command="toggleDwellSuspend"/>

  <Grid id="drawer" desktopMode="false" rows="1" columns="9"
        anchor="Bottom" offset="0,0" size="1200,150" style="drawer" gap="10" margin="10"
        show="false" drawerMotion="true" autoClose="true" shell="true" >
    <Cell id="open_keyboard" row="0" col="0" label="Keyboard" icon="Keyboard" openPage="qwerty_main"/>
    <Cell id="open_mouse" row="0" col="1" label="Mouse" icon="Mouse" openPage="example_mouse"/>
    <Cell id="open_assist" row="0" col="2" label="Assist" icon="IdeaIcon" openPage="example_assist"/>
    <Cell id="open_right" row="0" col="3" label="More" icon="More" openPage="uw_qwerty"/>
    <Cell id="open_settings" row="0" col="4" label="Settings" icon="SettingsIcon" openPage="main_settings"/>
    <Cell id="close" row="0" col="5" label="Dismiss" icon="ArrowPointingToBottomBoundaryIcon" hideGrid="drawer"/>
    <Cell id="close_all" row="0" col="6" label="Close All" icon="CollapseIcon">
      <Command value="closeOtherViews"/>
      <HideGrid value="drawer"/>
    </Cell>
    <Cell id="dwell_suspend" row="0" col="7" label="Pause dwell" icon="Sleep" activeState="dwellSuspend" command="toggleDwellSuspend"/>
    <Cell id="quit" row="0" col="8" label="Quit" icon="Quit">
      <HideGrid value="drawer"/>
      <ShowGrid value="quit"/>
    </Cell>
  </Grid>

  <Grid id="quit" desktopMode="true" rows="2" columns="2"
        anchor="Center" offset="0,0" size="480,220" style="quitPrompt"
        gap="12" margin="16" show="false" shell="true">
    <Cell id="prompt" row="0" col="0" colSpan="2" label="Quit Gazer?" role="label" background="#ee222222"/>
    <Cell id="yes_quit" row="1" col="0" label="Yes" icon="Yes" style="quitYes" command="quitApp"/>
    <Cell id="no_stay" row="1" col="1" label="No" icon="No" style="quitNo">
      <HideGrid value="quit"/>
      <ShowGrid value="drawer"/>
    </Cell>
  </Grid>
</Page>
