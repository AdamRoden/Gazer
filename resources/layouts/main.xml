<?xml version="1.0" encoding="UTF-8"?>
<Page id="main" name="Dock" master="true" background="#aa000000" thickness="0" radius="16" blur="15">
  <Style id="quitYes" background="#9b2226" foreground="#ffffff" radius="12"/>
  <Style id="quitPrompt" background="#ee000000" radius="12"/>
  <Style id="drawer" background="#aa000000"/>
  <Style id="quitNo" background="#2d6a4f" foreground="#ffffff" radius="12"/>
  <Style id="chip" background="#99000000" radius="900,900,0,0" blur="15" progressStyle="fillup"/>
  <Zone id="show" style="chip" label="Main" icon="menu" suspendExempt="true" shell="true" anchor="Bottom" offset="0,0" size="200,100" dwellOffset="0,300" dwellSize="300,200">
    <Command value="resumeDwell"/>
    <ShowLayers value="2"/>
  </Zone>
  <Zone id="hide" style="chip" label="Hide" icon="AlignBottom" suspendExempt="true" shell="true" layers="2,4" anchor="Bottom" offset="0,0" size="200,100" dwellOffset="0,300" dwellSize="300,200" showLayers="1"/>
  <Zone id="sleep" style="chip" label="Sleep" icon="Sleep" bind="dwellSuspend" suspendExempt="true" shell="true" layers="1,2,4" anchor="Bottom" offset="400,0" size="200,100" dwellOffset="0,300" dwellSize="300,200" command="toggleDwellSuspend"/>
  <Zone id="rescue" style="chip" label="Rescue" icon="restart" suspendExempt="true" shell="true" activation="600" layers="1,2,4" anchor="BottomLeft" offset="0,0" size="200,100" dwellOffset="0,300" dwellSize="300,200" command="rescue.reset"/>
  <Row id="drawer" columns="5" anchor="Bottom" offset="0,0" size="725,150" gap="10" padding="10" drawerMotion="true" autoClose="true" layers="2" shell="true" style="drawer">
    <Button id="open_more" label="More" icon="moreHoriz" showLayers="4"/>
    <Button label="Settings" icon="settings" openPage="main_settings_host"/>
    <Button label="Close All" icon="CloseAll" closeAllPages="true"/>
    <Button id="dwell_suspend" label="Pause dwell" icon="Sleep" bind="dwellSuspend" suspendExempt="true" command="toggleDwellSuspend"/>
    <Button label="Quit" icon="powerOnOff" showLayers="1,3"/>
  </Row>
  <Row id="more" columns="8" anchor="Bottom" offset="0,0" size="1154,150" gap="10" padding="10" drawerMotion="true" autoClose="true" layers="4" shell="true" style="drawer">
    <Button id="open_keyboard" label="Keyboard" icon="keyboardKeys" openPage="qwerty_main"/>
    <Button id="open_compose" label="Speak" icon="Speak" command="compose.open"/>
    <Button id="open_mouse" label="Mouse" icon="mouse" openPage="example_mouse"/>
    <Button id="open_gamepad" label="Gamepad" icon="sportsEsports" openPage="example_gamepad"/>
    <Button id="open_assist" label="Assist" icon="ideas" openPage="example_assist"/>
    <Button id="open_right" label="Edge" icon="windowMid" openPage="uw_qwerty"/>
    <Button id="open_pad" label="Numpad" icon="keyboardRight" openPage="uw_qwerty_pad"/>
    <Button id="more_back" label="Back" icon="Back" showLayers="2"/>
  </Row>
  <Grid id="quit" rows="2" columns="2" desktopMode="true" anchor="Center" offset="0,0" size="480,220" gap="12" padding="16" layers="3" shell="true" style="quitPrompt">
    <Label label="Quit Gazer?" background="#ee222222" span="2"/>
    <Button style="quitYes" label="Yes" icon="check" row="1" command="quitApp"/>
    <Button style="quitNo" label="No" icon="close" row="1" col="1" showLayers="2"/>
  </Grid>
</Page>
