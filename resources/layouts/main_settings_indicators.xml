<Page id="main_settings_indicators" name="Indicators" radius="16">
  <Style id="group" background="bg95" thickness="0" radius="16"/>
  <Style id="row" background="transparent" thickness="0" radius="0"/>
  <Style id="plain" background="transparent" thickness="0" radius="0"/>
  <Style id="join" background="transparent" thickness="0" radius="0"/>
  <Style id="joinLeft" background="transparent" thickness="0" radius="10,0,0,10"/>
  <Style id="joinRight" background="transparent" thickness="0" radius="0,10,10,0"/>
  <Style id="tabbar" background="bg95" thickness="0" radius="12"/>
  <Grid id="board" desktopMode="true" rows="10" columns="16" anchor="Top" offset="0,0" size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth), A_ScreenHeight" gap="6" margin="12" radius="16">
    <SubGrid id="tabs" row="0" col="0" colSpan="16" rows="1" columns="9" gap="6" margin="4" style="tabbar">
      <Cell id="tab_speed" row="0" col="0" label="Speed" icon="timer" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_speed"/>
      </Cell>
      <Cell id="tab_magnify" row="0" col="1" label="Magnify" icon="ZoomSettings" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_magnify"/>
      </Cell>
      <Cell id="tab_indicators" row="0" col="2" label="Indicators" icon="cycle" role="tab"/>
      <Cell id="tab_assist" row="0" col="3" label="Assist" icon="ideas" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_assist"/>
      </Cell>
      <Cell id="tab_tools" row="0" col="4" label="Tools" icon="lookToScroll" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_tools"/>
      </Cell>
      <Cell id="tab_theme" row="0" col="5" label="Theme" icon="palette" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_theme"/>
      </Cell>
      <Cell id="tab_speech" row="0" col="6" label="Speech" icon="Speak" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_speech"/>
      </Cell>
      <Cell id="tab_head" row="0" col="7" label="Head" icon="HeadPreview" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_head_pose"/>
      </Cell>
      <Cell id="tab_done" row="0" col="8" label="Done" icon="keyboardHide">
        <CloseAllPages/>
      </Cell>
    </SubGrid>

    <Cell id="page_title" row="1" col="0" colSpan="16" label="Indicators" caption="Progress chrome and pick markers" role="label" textStyle="title" style="plain"/>

    <SubGrid id="sec_prog" row="2" col="0" colSpan="16" rowSpan="3" rows="3" columns="1" rowWeights="1,2,2" gap="6" margin="6" style="group">
      <Cell id="h_prog" row="0" col="0" label="Progress" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_bp" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="bp_label" row="0" col="0" label="Button progress" caption="Dwell styles on board cells." role="label" style="plain"/>
        <SubGrid id="act_bp" row="0" col="1" rows="1" columns="3" gap="0" style="row">
          <Cell id="bp_r" row="0" col="0" label="Ring" role="toggle" activeState="settings.progress.radial.toggle" style="joinLeft" command="settings.progress.radial.toggle"/>
          <Cell id="bp_pie" row="0" col="1" label="Pie" role="toggle" activeState="settings.progress.pie.toggle" style="join" command="settings.progress.pie.toggle"/>
          <Cell id="bp_f" row="0" col="2" label="Fill" role="toggle" activeState="settings.progress.fill.toggle" style="joinRight" command="settings.progress.fill.toggle"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_pp" row="2" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="pp_label" row="0" col="0" label="Pointer progress" caption="Dwell styles for pointer aim." role="label" style="plain"/>
        <SubGrid id="act_pp" row="0" col="1" rows="1" columns="3" gap="0" style="row">
          <Cell id="pp_r" row="0" col="0" label="Ring" role="toggle" activeState="settings.mouseProgress.radial.toggle" style="joinLeft" command="settings.mouseProgress.radial.toggle"/>
          <Cell id="pp_pie" row="0" col="1" label="Pie" role="toggle" activeState="settings.mouseProgress.pie.toggle" style="join" command="settings.mouseProgress.pie.toggle"/>
          <Cell id="pp_f" row="0" col="2" label="Fill" role="toggle" activeState="settings.mouseProgress.fill.toggle" style="joinRight" command="settings.mouseProgress.fill.toggle"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_icons" row="5" col="0" colSpan="16" rowSpan="3" rows="3" columns="1" rowWeights="1,2,2" gap="6" margin="6" style="group">
      <Cell id="h_icons" row="0" col="0" label="Indicators" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_zi" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="zi_label" row="0" col="0" label="Magnify pick" caption="Markers for the zoom region." role="label" style="plain"/>
        <SubGrid id="act_zi" row="0" col="1" rows="1" columns="4" gap="0" style="row">
          <Cell id="zi_cur" row="0" col="0" label="Cursor" role="toggle" activeState="settings.magPickStyle.cursor.toggle" style="joinLeft" command="settings.magPickStyle.cursor.toggle"/>
          <Cell id="zi_dot" row="0" col="1" label="Dot" role="toggle" activeState="settings.magPickStyle.dot.toggle" style="join" command="settings.magPickStyle.dot.toggle"/>
          <Cell id="zi_xh" row="0" col="2" label="Crosshair" role="toggle" activeState="settings.magPickStyle.crosshair.toggle" style="join" command="settings.magPickStyle.crosshair.toggle"/>
          <Cell id="zi_gz" row="0" col="3" label="Gaze" role="toggle" activeState="settings.magPickStyle.gaze.toggle" style="joinRight" command="settings.magPickStyle.gaze.toggle"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_pi" row="2" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="pi_label" row="0" col="0" label="Final pick" caption="Markers at the click point." role="label" style="plain"/>
        <SubGrid id="act_pi" row="0" col="1" rows="1" columns="3" gap="0" style="row">
          <Cell id="pi_cur" row="0" col="0" label="Cursor" role="toggle" activeState="settings.mousePickStyle.cursor.toggle" style="joinLeft" command="settings.mousePickStyle.cursor.toggle"/>
          <Cell id="pi_dot" row="0" col="1" label="Dot" role="toggle" activeState="settings.mousePickStyle.dot.toggle" style="join" command="settings.mousePickStyle.dot.toggle"/>
          <Cell id="pi_xh" row="0" col="2" label="Crosshair" role="toggle" activeState="settings.mousePickStyle.crosshair.toggle" style="joinRight" command="settings.mousePickStyle.crosshair.toggle"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_preview" row="8" col="0" colSpan="16" rowSpan="2" rows="2" columns="1" rowWeights="1,2" gap="6" margin="6" style="group">
      <Cell id="h_preview" row="0" col="0" label="Preview" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_test" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="test_label" row="0" col="0" label="Test" caption="Dwell Move to… to try pick markers." role="label" style="plain"/>
        <Cell id="test_move" row="0" col="1" icon="mouseMove" label="Move to…" activeState="mouseMoveToGaze" command="mouseMoveToGaze"/>
      </SubGrid>
    </SubGrid>
  </Grid>
</Page>
