<Page id="main_settings_tools" name="Tools" radius="16">
  <Style id="group" background="bg95" thickness="0" radius="16"/>
  <Style id="row" background="transparent" thickness="0" radius="0"/>
  <Style id="plain" background="transparent" thickness="0" radius="0"/>
  <Style id="join" background="transparent" thickness="0" radius="0"/>
  <Style id="joinLeft" background="transparent" thickness="0" radius="10,0,0,10"/>
  <Style id="joinRight" background="transparent" thickness="0" radius="0,10,10,0"/>
  <Grid id="board" desktopMode="true" rows="9" columns="16" anchor="Top" offset="0,0" size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth), A_ScreenHeight" gap="6" margin="12" radius="16">
    <Cell id="page_title" row="0" col="0" colSpan="16" label="Tools" caption="Look-to maps and ComboMouse" role="label" textStyle="title" style="plain"/>
    <SubGrid id="tool_columns" row="1" col="0" rowSpan="7" colSpan="16" rows="1" columns="2" gap="16">

      <SubGrid id="sec_look" row="0" col="0" rows="6" columns="1" rowHeights="*,2*,2*,2*,2*,2*" gap="6" margin="6" style="group">
        <Cell id="h_look" row="0" col="0" label="Look-to maps" role="label" textStyle="section" style="plain"/>

        <SubGrid id="row_scroll" row="1" col="0" rows="1" columns="3" gap="6" style="row">
          <Cell id="scroll_l" row="0" col="0" label="Scroll" caption="Wheel from gaze vs the origin." icon="lookToScroll" role="label" style="plain"/>
          <Cell id="lts_on" row="0" col="1" label="Enable" icon="lookToScroll" role="toggle" activeState="lookToScroll" style="joinLeft" command="lookToScroll"/>
          <Cell id="scroll_edit" row="0" col="2" icon="editSquare" label="Edit" style="joinRight" command="lookTo.edit.scroll"/>
        </SubGrid>
        <SubGrid id="row_mouse" row="2" col="0" rows="1" columns="3" gap="6" style="row">
          <Cell id="mouse_l" row="0" col="0" label="Mouse" caption="Move the pointer from gaze vs the origin." icon="mouseMove" role="label" style="plain"/>
          <Cell id="mouse_on" row="0" col="1" label="Enable" icon="mouseMove" role="toggle" activeState="lookToMouse" style="joinLeft" command="lookToMouse"/>
          <Cell id="mouse_edit" row="0" col="2" icon="editSquare" label="Edit" style="joinRight" command="lookTo.edit.mouse"/>
        </SubGrid>
        <SubGrid id="row_lstick" row="3" col="0" rows="1" columns="3" gap="6" style="row">
          <Cell id="lstick_l" row="0" col="0" label="Left stick" caption="Left analog stick from gaze vs the origin." icon="sportsEsports" role="label" style="plain"/>
          <Cell id="lstick_on" row="0" col="1" label="Enable" icon="sportsEsports" role="toggle" activeState="lookToLeftStick" style="joinLeft" command="lookToLeftStick"/>
          <Cell id="lstick_edit" row="0" col="2" icon="editSquare" label="Edit" style="joinRight" command="lookTo.edit.leftStick"/>
        </SubGrid>
        <SubGrid id="row_rstick" row="4" col="0" rows="1" columns="3" gap="6" style="row">
          <Cell id="rstick_l" row="0" col="0" label="Right stick" caption="Right analog stick from gaze vs the origin." icon="sportsEsports" role="label" style="plain"/>
          <Cell id="rstick_on" row="0" col="1" label="Enable" icon="sportsEsports" role="toggle" activeState="lookToRightStick" style="joinLeft" command="lookToRightStick"/>
          <Cell id="rstick_edit" row="0" col="2" icon="editSquare" label="Edit" style="joinRight" command="lookTo.edit.rightStick"/>
        </SubGrid>
        <Cell id="look_hint" row="5" col="0" label="Each map has its own origin and rings. All four can run at once." role="label" style="plain"/>
      </SubGrid>

      <SubGrid id="sec_combo" row="0" col="1" rows="6" columns="1" rowHeights="*,2*,2*,2*,2*,2*" gap="6" margin="6" style="group">
        <Cell id="h_combo" row="0" col="0" label="ComboMouse" role="label" textStyle="section" style="plain"/>
        <SubGrid id="row_combo_on" row="1" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="combo_on_l" row="0" col="0" label="Enable" caption="Dwell to place, then drift and click from the pie." role="label" style="plain"/>
          <Cell id="combo_on" row="0" col="1" label="ComboMouse" icon="comboMouse" role="toggle" activeState="comboMouse" style="join" command="toggleComboMouse"/>
        </SubGrid>
        <SubGrid id="row_combo_inner" row="2" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="ci_l" row="0" col="0" label="Inner radius" caption="Inner edge of the drift ring." role="label" style="plain"/>
          <SubGrid id="act_ci" row="0" col="1" rows="1" columns="9" gap="0" style="row">
            <Cell id="ci_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.comboInnerRadiusPx.dec"/>
            <Cell id="ci_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="comboInnerRadiusPx" style="join"/>
            <Cell id="ci_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.comboInnerRadiusPx.inc"/>
            <Cell id="ci_edit" row="0" col="7" colSpan="2" icon="editSquare" label="Edit…" style="joinRight" command="settings.edit.comboInnerRadiusPx"/>
          </SubGrid>
        </SubGrid>
        <SubGrid id="row_combo_shared" row="3" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="cs_l" row="0" col="0" label="Shared radius" caption="Where the drift ring meets the pie." role="label" style="plain"/>
          <SubGrid id="act_cs" row="0" col="1" rows="1" columns="9" gap="0" style="row">
            <Cell id="cs_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.comboSharedRadiusPx.dec"/>
            <Cell id="cs_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="comboSharedRadiusPx" style="join"/>
            <Cell id="cs_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.comboSharedRadiusPx.inc"/>
            <Cell id="cs_edit" row="0" col="7" colSpan="2" icon="editSquare" label="Edit…" style="joinRight" command="settings.edit.comboSharedRadiusPx"/>
          </SubGrid>
        </SubGrid>
        <SubGrid id="row_combo_outer" row="4" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="co_l" row="0" col="0" label="Outer radius" caption="Outer edge of the command pie." role="label" style="plain"/>
          <SubGrid id="act_co" row="0" col="1" rows="1" columns="9" gap="0" style="row">
            <Cell id="co_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.comboOuterRadiusPx.dec"/>
            <Cell id="co_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="comboOuterRadiusPx" style="join"/>
            <Cell id="co_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.comboOuterRadiusPx.inc"/>
            <Cell id="co_edit" row="0" col="7" colSpan="2" icon="editSquare" label="Edit…" style="joinRight" command="settings.edit.comboOuterRadiusPx"/>
          </SubGrid>
        </SubGrid>
        <SubGrid id="row_combo_style" row="5" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="combo_style_l" row="0" col="0" label="Colors" caption="Drift ring and command slices." role="label" style="plain"/>
          <SubGrid id="row_combo_colors" row="0" col="1" rows="1" columns="2" gap="0" style="row">
            <Cell id="cic_sw" row="0" col="0" label="Inner ring" caption="Drift ring." settingKey="comboInnerColor" style="joinLeft" command="settings.edit.color.comboInnerColor"/>
            <Cell id="coc_sw" row="0" col="1" label="Outer ring" caption="Command slices." settingKey="comboOuterColor" style="joinRight" command="settings.edit.color.comboOuterColor"/>
          </SubGrid>
        </SubGrid>
      </SubGrid>
    </SubGrid>
  </Grid>
</Page>
