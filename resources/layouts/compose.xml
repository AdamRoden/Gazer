<?xml version="1.0" encoding="UTF-8"?>
<Page id="compose" name="Speak" radius="16">
  <Style id="round" thickness="2" radius="1000"/>
  <Style id="plain" background="transparent" thickness="0" radius="0"/>
  <Style id="group" background="bg95" thickness="0" radius="16"/>
  <Column id="board" rows="2" desktopMode="true" anchor="Top" offset="0,0" size="1.5*A_ScreenHeight,A_ScreenHeight" gap="8" padding="16" rowHeights="8*,4*" layers="1,2,3,4,5" radius="16">
    <Row columns="2" gap="8" columnWidths="200,*" layers="1,2,3,4,5">
      <Column rows="2" gap="8" rowHeights="*,80" layers="1,2,3,4,5">
        <Button id="rail_mode" label="Favorites" icon="star" row="1" command="compose.toggleRail"/>
        <Column id="rail" rows="8" gap="6" layers="1,2,3,4,5">
          <Label/>
        </Column>
      </Column>
      <Column id="stage" rows="3" gap="8" rowHeights="*,96,72" layers="1,2,3,4,5">
        <Grid id="soundboard" rows="7" columns="6" gap="8" padding="8" rowHeights="80,80,80,80,80,80,*" layers="1,2,3,4,5" style="group">
          <Label id="sb_placeholder"/>
        </Grid>
        <Card id="compose" padding="6" layers="1,2,3,4,5" style="group">
          <Row id="phrase" columns="3" gap="10" padding="1" columnWidths="*,80,80" layers="1,2,3,4,5" thickness="1">
            <Display id="phrase" textStyle="body" thickness="0"/>
            <Button id="clear" style="plain" icon="close" radius="1000" command="compose.clear"/>
            <Button id="speak" style="plain" icon="Speak" radius="1000" command="compose.speak"/>
          </Row>
        </Card>
        <Grid id="predict" gap="6" layers="1,2,3,4,5">
          <Label id="pred_0"/>
        </Grid>
      </Column>
    </Row>
    <Column id="keys" rows="3" row="1" gap="4" padding="4">
      <Row id="keys_row0" columns="13" gap="4" columnWidths="*,*,*,*,*,*,*,*,*,*,*,0.9*,1.1*">
        <Button id="edit" label="Edit" icon="edit" background="bg90"/>
        <Button label="q" textStyle="key" send="q"/>
        <Button label="w" textStyle="key" send="w"/>
        <Button label="e" textStyle="key" send="e"/>
        <Button label="r" textStyle="key" send="r"/>
        <Button label="t" textStyle="key" send="t"/>
        <Button label="y" textStyle="key" send="y"/>
        <Button label="u" textStyle="key" send="u"/>
        <Button label="i" textStyle="key" send="i"/>
        <Button label="o" textStyle="key" send="o"/>
        <Button label="p" textStyle="key" send="p"/>
        <Button id="minus" label="-" textStyle="key" send="-"/>
        <Button id="bksp" icon="keyBackspace" background="bg90" command="backspace"/>
      </Row>
      <Row id="keys_row1" columns="13" gap="4" columnWidths="1.4*,*,*,*,*,*,*,*,*,*,0.9*,0.9*,*">
        <Button id="shift" icon="KeyShift" background="bg90" showLayers="2"/>
        <Button label="a" textStyle="key" send="a"/>
        <Button label="s" textStyle="key" send="s"/>
        <Button label="d" textStyle="key" send="d"/>
        <Button label="f" textStyle="key" send="f"/>
        <Button label="g" textStyle="key" send="g"/>
        <Button label="h" textStyle="key" send="h"/>
        <Button label="j" textStyle="key" send="j"/>
        <Button label="k" textStyle="key" send="k"/>
        <Button label="l" textStyle="key" send="l"/>
        <Button id="semicolon" label=";" textStyle="key" send=";"/>
        <Button id="quote" label="'" textStyle="key" send="'"/>
        <Button id="bksp_word" icon="BackMany" background="bg90" command="compose.deleteWord"/>
      </Row>
      <Row id="keys_row2" columns="13" gap="4" columnWidths="*,*,0.9*,0.9*,0.9*,0.9*,1.4*,*,*,*,0.9*,0.9*,1.2*">
        <Button id="delivery" label="Actions" icon="graphicEq" background="bg90" showLayers="5"/>
        <Button id="sym" label="123?" icon="numbers" background="accent" showLayers="3"/>
        <Button label="z" textStyle="key" send="z"/>
        <Button label="x" textStyle="key" send="x"/>
        <Button label="c" textStyle="key" send="c"/>
        <Button label="v" textStyle="key" send="v"/>
        <Button id="space" icon="keySpace" background="bg90" command="space"/>
        <Button label="b" textStyle="key" send="b"/>
        <Button label="n" textStyle="key" send="n"/>
        <Button label="m" textStyle="key" send="m"/>
        <Button id="comma" label="," textStyle="key" send=","/>
        <Button id="period" label="." textStyle="key" send="."/>
        <Button id="enter" icon="keyReturn" background="accent" command="enter"/>
      </Row>
    </Column>
    <Column id="keys_shift" rows="3" row="1" gap="4" padding="4" layers="2">
      <Row id="keys_shift_row0" columns="13" gap="4" columnWidths="*,*,*,*,*,*,*,*,*,*,*,0.9*,1.1*" layers="2">
        <Button id="edit_s" label="Edit" icon="edit" background="bg90"/>
        <Button label="Q" textStyle="key" send="Q"/>
        <Button label="W" textStyle="key" send="W"/>
        <Button label="E" textStyle="key" send="E"/>
        <Button label="R" textStyle="key" send="R"/>
        <Button label="T" textStyle="key" send="T"/>
        <Button label="Y" textStyle="key" send="Y"/>
        <Button label="U" textStyle="key" send="U"/>
        <Button label="I" textStyle="key" send="I"/>
        <Button label="O" textStyle="key" send="O"/>
        <Button label="P" textStyle="key" send="P"/>
        <Button label="_" textStyle="key" send="_"/>
        <Button icon="keyBackspace" background="bg90" command="backspace"/>
      </Row>
      <Row id="keys_shift_row1" columns="13" gap="4" columnWidths="1.4*,*,*,*,*,*,*,*,*,*,0.9*,0.9*,*" layers="2">
        <Button icon="KeyShift" background="accent80" showLayers="1"/>
        <Button label="A" textStyle="key" send="A"/>
        <Button label="S" textStyle="key" send="S"/>
        <Button label="D" textStyle="key" send="D"/>
        <Button label="F" textStyle="key" send="F"/>
        <Button label="G" textStyle="key" send="G"/>
        <Button label="H" textStyle="key" send="H"/>
        <Button label="J" textStyle="key" send="J"/>
        <Button label="K" textStyle="key" send="K"/>
        <Button label="L" textStyle="key" send="L"/>
        <Button label=":" textStyle="key" send=":"/>
        <Button label="&quot;" textStyle="key" send="&quot;"/>
        <Button icon="BackMany" background="bg90" command="compose.deleteWord"/>
      </Row>
      <Row id="keys_shift_row2" columns="13" gap="4" columnWidths="*,*,0.9*,0.9*,0.9*,0.9*,1.4*,*,*,*,0.9*,0.9*,1.2*" layers="2">
        <Button id="delivery_s" label="Actions" icon="graphicEq" background="bg90" showLayers="5"/>
        <Button label="123?" icon="numbers" background="accent" showLayers="4"/>
        <Button label="Z" textStyle="key" send="Z"/>
        <Button label="X" textStyle="key" send="X"/>
        <Button label="C" textStyle="key" send="C"/>
        <Button label="V" textStyle="key" send="V"/>
        <Button icon="keySpace" background="bg90" command="space"/>
        <Button label="B" textStyle="key" send="B"/>
        <Button label="N" textStyle="key" send="N"/>
        <Button label="M" textStyle="key" send="M"/>
        <Button label="?" textStyle="key" send="?"/>
        <Button label="!" textStyle="key" send="!"/>
        <Button icon="keyReturn" background="accent" command="enter"/>
      </Row>
    </Column>
    <Column id="keys_sym" rows="3" row="1" gap="4" padding="4" layers="3">
      <Row id="keys_sym_row0" columns="13" gap="4" columnWidths="*,*,*,*,*,*,*,*,*,*,*,0.9*,1.1*" layers="3">
        <Button id="edit_sym" label="Edit" icon="edit" background="bg90"/>
        <Button label="1" textStyle="key" send="1"/>
        <Button label="2" textStyle="key" send="2"/>
        <Button label="3" textStyle="key" send="3"/>
        <Button label="4" textStyle="key" send="4"/>
        <Button label="5" textStyle="key" send="5"/>
        <Button label="6" textStyle="key" send="6"/>
        <Button label="7" textStyle="key" send="7"/>
        <Button label="8" textStyle="key" send="8"/>
        <Button label="9" textStyle="key" send="9"/>
        <Button label="0" textStyle="key" send="0"/>
        <Button label="-" textStyle="key" send="-"/>
        <Button icon="keyBackspace" background="bg90" command="backspace"/>
      </Row>
      <Row id="keys_sym_row1" columns="13" gap="4" columnWidths="1.4*,*,*,*,*,*,*,*,*,*,0.9*,0.9*,*" layers="3">
        <Button icon="KeyShift" background="bg90" showLayers="4"/>
        <Button label="@" textStyle="key" send="@"/>
        <Button label="#" textStyle="key" send="#"/>
        <Button label="$" textStyle="key" send="$"/>
        <Button label="%" textStyle="key" send="%"/>
        <Button label="^" textStyle="key" send="^"/>
        <Button label="&amp;" textStyle="key" send="&amp;"/>
        <Button label="*" textStyle="key" send="*"/>
        <Button label="(" textStyle="key" send="("/>
        <Button label=")" textStyle="key" send=")"/>
        <Button label=";" textStyle="key" send=";"/>
        <Button label="'" textStyle="key" send="'"/>
        <Button icon="BackMany" background="bg90" command="compose.deleteWord"/>
      </Row>
      <Row id="keys_sym_row2" columns="13" gap="4" columnWidths="*,*,0.9*,0.9*,0.9*,0.9*,1.4*,*,*,*,0.9*,0.9*,1.2*" layers="3">
        <Button id="delivery_sym" label="Actions" icon="graphicEq" background="bg90" showLayers="5"/>
        <Button label="ABC" icon="keyboardKeys" background="accent" showLayers="1"/>
        <Button label="{" textStyle="key" send="{"/>
        <Button label="}" textStyle="key" send="}"/>
        <Button label="[" textStyle="key" send="["/>
        <Button label="]" textStyle="key" send="]"/>
        <Button icon="keySpace" background="bg90" command="space"/>
        <Button label="=" textStyle="key" send="="/>
        <Button label="+" textStyle="key" send="+"/>
        <Button label="/" textStyle="key" send="/"/>
        <Button label="," textStyle="key" send=","/>
        <Button label="." textStyle="key" send="."/>
        <Button icon="keyReturn" background="accent" command="enter"/>
      </Row>
    </Column>
    <Column id="keys_sym_shift" rows="3" row="1" gap="4" padding="4" layers="4">
      <Row id="keys_sym_shift_row0" columns="13" gap="4" columnWidths="*,*,*,*,*,*,*,*,*,*,*,0.9*,1.1*" layers="4">
        <Button id="edit_ss" label="Edit" icon="edit" background="bg90"/>
        <Button label="!" textStyle="key" send="!"/>
        <Button label="@" textStyle="key" send="@"/>
        <Button label="#" textStyle="key" send="#"/>
        <Button label="$" textStyle="key" send="$"/>
        <Button label="%" textStyle="key" send="%"/>
        <Button label="^" textStyle="key" send="^"/>
        <Button label="&amp;" textStyle="key" send="&amp;"/>
        <Button label="*" textStyle="key" send="*"/>
        <Button label="(" textStyle="key" send="("/>
        <Button label=")" textStyle="key" send=")"/>
        <Button label="_" textStyle="key" send="_"/>
        <Button icon="keyBackspace" background="bg90" command="backspace"/>
      </Row>
      <Row id="keys_sym_shift_row1" columns="13" gap="4" columnWidths="1.4*,*,*,*,*,*,*,*,*,*,0.9*,0.9*,*" layers="4">
        <Button icon="KeyShift" background="accent80" showLayers="3"/>
        <Button label="`" textStyle="key" send="`"/>
        <Button label="~" textStyle="key" send="~"/>
        <Button label="£" textStyle="key" send="£"/>
        <Button label="€" textStyle="key" send="€"/>
        <Button label="·" textStyle="key" send="·"/>
        <Button label="—" textStyle="key" send="—"/>
        <Button label="°" textStyle="key" send="°"/>
        <Button label="|" textStyle="key" send="|"/>
        <Button label="\" textStyle="key" send="\"/>
        <Button label=":" textStyle="key" send=":"/>
        <Button label="&quot;" textStyle="key" send="&quot;"/>
        <Button icon="BackMany" background="bg90" command="compose.deleteWord"/>
      </Row>
      <Row id="keys_sym_shift_row2" columns="13" gap="4" columnWidths="*,*,0.9*,0.9*,0.9*,0.9*,1.4*,*,*,*,0.9*,0.9*,1.2*" layers="4">
        <Button id="delivery_ss" label="Actions" icon="graphicEq" background="bg90" showLayers="5"/>
        <Button label="ABC" icon="keyboardKeys" background="accent" showLayers="2"/>
        <Button label="¿" textStyle="key" send="¿"/>
        <Button label="¡" textStyle="key" send="¡"/>
        <Button label="&lt;" textStyle="key" send="&lt;"/>
        <Button label="&gt;" textStyle="key" send="&gt;"/>
        <Button icon="keySpace" background="bg90" command="space"/>
        <Button label="=" textStyle="key" send="="/>
        <Button label="+" textStyle="key" send="+"/>
        <Button label="/" textStyle="key" send="/"/>
        <Button label="?" textStyle="key" send="?"/>
        <Button label="!" textStyle="key" send="!"/>
        <Button icon="keyReturn" background="accent" command="enter"/>
      </Row>
    </Column>
    <Grid id="keys_cmd" rows="3" columns="7" row="1" gap="4" padding="4" layers="5">
      <Button id="cmd_undo" label="Undo" icon="undo" command="compose.undo"/>
      <Button id="cmd_redo" label="Redo" icon="redo" col="1" command="compose.redo"/>
      <Button id="cmd_select" label="Select all" icon="check" col="2" command="compose.selectAll"/>
      <Button id="cmd_deselect" label="Deselect" icon="close" col="3" command="compose.deselect"/>
      <Button id="cmd_cut" label="Cut" icon="contentCut" col="4" command="compose.cut"/>
      <Button id="cmd_copy" label="Copy" icon="contentCopy" col="5" command="compose.copy"/>
      <Button id="cmd_paste" label="Paste" icon="contentPaste" col="6" command="compose.paste"/>
      <Button id="cmd_pin" label="Edit" icon="edit" bind="compose.editMode" row="1" command="compose.pin"/>
      <Button id="cmd_tag" label="Tag" icon="sell" row="1" col="1" command="compose.openTags"/>
      <Button id="cmd_style" label="Style" icon="palette" bind="compose.styleOn" row="1" col="2" command="compose.openStyles"/>
      <Button id="cmd_voice" label="Voice" icon="recordVoiceOver" row="1" col="3" command="compose.openVoices"/>
      <Button id="cmd_history" label="History" icon="history" row="1" col="4" command="compose.openHistory"/>
      <Button id="cmd_import" label="Import" icon="folder" row="1" col="5" command="compose.importFile"/>
      <Button id="cmd_export" label="Export" icon="description" row="1" col="6" command="compose.exportFile"/>
      <Button id="cmd_keys" label="ABC" icon="keyboardKeys" background="accent" row="2" showLayers="1"/>
      <Button id="vol_down" icon="ArrowLeft" row="2" col="1" command="volume.dec"/>
      <Slider id="vol_track" label="50%" caption="volume" row="2" col="2" span="4"/>
      <Button id="vol_up" icon="ArrowRight" row="2" col="6" command="volume.inc"/>
    </Grid>
  </Column>
</Page>
