<Page id="main_settings_speed" name="Speed" radius="16">
  <Style id="group" thickness="0" radius="16"/>
  <Style id="row" background="#00000000" thickness="0" radius="0"/>
  <Style id="plain" background="#00000000" thickness="0" radius="0"/>
  <Style id="join" background="#00000000" thickness="0" radius="0"/>
  <Style id="joinLeft" background="#00000000" thickness="0" radius="10,0,0,10"/>
  <Style id="joinRight" background="#00000000" thickness="0" radius="0,10,10,0"/>
  <Style id="tabbar" thickness="0" radius="12"/>
  <Grid id="board" desktopMode="true" rows="11" columns="16" anchor="Top" offset="0,0" size="A_ScreenHeight/9*16, A_ScreenHeight" gap="6" margin="12" radius="16">
    <SubGrid id="tabs" row="0" col="0" colSpan="16" rows="1" columns="7" gap="6" margin="4" style="tabbar">
      <Cell id="tab_speed" row="0" col="0" label="Speed" icon="timer" role="tab"/>
      <Cell id="tab_magnify" row="0" col="1" label="Magnify" icon="ZoomSettings" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_magnify"/>
      </Cell>
      <Cell id="tab_indicators" row="0" col="2" label="Indicators" icon="cycle" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_indicators"/>
      </Cell>
      <Cell id="tab_assist" row="0" col="3" label="Assist" icon="ideas" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_assist"/>
      </Cell>
      <Cell id="tab_tools" row="0" col="4" label="Tools" icon="lookToScroll" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_tools"/>
      </Cell>
      <Cell id="tab_theme" row="0" col="5" label="Theme" icon="palette" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_theme"/>
      </Cell>
      <Cell id="tab_done" row="0" col="6" label="Done" icon="keyboardHide">
        <CloseAllPages/>
      </Cell>
    </SubGrid>

    <Cell id="page_title" row="1" col="0" colSpan="16" label="Speed" caption="How long to hold gaze on boards and the pointer" role="label" textStyle="title" style="plain"/>

    <SubGrid id="sec_presets" row="2" col="0" colSpan="16" rowSpan="3" rows="3" columns="1" rowWeights="1,2,2" gap="6" margin="6" style="group">
      <Cell id="h_presets" row="0" col="0" label="Presets" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_preset" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="p_label" row="0" col="0" label="Quick packages" caption="Slow, Normal, Fast, or Custom." role="label" style="plain"/>
        <SubGrid id="act_preset" row="0" col="1" rows="1" columns="4" gap="0" style="row">
          <Cell id="p_slow" row="0" col="0" label="Slow" role="choice" activeState="setting.dwell.slow" style="joinLeft" command="settings.dwell.slow"/ icon="speed2">
          <Cell id="p_norm" row="0" col="1" label="Normal" role="choice" activeState="setting.dwell.normal" style="join" command="settings.dwell.normal"/ icon="speed3">
          <Cell id="p_fast" row="0" col="2" label="Fast" role="choice" activeState="setting.dwell.fast" style="join" command="settings.dwell.fast"/ icon="speed4">
          <Cell id="p_custom" row="0" col="3" label="Custom" role="choice" activeState="setting.dwell.custom" style="joinRight" command="settings.dwell.custom"/ icon="toolsHandyman">
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_custom" row="2" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="p_custom_l" row="0" col="0" label="Custom" caption="Save the current timings, or restore the last save." role="label" style="plain"/>
        <SubGrid id="act_custom" row="0" col="1" rows="1" columns="2" gap="0" style="row">
          <Cell id="p_save" row="0" col="0" label="Save" style="joinLeft" command="settings.dwell.custom.save"/>
          <Cell id="p_restore" row="0" col="1" label="Restore" style="joinRight" command="settings.dwell.custom.restore"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_timing" row="5" col="0" colSpan="16" rowSpan="5" rows="5" columns="1" rowWeights="1,2,2,2,2" gap="6" margin="6" style="group">
      <Cell id="h_timing" row="0" col="0" label="Timing" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_dwell" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="dwell_label" row="0" col="0" label="Dwell sequence" caption="Hold steps. Last step repeats." role="label" style="plain"/>
        <SubGrid id="act_dwell" row="0" col="1" rows="1" columns="5" gap="0" style="row">
          <Cell id="dwell_value" row="0" col="0" colSpan="3" label="—" role="value" settingKey="dwellMs" style="joinLeft"/>
          <Cell id="dwell_edit" row="0" col="3" colSpan="2" label="Edit…" style="joinRight" command="settings.edit.dwellMs"/ icon="editSquare">
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_scan" row="2" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="scan_label" row="0" col="0" label="Scan grace" caption="Time on-target before dwell starts." role="label" style="plain"/>
        <SubGrid id="act_scan" row="0" col="1" rows="1" columns="9" gap="0" style="row">
          <Cell id="scan_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.scanGraceMs.dec"/>
          <Cell id="scan_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="scanGraceMs" style="join"/>
          <Cell id="scan_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.scanGraceMs.inc"/>
          <Cell id="scan_edit" row="0" col="7" colSpan="2" label="Edit…" style="joinRight" command="settings.edit.scanGraceMs"/ icon="editSquare">
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_zd" row="3" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="zd_label" row="0" col="0" label="Zoom dwell" caption="Dwell to choose the zoom region." role="label" style="plain"/>
        <SubGrid id="act_zd" row="0" col="1" rows="1" columns="9" gap="0" style="row">
          <Cell id="zd_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.magPickDwellMs.dec"/>
          <Cell id="zd_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="magPickDwellMs" style="join"/>
          <Cell id="zd_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.magPickDwellMs.inc"/>
          <Cell id="zd_edit" row="0" col="7" colSpan="2" label="Edit…" style="joinRight" command="settings.edit.magPickDwellMs"/ icon="editSquare">
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_pd" row="4" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="pd_label" row="0" col="0" label="Pointer dwell" caption="Dwell to place the cursor." role="label" style="plain"/>
        <SubGrid id="act_pd" row="0" col="1" rows="1" columns="9" gap="0" style="row">
          <Cell id="pd_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.mouseMoveDwellMs.dec"/>
          <Cell id="pd_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="mouseMoveDwellMs" style="join"/>
          <Cell id="pd_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.mouseMoveDwellMs.inc"/>
          <Cell id="pd_edit" row="0" col="7" colSpan="2" label="Edit…" style="joinRight" command="settings.edit.mouseMoveDwellMs"/ icon="editSquare">
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <Cell id="open_advanced" row="10" col="0" colSpan="16" label="More…" caption="Blink grace, pointer grace, foresight hold, auto-close." icon="moreHoriz">
      <ClosePage/>
      <OpenPage value="main_settings_speed_advanced"/>
    </Cell>
  </Grid>
</Page>
