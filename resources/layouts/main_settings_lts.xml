<Page id="main_settings_lts" name="Look to scroll" thickness="1" radius="4">
  <Style id="group" background="#00000000" thickness="1" radius="8"/>
  <Style id="row" background="#00000000" thickness="1" radius="6"/>
  <Style id="plain" background="#00000000" thickness="0" radius="0"/>
  <Style id="join" background="#00000000" thickness="0" radius="0"/>
  <Grid id="board" desktopMode="true" rows="12" columns="16" anchor="Top" offset="0,0" size="A_ScreenHeight/9*16, A_ScreenHeight" gap="6" margin="12" thickness="1" radius="4">
    <SubGrid id="tabs" row="0" col="0" colSpan="16" rows="1" columns="6" gap="6">
      <Cell id="tab_buttons" row="0" col="0" label="Button" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_button_timing"/>
      </Cell>
      <Cell id="tab_pointers" row="0" col="1" label="Pointer" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_pointer_timing"/>
      </Cell>
      <Cell id="tab_styles" row="0" col="2" label="Styles" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_styles"/>
      </Cell>
      <Cell id="tab_assist" row="0" col="3" label="Assist" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_assist"/>
      </Cell>
      <Cell id="tab_lts" row="0" col="4" label="LTS" role="tab" interactive="false"/>
      <Cell id="tab_theme" row="0" col="5" label="Theme" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_theme"/>
      </Cell>
    </SubGrid>

    <Cell id="page_title" row="1" col="0" colSpan="16" label="Look to scroll" caption="Deadzone, falloff, speed, indicator, and cursor placement for look-to-scroll" role="label" textStyle="title" style="plain"/>

    <SubGrid id="sec_dist" row="2" col="0" colSpan="16" rowSpan="3" rows="3" columns="1" rowWeights="1,2,2" gap="6" margin="6" style="group">
      <Cell id="h_dist" row="0" col="0" label="Distance" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_dz" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="dz_l" row="0" col="0" label="Deadzone" caption="No-scroll radius around cursor (px)." role="label" style="plain"/>
        <SubGrid id="act_dz" row="0" col="1" rows="1" columns="7" gap="0">
          <Cell id="dz_dec" row="0" col="0" label="−" cluster="stepper.dz" clusterSlot="dec" style="join" command="settings.nudge.ltsDeadzonePx.dec"/>
          <Cell id="dz_val" row="0" col="1" colSpan="3" label="—" role="label" settingKey="ltsDeadzonePx" cluster="stepper.dz" clusterSlot="value" style="join"/>
          <Cell id="dz_inc" row="0" col="4" label="+" cluster="stepper.dz" clusterSlot="inc" style="join" command="settings.nudge.ltsDeadzonePx.inc"/>
          <Cell id="dz_edit" row="0" col="5" colSpan="2" label="Edit…" cluster="stepper.dz" clusterSlot="edit" style="join" command="settings.edit.ltsDeadzonePx"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_fo" row="2" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="fo_l" row="0" col="0" label="Falloff" caption="Distance to full speed past deadzone (px)." role="label" style="plain"/>
        <SubGrid id="act_fo" row="0" col="1" rows="1" columns="7" gap="0">
          <Cell id="fo_dec" row="0" col="0" label="−" cluster="stepper.fo" clusterSlot="dec" style="join" command="settings.nudge.ltsFalloffPx.dec"/>
          <Cell id="fo_val" row="0" col="1" colSpan="3" label="—" role="label" settingKey="ltsFalloffPx" cluster="stepper.fo" clusterSlot="value" style="join"/>
          <Cell id="fo_inc" row="0" col="4" label="+" cluster="stepper.fo" clusterSlot="inc" style="join" command="settings.nudge.ltsFalloffPx.inc"/>
          <Cell id="fo_edit" row="0" col="5" colSpan="2" label="Edit…" cluster="stepper.fo" clusterSlot="edit" style="join" command="settings.edit.ltsFalloffPx"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_spd" row="5" col="0" colSpan="16" rowSpan="3" rows="3" columns="1" rowWeights="1,2,2" gap="6" margin="6" style="group">
      <Cell id="h_spd" row="0" col="0" label="Speed" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_sp" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="sp_l" row="0" col="0" label="Max speed" caption="Peak notches per second." role="label" style="plain"/>
        <SubGrid id="act_sp" row="0" col="1" rows="1" columns="7" gap="0">
          <Cell id="sp_dec" row="0" col="0" label="−" cluster="stepper.sp" clusterSlot="dec" style="join" command="settings.nudge.ltsMaxNotchesPerSec.dec"/>
          <Cell id="sp_val" row="0" col="1" colSpan="3" label="—" role="label" settingKey="ltsMaxNotchesPerSec" cluster="stepper.sp" clusterSlot="value" style="join"/>
          <Cell id="sp_inc" row="0" col="4" label="+" cluster="stepper.sp" clusterSlot="inc" style="join" command="settings.nudge.ltsMaxNotchesPerSec.inc"/>
          <Cell id="sp_edit" row="0" col="5" colSpan="2" label="Edit…" cluster="stepper.sp" clusterSlot="edit" style="join" command="settings.edit.ltsMaxNotchesPerSec"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_accel" row="2" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="accel_label" row="0" col="0" label="Accel / s" caption="Speed growth while outside deadzone." role="label" style="plain"/>
        <SubGrid id="act_accel" row="0" col="1" rows="1" columns="7" gap="0">
          <Cell id="accel_dec" row="0" col="0" label="−" cluster="stepper.accel" clusterSlot="dec" style="join" command="settings.nudge.ltsAccelPerSec.dec"/>
          <Cell id="accel_val" row="0" col="1" colSpan="3" label="—" role="label" settingKey="ltsAccelPerSec" cluster="stepper.accel" clusterSlot="value" style="join"/>
          <Cell id="accel_inc" row="0" col="4" label="+" cluster="stepper.accel" clusterSlot="inc" style="join" command="settings.nudge.ltsAccelPerSec.inc"/>
          <Cell id="accel_edit" row="0" col="5" colSpan="2" label="Edit…" cluster="stepper.accel" clusterSlot="edit" style="join" command="settings.edit.ltsAccelPerSec"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_ind" row="8" col="0" colSpan="16" rowSpan="2" rows="2" columns="1" rowWeights="1,2" gap="6" margin="6" style="group">
      <Cell id="h_ind" row="0" col="0" label="Indicator" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_ind" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="ind_l" row="0" col="0" label="Scroll indicator" caption="Fan wedge, stretching orb, or hub/menu only." role="label" style="plain"/>
        <SubGrid id="act_ind" row="0" col="1" rows="1" columns="3" gap="0">
          <Cell id="ind_fan" row="0" col="0" label="Fan" cluster="segment.ltsInd" activeState="setting.ltsIndicator.0" style="join" command="settings.lts.indicator.fan"/>
          <Cell id="ind_orb" row="0" col="1" label="Orb" cluster="segment.ltsInd" activeState="setting.ltsIndicator.1" style="join" command="settings.lts.indicator.orb"/>
          <Cell id="ind_pause" row="0" col="2" label="Pause" cluster="segment.ltsInd" activeState="setting.ltsIndicator.2" style="join" command="settings.lts.indicator.pause"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_place" row="10" col="0" colSpan="16" rowSpan="2" rows="2" columns="1" rowWeights="1,2" gap="6" margin="6" style="group">
      <Cell id="h_place" row="0" col="0" label="Placement" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_place" row="1" col="0" rows="1" columns="1" gap="0" style="row">
        <Cell id="pl_t" row="0" col="0" label="Place cursor first" icon="MouseMoveToPointIcon" caption="Arm mouse-move before enabling scroll." role="toggle" activeState="lts.placeCursorFirst" cluster="place.cursor" style="join" command="settings.lts.placeCursor.toggle"/>
      </SubGrid>
    </SubGrid>
  </Grid>
</Page>
