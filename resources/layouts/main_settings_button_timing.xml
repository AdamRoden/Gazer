<Page id="main_settings_button_timing" name="Button timing">
  <Style id="group" background="#00000000" thickness="1" radius="8"/>
  <Style id="row" background="#00000000" thickness="1" radius="6"/>
  <Style id="plain" background="#00000000" thickness="0" radius="0"/>
  <Style id="join" background="#00000000" thickness="0" radius="0"/>
  <Grid id="board" desktopMode="true" rows="10" columns="16" anchor="Top" offset="0,0" size="1600,1.0" gap="6" margin="12" aboveTaskbar="false" thickness="1" radius="4">
    <SubGrid id="tabs" row="0" col="0" colSpan="16" rows="1" columns="6" gap="6">
      <Cell id="tab_buttons" row="0" col="0" label="Button" role="tab" interactive="false"/>
      <Cell id="tab_pointers" row="0" col="1" label="Pointer" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_pointer_timing"/>
      </Cell>
      <Cell id="tab_styles" row="0" col="2" label="Styles" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_styles"/>
      </Cell>
      <Cell id="tab_assist" row="0" col="3" label="Assist" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_assist"/>
      </Cell>
      <Cell id="tab_lts" row="0" col="4" label="LTS" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_lts"/>
      </Cell>
      <Cell id="tab_theme" row="0" col="5" label="Theme" role="tab">
        <ClosePage value="-self"/>
        <OpenPage value="main_settings_theme"/>
      </Cell>
    </SubGrid>

    <Cell id="page_title" row="1" col="0" colSpan="16" label="Button timing" caption="Board dwell timing, blink/scan grace, and completion flash duration" role="label" textStyle="title" style="plain"/>

    <SubGrid id="sec_timing" row="2" col="0" colSpan="16" rowSpan="4" rows="4" columns="1" rowWeights="1,2,2,2" gap="6" margin="6" style="group">
      <Cell id="h_timing" row="0" col="0" label="Timing" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_grace" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="grace_label" row="0" col="0" label="Blink grace" caption="Blink window without canceling dwell (ms)." role="label" style="plain"/>
        <SubGrid id="act_grace" row="0" col="1" rows="1" columns="7" gap="0">
          <Cell id="grace_dec" row="0" col="0" label="−" cluster="stepper.grace" clusterSlot="dec" style="join" command="settings.nudge.dwellGraceMs.dec"/>
          <Cell id="grace_val" row="0" col="1" colSpan="3" label="—" role="label" settingKey="dwellGraceMs" cluster="stepper.grace" clusterSlot="value" style="join"/>
          <Cell id="grace_inc" row="0" col="4" label="+" cluster="stepper.grace" clusterSlot="inc" style="join" command="settings.nudge.dwellGraceMs.inc"/>
          <Cell id="grace_edit" row="0" col="5" colSpan="2" label="Edit…" cluster="stepper.grace" clusterSlot="edit" style="join" command="settings.edit.dwellGraceMs"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_scan" row="2" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="scan_label" row="0" col="0" label="Scan grace" caption="Time on-target before dwell progress starts (ms)." role="label" style="plain"/>
        <SubGrid id="act_scan" row="0" col="1" rows="1" columns="7" gap="0">
          <Cell id="scan_dec" row="0" col="0" label="−" cluster="stepper.scan" clusterSlot="dec" style="join" command="settings.nudge.scanGraceMs.dec"/>
          <Cell id="scan_val" row="0" col="1" colSpan="3" label="—" role="label" settingKey="scanGraceMs" cluster="stepper.scan" clusterSlot="value" style="join"/>
          <Cell id="scan_inc" row="0" col="4" label="+" cluster="stepper.scan" clusterSlot="inc" style="join" command="settings.nudge.scanGraceMs.inc"/>
          <Cell id="scan_edit" row="0" col="5" colSpan="2" label="Edit…" cluster="stepper.scan" clusterSlot="edit" style="join" command="settings.edit.scanGraceMs"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_dwell" row="3" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="dwell_label" row="0" col="0" label="Dwell sequence" caption="Comma-separated ms steps while holding. Last step repeats forever." role="label" style="plain"/>
        <SubGrid id="act_dwell" row="0" col="1" rows="1" columns="5" gap="0">
          <Cell id="dwell_value" row="0" col="0" colSpan="3" label="—" role="label" settingKey="dwellMs" cluster="stepper.dwell" clusterSlot="value" style="join"/>
          <Cell id="dwell_edit" row="0" col="3" colSpan="2" label="Edit…" cluster="stepper.dwell" clusterSlot="edit" style="join" command="settings.edit.dwellMs"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_flash" row="6" col="0" colSpan="16" rowSpan="2" rows="2" columns="1" rowWeights="1,2" gap="6" margin="6" style="group">
      <Cell id="h_flash" row="0" col="0" label="Feedback" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_fd" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="fd_label" row="0" col="0" label="Completion flash duration" caption="How long the completion flash is shown (ms)." role="label" style="plain"/>
        <SubGrid id="act_fd" row="0" col="1" rows="1" columns="7" gap="0">
          <Cell id="fd_dec" row="0" col="0" label="−" cluster="stepper.fd" clusterSlot="dec" style="join" command="settings.nudge.flashMs.dec"/>
          <Cell id="fd_val" row="0" col="1" colSpan="3" label="—" role="label" settingKey="flashMs" cluster="stepper.fd" clusterSlot="value" style="join"/>
          <Cell id="fd_inc" row="0" col="4" label="+" cluster="stepper.fd" clusterSlot="inc" style="join" command="settings.nudge.flashMs.inc"/>
          <Cell id="fd_edit" row="0" col="5" colSpan="2" label="Edit…" cluster="stepper.fd" clusterSlot="edit" style="join" command="settings.edit.flashMs"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_presets" row="8" col="0" colSpan="16" rowSpan="2" rows="2" columns="1" rowWeights="1,2" gap="6" margin="6" style="group">
      <Cell id="h_presets" row="0" col="0" label="Presets" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_preset" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="p_label" row="0" col="0" label="Quick packages" caption="Slow / Normal / Fast single-step dwell." role="label" style="plain"/>
        <SubGrid id="act_preset" row="0" col="1" rows="1" columns="3" gap="0">
          <Cell id="p_slow" row="0" col="0" label="Slow" cluster="segment.preset" activeState="setting.dwell.slow" style="join" command="settings.dwell.slow"/>
          <Cell id="p_norm" row="0" col="1" label="Normal" cluster="segment.preset" activeState="setting.dwell.normal" style="join" command="settings.dwell.normal"/>
          <Cell id="p_fast" row="0" col="2" label="Fast" cluster="segment.preset" activeState="setting.dwell.fast" style="join" command="settings.dwell.fast"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>
  </Grid>
</Page>
