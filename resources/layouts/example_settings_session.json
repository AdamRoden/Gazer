{
  "schemaVersion": 1,
  "id": "example_settings_session",
  "name": "Session",
  "description": "Main dock behavior and tracker preference",
  "uiStyle": "fluent",
  "window": { "anchor": "center", "widthPx": 1000, "heightPx": 520, "marginPx": 16 },
  "grid": { "columns": 5, "rows": 4, "gapPx": 10, "marginPx": 56 },
  "items": [
    { "id": "tr_l", "role": "label", "label": "Tracker", "caption": "Applies on next app start.", "row": 2, "col": 0 },
    { "id": "tr_v", "role": "value", "settingKey": "trackerPref", "label": "—", "row": 2, "col": 2 },
    { "id": "tr_a", "label": "Auto Tobii", "activeState": "setting.tracker.0", "row": 2, "col": 3, "style": { "background": "#1d3557", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.tracker.auto" } },
    { "id": "tr_m", "label": "Mouse", "activeState": "setting.tracker.1", "row": 2, "col": 4, "style": { "background": "#457b9d", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.tracker.mouse" } }
  ]
}
