{
  "schemaVersion": 1,
  "id": "main_settings",
  "name": "Settings",
  "uiStyle": "fluent",
  "window": { "anchor": "TopCenter", "widthPx": 1260, "height": 100, "marginPx": 0 },
  "grid": { "columns": 6, "rows": 10, "gapPx": 10, "marginPx": 100 },
  "items": [
    { "id": "buttons", "label": "Buttons", "row": 0, "col": 0, "action": { "type": "loadLayout", "layoutId": "main_settings_buttons" } },
    { "id": "pointers", "label": "Pointers", "row": 0, "col": 1, "action": { "type": "loadLayout", "layoutId": "main_settings_pointers" } },
    { "id": "lts", "label": "Look↕Scroll", "row": 0, "col": 2, "action": { "type": "loadLayout", "layoutId": "main_settings_lts" } },
    { "id": "theme", "label": "Theme", "row": 0, "col": 3, "action": { "type": "loadLayout", "layoutId": "main_settings_theme" } },
    { "id": "assist", "label": "Assist tools", "row": 0, "col": 4, "action": { "type": "loadLayout", "layoutId": "main_settings_assist" } },

    { "id": "close", "label": "Close", "row": 9, "col": 2, "colSpan": 1, "action": { "type": "closeLayout" } }
