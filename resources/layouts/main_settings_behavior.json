{
  "schemaVersion": 1,
  "id": "main_settings_behavior",
  "name": "Behavior",
  "description": "Progress styles, flash, and mouse-move pick markers",
  "uiStyle": "fluent",
  "window": { "anchor": "TopCenter", "widthPx": 1260, "height": 100, "marginPx": 0 },
  "grid": { "columns": 6, "rows": 11, "gapPx": 10, "marginPx": 100 },
  "items": [
    { "id": "timing", "label": "Timing", "row": 0, "col": 0, "action": { "type": "loadLayout", "layoutId": "main_settings_timing" } },
    { "id": "magnifier", "label": "Magnifier", "row": 0, "col": 1, "action": { "type": "loadLayout", "layoutId": "main_settings_magnifier" } },
    { "id": "lts", "label": "Look↕Scroll", "row": 0, "col": 2, "action": { "type": "loadLayout", "layoutId": "main_settings_lts" } },
    { "id": "behavior", "label": "Behavior", "row": 0, "col": 3, "action": { "type": "loadLayout", "layoutId": "main_settings_behavior" } },
    { "id": "theme", "label": "Theme", "row": 0, "col": 4, "action": { "type": "loadLayout", "layoutId": "main_settings_theme" } },
    { "id": "assist", "label": "Assist tools", "row": 0, "col": 5, "action": { "type": "loadLayout", "layoutId": "main_settings_assist" } },

    { "id": "r_name", "role": "label", "label": "Activator Progress", "caption": "Progress styles for the activators.", "row": 2, "col": 0 },
    { "id": "r_tog", "label": "Ring", "activeState": "setting.progressRadial", "row": 2, "col": 2, "action": { "type": "command", "name": "settings.progress.radial.toggle" } },
    { "id": "f_tog", "label": "Fill", "activeState": "setting.progressFill", "row": 2, "col": 3, "action": { "type": "command", "name": "settings.progress.fill.toggle" } },
    { "id": "b_tog", "label": "Border", "activeState": "setting.progressBorder", "row": 2, "col": 4, "action": { "type": "command", "name": "settings.progress.border.toggle" } },

    { "id": "mr_name", "role": "label", "label": "Mouse Progress", "caption": "Progress styles for mouse-move dwell.", "row": 3, "col": 0 },
    { "id": "mr_r", "label": "Ring", "activeState": "setting.mouseProgressRadial", "row": 3, "col": 2, "action": { "type": "command", "name": "settings.mouseProgress.radial.toggle" } },
    { "id": "mr_f", "label": "Fill", "activeState": "setting.mouseProgressFill", "row": 3, "col": 3, "action": { "type": "command", "name": "settings.mouseProgress.fill.toggle" } },
    { "id": "mr_b", "label": "Border", "activeState": "setting.mouseProgressBorder", "row": 3, "col": 4, "action": { "type": "command", "name": "settings.mouseProgress.border.toggle" } },

    { "id": "fl_name", "role": "label", "label": "Completion flash", "caption": "Flash after activation. Foreground uses the item text color; Custom picks a color.", "row": 4, "col": 0 },
    { "id": "fl_fg", "label": "Use Foreground", "activeState": "setting.flashUseForeground", "row": 4, "col": 2, "colSpan": 2, "action": { "type": "command", "name": "settings.flash.foreground" } },
    { "id": "fl_custom", "label": "Custom", "activeState": "setting.flashUseCustom", "row": 4, "col": 4, "action": { "type": "command", "name": "settings.flash.custom" } },

    { "id": "fd_label", "role": "label", "label": "Flash duration", "caption": "How long the completion flash is shown (ms).", "row": 5, "col": 0 },
    { "id": "fd_dec", "label": "−", "row": 5, "col": 2, "action": { "type": "command", "name": "settings.nudge.flashMs.dec" } },
    { "id": "fd_val", "role": "value", "settingKey": "flashMs", "label": "—", "row": 5, "col": 3 },
    { "id": "fd_inc", "label": "+", "row": 5, "col": 4, "action": { "type": "command", "name": "settings.nudge.flashMs.inc" } },

    { "id": "mps_name", "role": "label", "label": "Magnify Pick Style", "caption": "Markers for choosing the region to magnify. Combine any.", "row": 6, "col": 0 },
    { "id": "mps_cur", "label": "Cursor", "activeState": "setting.magPick.cursor", "row": 6, "col": 1, "action": { "type": "command", "name": "settings.magPickStyle.cursor.toggle" } },
    { "id": "mps_dot", "label": "Dot", "activeState": "setting.magPick.dot", "row": 6, "col": 2, "action": { "type": "command", "name": "settings.magPickStyle.dot.toggle" } },
    { "id": "mps_xh", "label": "Crosshair", "activeState": "setting.magPick.crosshair", "row": 6, "col": 3, "action": { "type": "command", "name": "settings.magPickStyle.crosshair.toggle" } },
    { "id": "mps_gz", "label": "Gaze indicator", "activeState": "setting.magPick.gaze", "row": 6, "col": 4, "action": { "type": "command", "name": "settings.magPickStyle.gaze.toggle" } },

    { "id": "cks_name", "role": "label", "label": "Mouse Pick Style", "caption": "Markers for the final move / click point. Combine any.", "row": 7, "col": 0 },
    { "id": "cks_cur", "label": "Cursor", "activeState": "setting.mousePick.cursor", "row": 7, "col": 1, "action": { "type": "command", "name": "settings.mousePickStyle.cursor.toggle" } },
    { "id": "cks_dot", "label": "Dot", "activeState": "setting.mousePick.dot", "row": 7, "col": 2, "action": { "type": "command", "name": "settings.mousePickStyle.dot.toggle" } },
    { "id": "cks_xh", "label": "Crosshair", "activeState": "setting.mousePick.crosshair", "row": 7, "col": 3, "action": { "type": "command", "name": "settings.mousePickStyle.crosshair.toggle" } },

    { "id": "close", "label": "Close", "row": 10, "col": 2, "colSpan": 1, "action": { "type": "closeLayout" } }
  ]
}
