{
  "schemaVersion": 1,
  "id": "main_settings_pointers",
  "name": "Pointers",
  "description": "Move-to aiming, static pick zoom, and pointer markers",
  "uiStyle": "fluent",
  "window": { "anchor": "TopCenter", "widthPx": 1600, "height": 100, "marginPx": 0 },
  "grid": { "columns": 16, "rows": 13, "gapPx": 10, "marginPx": 50 },
  "items": [
    { "id": "buttons", "label": "Buttons", "row": 1, "col": 0, "colSpan": 2, "action": { "type": "loadLayout", "layoutId": "main_settings_buttons" } },
    { "id": "pointers", "label": "Pointers", "row": 2, "col": 0, "colSpan": 2 },
    { "id": "assist", "label": "Assist tools", "row": 3, "col": 0, "colSpan": 2, "action": { "type": "loadLayout", "layoutId": "main_settings_assist" } },
    { "id": "theme", "label": "Theme", "row": 4, "col": 0, "colSpan": 2, "action": { "type": "loadLayout", "layoutId": "main_settings_theme" } },
    { "id": "close", "label": "Close", "row": 11, "col": 0, "colSpan": 2, "action": { "type": "closeLayout" } },

    { "id": "mpd_label", "role": "label", "label": "Magnify-pick dwell", "caption": "Dwell time to choose the region to magnify (ms).", "row": 1, "col": 3, "colSpan": 4 },
    { "id": "mpd_dec", "label": "−", "row": 1, "col": 8, "action": { "type": "command", "name": "settings.nudge.magPickDwellMs.dec" } },
    { "id": "mpd_value", "role": "value", "settingKey": "magPickDwellMs", "label": "—", "row": 1, "col": 9, "colSpan": 2 },
    { "id": "mpd_inc", "label": "+", "row": 1, "col": 11, "action": { "type": "command", "name": "settings.nudge.magPickDwellMs.inc" } },
    { "id": "mpd_edit", "label": "Edit…", "row": 1, "col": 12, "action": { "type": "command", "name": "settings.edit.magPickDwellMs" } },

    { "id": "mm_label", "role": "label", "label": "Mouse-move dwell", "caption": "Dwell time for the final cursor / click placement (ms).", "row": 2, "col": 3, "colSpan": 4 },
    { "id": "mm_dec", "label": "−", "row": 2, "col": 8, "action": { "type": "command", "name": "settings.nudge.mouseMoveDwellMs.dec" } },
    { "id": "mm_value", "role": "value", "settingKey": "mouseMoveDwellMs", "label": "—", "row": 2, "col": 9, "colSpan": 2 },
    { "id": "mm_inc", "label": "+", "row": 2, "col": 11, "action": { "type": "command", "name": "settings.nudge.mouseMoveDwellMs.inc" } },
    { "id": "mm_edit", "label": "Edit…", "row": 2, "col": 12, "action": { "type": "command", "name": "settings.edit.mouseMoveDwellMs" } },

    { "id": "mmt_label", "role": "label", "label": "Mouse-move timeout", "caption": "Cancel move if no target is selected within this many ms (0 = off).", "row": 3, "col": 3, "colSpan": 4 },
    { "id": "mmt_dec", "label": "−", "row": 3, "col": 8, "action": { "type": "command", "name": "settings.nudge.mouseMoveSelectTimeoutMs.dec" } },
    { "id": "mmt_value", "role": "value", "settingKey": "mouseMoveSelectTimeoutMs", "label": "—", "row": 3, "col": 9, "colSpan": 2 },
    { "id": "mmt_inc", "label": "+", "row": 3, "col": 11, "action": { "type": "command", "name": "settings.nudge.mouseMoveSelectTimeoutMs.inc" } },
    { "id": "mmt_edit", "label": "Edit…", "row": 3, "col": 12, "action": { "type": "command", "name": "settings.edit.mouseMoveSelectTimeoutMs" } },

    { "id": "pz_label", "role": "label", "label": "Pick zoom", "caption": "Magnification for pre-click and foresight. Not the live lens.", "row": 4, "col": 3, "colSpan": 4 },
    { "id": "pz_dec", "label": "−", "row": 4, "col": 8, "action": { "type": "command", "name": "settings.nudge.pickZoom.dec" } },
    { "id": "pz_value", "role": "value", "settingKey": "pickZoom", "label": "—", "row": 4, "col": 9, "colSpan": 2 },
    { "id": "pz_inc", "label": "+", "row": 4, "col": 11, "action": { "type": "command", "name": "settings.nudge.pickZoom.inc" } },
    { "id": "pz_edit", "label": "Edit…", "row": 4, "col": 12, "action": { "type": "command", "name": "settings.edit.pickZoom" } },

    { "id": "pw_label", "role": "label", "label": "Pick window", "caption": "Static zoom window size for pre-click and foresight (px).", "row": 5, "col": 3, "colSpan": 4 },
    { "id": "pw_dec", "label": "−", "row": 5, "col": 8, "action": { "type": "command", "name": "settings.nudge.pickWindowPx.dec" } },
    { "id": "pw_value", "role": "value", "settingKey": "pickWindowPx", "label": "—", "row": 5, "col": 9, "colSpan": 2 },
    { "id": "pw_inc", "label": "+", "row": 5, "col": 11, "action": { "type": "command", "name": "settings.nudge.pickWindowPx.inc" } },
    { "id": "pw_edit", "label": "Edit…", "row": 5, "col": 12, "action": { "type": "command", "name": "settings.edit.pickWindowPx" } },

    { "id": "fsd_label", "role": "label", "label": "Foresight dwell", "caption": "How long to gaze at a desktop point before Foresight stores it (ms). Kept for 2 seconds.", "row": 7, "col": 3, "colSpan": 4 },
    { "id": "fsd_dec", "label": "−", "row": 7, "col": 8, "action": { "type": "command", "name": "settings.nudge.mouseMoveForesightDwellMs.dec" } },
    { "id": "fsd_value", "role": "value", "settingKey": "mouseMoveForesightDwellMs", "label": "—", "row": 7, "col": 9, "colSpan": 2 },
    { "id": "fsd_inc", "label": "+", "row": 7, "col": 11, "action": { "type": "command", "name": "settings.nudge.mouseMoveForesightDwellMs.inc" } },
    { "id": "fsd_edit", "label": "Edit…", "row": 7, "col": 12, "action": { "type": "command", "name": "settings.edit.mouseMoveForesightDwellMs" } },

    { "id": "mr_name", "role": "label", "label": "Mouse Progress", "caption": "Progress styles for mouse-move dwell.", "row": 8, "col": 3, "colSpan": 4 },
    { "id": "mr_r", "label": "Ring", "activeState": "setting.mouseProgressRadial", "row": 8, "col": 9, "colSpan": 2, "action": { "type": "command", "name": "settings.mouseProgress.radial.toggle" } },
    { "id": "mr_f", "label": "Fill", "activeState": "setting.mouseProgressFill", "row": 8, "col": 11, "action": { "type": "command", "name": "settings.mouseProgress.toggle" } },
    { "id": "mr_b", "label": "Border", "activeState": "setting.mouseProgressBorder", "row": 8, "col": 12, "action": { "type": "command", "name": "settings.mouseProgress.border.toggle" } },

    { "id": "mps_name", "role": "label", "label": "Magnify Pick Style", "caption": "Markers for choosing the region to magnify. Combine any.", "row": 9, "col": 3, "colSpan": 4 },
    { "id": "mps_cur", "label": "Cursor", "activeState": "setting.magPick.cursor", "row": 9, "col": 8, "action": { "type": "command", "name": "settings.magPickStyle.cursor.toggle" } },
    { "id": "mps_dot", "label": "Dot", "activeState": "setting.magPick.dot", "row": 9, "col": 9, "colSpan": 2, "action": { "type": "command", "name": "settings.magPickStyle.dot.toggle" } },
    { "id": "mps_xh", "label": "Crosshair", "activeState": "setting.magPick.crosshair", "row": 9, "col": 11, "action": { "type": "command", "name": "settings.magPickStyle.crosshair.toggle" } },
    { "id": "mps_gz", "label": "Gaze indicator", "activeState": "setting.magPick.gaze", "row": 9, "col": 12, "action": { "type": "command", "name": "settings.magPickStyle.gaze.toggle" } },

    { "id": "cks_name", "role": "label", "label": "Mouse Pick Style", "caption": "Markers for the final move / click point. Combine any.", "row": 10, "col": 3, "colSpan": 4 },
    { "id": "cks_cur", "label": "Cursor", "activeState": "setting.mousePick.cursor", "row": 10, "col": 8, "action": { "type": "command", "name": "settings.mousePickStyle.cursor.toggle" } },
    { "id": "cks_dot", "label": "Dot", "activeState": "setting.mousePick.dot", "row": 10, "col": 9, "colSpan": 2, "action": { "type": "command", "name": "settings.mousePickStyle.dot.toggle" } },
    { "id": "cks_xh", "label": "Crosshair", "activeState": "setting.mousePick.crosshair", "row": 10, "col": 11, "action": { "type": "command", "name": "settings.mousePickStyle.graph.toggle" } },
    
    { "id": "mag_pick", "label": "Pre-Click Zoom", "icon": "magPick", "activeState": "mouseMoveMagPick", "row": 11, "col": 3, "colSpan": 2, "action": { "type": "command", "name": "toggleMouseMoveMagPick" } },
    { "id": "mag_center", "label": "Zoom @dwell", "icon": "magPickCenter", "caption": "Center the zoom window on the dwell point.", "activeState": "mouseMoveMagPickCenter", "row": 11, "col": 5, "colSpan": 2, "action": { "type": "command", "name": "toggleMouseMoveMagPickCenter" } },
    { "id": "mag_full", "label": "Full-screen zoom", "icon": "magFullScreen", "caption": "Grow the static zoom window to fill the monitor's short axis.", "activeState": "mouseMoveMagPickFullScreen", "row": 11, "col": 7, "colSpan": 2, "action": { "type": "command", "name": "toggleMouseMoveMagPickFullScreen" } },
    { "id": "foresight", "label": "Foresight", "icon": "foresight", "caption": "Dwell on a desktop point to remember it. If you trigger Move-to within 2 seconds, that area magnifies immediately.", "activeState": "mouseMoveForesight", "row": 11, "col": 9, "colSpan": 2, "action": { "type": "command", "name": "toggleMouseMoveForesight" } },
    { "id": "foresight_dbl", "label": "Double zoom", "icon": "doubleZoom", "caption": "When Foresight and Pre-Click Zoom are both on: dwell inside the foresight zoom to magnify again.", "activeState": "mouseMoveForesightDoubleZoom", "row": 11, "col": 11, "colSpan": 2, "action": { "type": "command", "name": "toggleMouseMoveForesightDoubleZoom" } }  ]
}