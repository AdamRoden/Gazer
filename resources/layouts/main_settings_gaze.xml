<?xml version="1.0" encoding="UTF-8"?>
<Page id="main_settings_gaze" name="Gaze" radius="16">
  <Style id="row" background="transparent" thickness="0" radius="0"/>
  <Style id="join" background="transparent" thickness="0" radius="0"/>
  <Style id="plain" background="transparent" thickness="0" radius="0"/>
  <Style id="button" background="transparent" thickness="0" radius="10"/>
  <Style id="joinLeft" background="transparent" thickness="0" radius="10,0,0,10"/>
  <Style id="group" background="bg95" thickness="0" radius="16"/>
  <Style id="joinRight" background="transparent" thickness="0" radius="0,10,10,0"/>
  <Grid id="board" rows="2" columns="2" desktopMode="true" anchor="Top" offset="0,0" size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth),A_ScreenHeight" gap="12" rowHeights="96,*" columnWidths="*,72" radius="16">
    <Row id="titlebar" columns="2" span="2" gap="8" columnWidths="*,160" style="plain">
      <Label id="page_title" style="plain" label="Gaze" caption="Follow, lens, look-to maps, and ComboMouse" textStyle="title"/>
      <Button id="tab_done" style="button" label="Close" icon="keyboardHide" textStyle="row" closeAllPages="true"/>
    </Row>
    <Column id="scroller" rows="4" row="1" gap="12" rowHeights="376,376,480,584" scroll="true">
      <Card id="sec_follow" rows="4" gap="8" padding="8" rowHeights="48,96,96,96" style="group">
        <Label id="h_follow" style="plain" label="Follow" textStyle="section"/>
        <Row id="row_follow" columns="2" gap="6" style="row">
          <Label id="f_l" style="plain" label="Gaze follow" caption="Reticle, gaze mouse, and live lens."/>
          <Row columns="4" style="row">
            <Choice id="f_slow" style="joinLeft" label="Slow" bind="settings.mag.follow.slow" command="settings.mag.follow.slow"/>
            <Choice style="join" label="Sticky" bind="settings.mag.follow.sticky" command="settings.mag.follow.sticky"/>
            <Choice style="join" label="Smooth" bind="settings.mag.follow.smooth" command="settings.mag.follow.smooth"/>
            <Choice style="joinRight" label="Snappy" bind="settings.mag.follow.snappy" command="settings.mag.follow.snappy"/>
          </Row>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Show gaze" caption="Marker at the gaze point."/>
          <Switch id="reticle" style="button" label="On" icon="eye" bind="gazeReticle" command="toggleGazeReticle"/>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Gaze mouse" caption="The pointer follows gaze."/>
          <Switch id="follow" style="button" label="On" icon="MouseMagneticCursor" bind="gazeMouseFollow" command="toggleGazeMouseFollow"/>
        </Row>
      </Card>
      <Card id="sec_lens" rows="4" gap="8" padding="8" rowHeights="48,96,96,96" style="group">
        <Label id="h_lens" style="plain" label="Lens" textStyle="section"/>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Lens" caption="Magnifier that follows gaze."/>
          <Switch id="magnifier" style="button" label="On" icon="MagnifyTool" bind="magnifier" command="toggleMagnifier"/>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Lens zoom" caption="Live lens magnification."/>
          <Row columns="9" style="row">
            <Button style="joinLeft" label="−" span="2" command="settings.nudge.magZoom.dec"/>
            <Label id="z_val" style="join" label="—" settingKey="magZoom" role="value" span="3"/>
            <Button style="join" label="+" span="2" command="settings.nudge.magZoom.inc"/>
            <Button style="joinRight" label="Edit…" icon="editSquare" span="2" command="settings.edit.magZoom"/>
          </Row>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Lens size" caption="Live lens diameter."/>
          <Row columns="9" style="row">
            <Button style="joinLeft" label="−" span="2" command="settings.nudge.magLensSize.dec"/>
            <Label id="l_val" style="join" label="—" settingKey="magLensSize" role="value" span="3"/>
            <Button style="join" label="+" span="2" command="settings.nudge.magLensSize.inc"/>
            <Button style="joinRight" label="Edit…" icon="editSquare" span="2" command="settings.edit.magLensSize"/>
          </Row>
        </Row>
      </Card>
      <Card id="sec_look" rows="5" gap="8" padding="8" rowHeights="48,96,96,96,96" style="group">
        <Row columns="2" gap="12" columnWidths="220,*" style="plain">
          <Label id="h_look" style="plain" label="Look-to maps" textStyle="section"/>
          <Label id="look_hint" style="plain" label="Each map has its own origin and rings. All four can run at once." textStyle="caption"/>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Scroll" icon="lookToScroll" caption="Wheel from gaze vs the origin."/>
          <Row columns="2" style="row">
            <Switch id="lts_on" style="joinLeft" label="Enable" icon="lookToScroll" bind="lookToScroll" command="lookToScroll"/>
            <Button style="joinRight" label="Edit" icon="editSquare" command="lookTo.edit.scroll"/>
          </Row>
        </Row>
        <Row id="row_mouse" columns="2" gap="6" style="row">
          <Label style="plain" label="Mouse" icon="mouseMove" caption="Move the pointer from gaze vs the origin."/>
          <Row id="act_mouse" columns="2" style="row">
            <Switch id="mouse_on" style="joinLeft" label="Enable" icon="mouseMove" bind="lookToMouse" command="lookToMouse"/>
            <Button style="joinRight" label="Edit" icon="editSquare" command="lookTo.edit.mouse"/>
          </Row>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Left stick" icon="sportsEsports" caption="Left analog stick from gaze vs the origin."/>
          <Row columns="2" style="row">
            <Switch id="lstick_on" style="joinLeft" label="Enable" icon="sportsEsports" bind="lookToLeftStick" command="lookToLeftStick"/>
            <Button style="joinRight" label="Edit" icon="editSquare" command="lookTo.edit.leftStick"/>
          </Row>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Right stick" icon="sportsEsports" caption="Right analog stick from gaze vs the origin."/>
          <Row columns="2" style="row">
            <Switch id="rstick_on" style="joinLeft" label="Enable" icon="sportsEsports" bind="lookToRightStick" command="lookToRightStick"/>
            <Button style="joinRight" label="Edit" icon="editSquare" command="lookTo.edit.rightStick"/>
          </Row>
        </Row>
      </Card>
      <Card id="sec_combo" rows="6" gap="8" padding="8" rowHeights="48,96,96,96,96,96" style="group">
        <Label id="h_combo" style="plain" label="ComboMouse" textStyle="section"/>
        <Row id="row_combo_on" columns="2" gap="6" style="row">
          <Label id="combo_on_l" style="plain" label="Try" caption="Dwell to place, then drift and click from the pie."/>
          <Switch id="combo_on" style="button" label="ComboMouse" icon="comboMouse" bind="comboMouse" command="toggleComboMouse"/>
        </Row>
        <Row id="row_combo_inner" columns="2" gap="6" style="row">
          <Label style="plain" label="Inner radius" caption="Inner edge of the drift ring."/>
          <Row columns="9" style="row">
            <Button style="joinLeft" label="−" span="2" command="settings.nudge.comboInnerRadiusPx.dec"/>
            <Label style="join" label="—" settingKey="comboInnerRadiusPx" role="value" span="3"/>
            <Button style="join" label="+" span="2" command="settings.nudge.comboInnerRadiusPx.inc"/>
            <Button style="joinRight" label="Edit…" icon="editSquare" span="2" command="settings.edit.comboInnerRadiusPx"/>
          </Row>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Shared radius" caption="Where the drift ring meets the pie."/>
          <Row columns="9" style="row">
            <Button style="joinLeft" label="−" span="2" command="settings.nudge.comboSharedRadiusPx.dec"/>
            <Label style="join" label="—" settingKey="comboSharedRadiusPx" role="value" span="3"/>
            <Button style="join" label="+" span="2" command="settings.nudge.comboSharedRadiusPx.inc"/>
            <Button style="joinRight" label="Edit…" icon="editSquare" span="2" command="settings.edit.comboSharedRadiusPx"/>
          </Row>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Outer radius" caption="Outer edge of the command pie."/>
          <Row columns="9" style="row">
            <Button style="joinLeft" label="−" span="2" command="settings.nudge.comboOuterRadiusPx.dec"/>
            <Label style="join" label="—" settingKey="comboOuterRadiusPx" role="value" span="3"/>
            <Button style="join" label="+" span="2" command="settings.nudge.comboOuterRadiusPx.inc"/>
            <Button style="joinRight" label="Edit…" icon="editSquare" span="2" command="settings.edit.comboOuterRadiusPx"/>
          </Row>
        </Row>
        <Row id="row_combo_style" columns="2" gap="6" style="row">
          <Label style="plain" label="Colors" caption="Drift ring and command slices."/>
          <Row columns="2" style="row">
            <Button style="joinLeft" label="Inner ring" caption="Drift ring." settingKey="comboInnerColor" command="settings.edit.color.comboInnerColor"/>
            <Button style="joinRight" label="Outer ring" caption="Command slices." settingKey="comboOuterColor" command="settings.edit.color.comboOuterColor"/>
          </Row>
        </Row>
      </Card>
    </Column>
    <Card id="page_scroll" rows="3" row="1" col="1" gap="6" rowHeights="72,*,72" style="group">
      <Button id="set_scroll_up" style="button" icon="ArrowUp" role="scrollUp" command="settings.scroll.up"/>
      <Button caption="0,1,1" role="scrollbar" scanGrace="400"/>
      <Button id="set_scroll_down" style="button" icon="ArrowDown" role="scrollDown" command="settings.scroll.down"/>
    </Card>
  </Grid>
</Page>
