<Page id="main_settings_gaze" name="Gaze" radius="16">
  <Style id="group" background="bg95" thickness="0" radius="16"/>
  <Style id="row" background="transparent" thickness="0" radius="0"/>
  <Style id="plain" background="transparent" thickness="0" radius="0"/>
  <Style id="join" background="transparent" thickness="0" radius="0"/>
  <Style id="joinLeft" background="transparent" thickness="0" radius="10,0,0,10"/>
  <Style id="joinRight" background="transparent" thickness="0" radius="0,10,10,0"/>
  <Grid id="board" desktopMode="true" rows="1" columns="16" anchor="Top" offset="0,0" size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth), A_ScreenHeight" gap="16" margin="12" radius="16">
    <SubGrid id="sec_gaze" row="0" col="0" colSpan="8" rows="5" columns="1" rowHeights="*,2*,2*,2*,2*" gap="6" margin="6" style="group">
      <Cell id="h_gaze" row="0" col="0" label="Gaze" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_follow" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="f_l" row="0" col="0" label="Gaze follow" caption="Reticle, gaze mouse, and live lens." role="label" style="plain"/>
        <SubGrid id="act_follow" row="0" col="1" rows="1" columns="4" gap="0" style="row">
          <Cell id="f_slow" row="0" col="0" label="Slow" role="choice" activeState="settings.mag.follow.slow" style="joinLeft" command="settings.mag.follow.slow"/>
          <Cell id="f_sticky" row="0" col="1" label="Sticky" role="choice" activeState="settings.mag.follow.sticky" style="join" command="settings.mag.follow.sticky"/>
          <Cell id="f_smooth" row="0" col="2" label="Smooth" role="choice" activeState="settings.mag.follow.smooth" style="join" command="settings.mag.follow.smooth"/>
          <Cell id="f_snappy" row="0" col="3" label="Snappy" role="choice" activeState="settings.mag.follow.snappy" style="joinRight" command="settings.mag.follow.snappy"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_help" row="2" col="0" rows="1" columns="3" gap="0" style="row">
        <Cell id="reticle" row="0" col="0" label="Show gaze" icon="eye" role="toggle" activeState="gazeReticle" style="joinLeft" command="toggleGazeReticle"/>
        <Cell id="follow" row="0" col="1" label="Gaze mouse" icon="MouseMagneticCursor" role="toggle" activeState="gazeMouseFollow" style="join" command="toggleGazeMouseFollow"/>
        <Cell id="magnifier" row="0" col="2" label="Gaze Magnifier" icon="MagnifyTool" role="toggle" activeState="magnifier" style="joinRight" command="toggleMagnifier"/>
      </SubGrid>
      <SubGrid id="row_z" row="3" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="z_l" row="0" col="0" label="Lens zoom" caption="Live lens magnification." role="label" style="plain"/>
        <SubGrid id="act_z" row="0" col="1" rows="1" columns="9" gap="0" style="row">
          <Cell id="z_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.magZoom.dec"/>
          <Cell id="z_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="magZoom" style="join"/>
          <Cell id="z_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.magZoom.inc"/>
          <Cell id="z_edit" row="0" col="7" colSpan="2" icon="editSquare" label="Edit…" style="joinRight" command="settings.edit.magZoom"/>
        </SubGrid>
      </SubGrid>
      <SubGrid id="row_l" row="4" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="l_l" row="0" col="0" label="Lens size" caption="Live lens diameter." role="label" style="plain"/>
        <SubGrid id="act_l" row="0" col="1" rows="1" columns="9" gap="0" style="row">
          <Cell id="l_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.magLensSize.dec"/>
          <Cell id="l_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="magLensSize" style="join"/>
          <Cell id="l_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.magLensSize.inc"/>
          <Cell id="l_edit" row="0" col="7" colSpan="2" icon="editSquare" label="Edit…" style="joinRight" command="settings.edit.magLensSize"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_look" row="0" col="8" colSpan="8" rows="6" columns="1" rowHeights="*,2*,2*,2*,2*,2*" gap="6" margin="6" style="group">
      <Cell id="h_look" row="0" col="0" label="Look-to maps" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_scroll" row="1" col="0" rows="1" columns="3" gap="6" style="row">
        <Cell id="scroll_l" row="0" col="0" label="Scroll" caption="Wheel from gaze vs the origin." icon="lookToScroll" role="label" style="plain"/>
        <Cell id="lts_on" row="0" col="1" label="Enable" icon="lookToScroll" role="toggle" activeState="lookToScroll" style="joinLeft" command="lookToScroll"/>
        <Cell id="scroll_edit" row="0" col="2" icon="editSquare" label="Edit" style="joinRight" command="lookTo.edit.scroll"/>
      </SubGrid>
      <SubGrid id="row_mouse" row="2" col="0" rows="1" columns="3" gap="6" style="row">
        <Cell id="mouse_l" row="0" col="0" label="Mouse" caption="Move the pointer from gaze vs the origin." icon="mouseMove" role="label" style="plain"/>
        <Cell id="mouse_on" row="0" col="1" label="Enable" icon="mouseMove" role="toggle" activeState="lookToMouse" style="joinLeft" command="lookToMouse"/>
        <Cell id="mouse_edit" row="0" col="2" icon="editSquare" label="Edit" style="joinRight" command="lookTo.edit.mouse"/>
      </SubGrid>
      <SubGrid id="row_lstick" row="3" col="0" rows="1" columns="3" gap="6" style="row">
        <Cell id="lstick_l" row="0" col="0" label="Left stick" caption="Left analog stick from gaze vs the origin." icon="sportsEsports" role="label" style="plain"/>
        <Cell id="lstick_on" row="0" col="1" label="Enable" icon="sportsEsports" role="toggle" activeState="lookToLeftStick" style="joinLeft" command="lookToLeftStick"/>
        <Cell id="lstick_edit" row="0" col="2" icon="editSquare" label="Edit" style="joinRight" command="lookTo.edit.leftStick"/>
      </SubGrid>
      <SubGrid id="row_rstick" row="4" col="0" rows="1" columns="3" gap="6" style="row">
        <Cell id="rstick_l" row="0" col="0" label="Right stick" caption="Right analog stick from gaze vs the origin." icon="sportsEsports" role="label" style="plain"/>
        <Cell id="rstick_on" row="0" col="1" label="Enable" icon="sportsEsports" role="toggle" activeState="lookToRightStick" style="joinLeft" command="lookToRightStick"/>
        <Cell id="rstick_edit" row="0" col="2" icon="editSquare" label="Edit" style="joinRight" command="lookTo.edit.rightStick"/>
      </SubGrid>
      <Cell id="look_hint" row="5" col="0" label="Each map has its own origin and rings. All four can run at once." role="label" style="plain"/>
    </SubGrid>
  </Grid>
</Page>
