<?xml version="1.0" encoding="UTF-8"?>
<Page id="main_settings_setup" name="Setup" radius="16">
  <Style id="row" background="transparent" thickness="0" radius="0"/>
  <Style id="join" background="transparent" thickness="0" radius="0"/>
  <Style id="plain" background="transparent" thickness="0" radius="0"/>
  <Style id="button" background="transparent" thickness="0" radius="10"/>
  <Style id="joinLeft" background="transparent" thickness="0" radius="10,0,0,10"/>
  <Style id="group" background="bg95" thickness="0" radius="16"/>
  <Style id="joinRight" background="transparent" thickness="0" radius="0,10,10,0"/>
  <Grid id="board" rows="2" columns="2" desktopMode="true" anchor="Top" offset="0,0" size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth),A_ScreenHeight" gap="12" rowHeights="96,*" columnWidths="*,72" radius="16">
    <Row id="titlebar" columns="2" span="2" gap="8" columnWidths="*,160" style="plain">
      <Label id="page_title" style="plain" label="Setup" caption="Tracker, pad, capture, session, settings, and updates" textStyle="title"/>
      <Button id="tab_done" style="button" label="Close" icon="keyboardHide" textStyle="row" closeAllPages="true"/>
    </Row>
    <Column id="scroller" rows="7" row="1" gap="12" rowHeights="130,130,146,130,302,286,220" scroll="true">
      <Card id="sec_tr" rows="2" gap="6" padding="6" rowHeights="40,72" style="group">
        <Label id="h_tr" style="plain" label="Tracker" textStyle="section"/>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Tracker" caption="Applies on next start."/>
          <Row columns="2" style="row">
            <Choice id="tr_a" style="joinLeft" label="Auto Tobii" bind="settings.tracker.auto" command="settings.tracker.auto"/>
            <Choice style="joinRight" label="Mouse" bind="settings.tracker.mouse" command="settings.tracker.mouse"/>
          </Row>
        </Row>
      </Card>
      <Card id="sec_vigem" rows="2" gap="6" padding="6" rowHeights="40,72" style="group">
        <Label id="h_vigem" style="plain" label="Virtual Xbox pad" textStyle="section"/>
        <Row columns="2" gap="6" style="row">
          <Label id="vigem_status" style="plain" label="ViGEm" caption="Not installed. Dwell Install to download the official setup."/>
          <Row columns="2" style="row">
            <Button id="vigem_refresh" style="joinLeft" label="Recheck" icon="restart" command="settings.vigem.refresh"/>
            <Button id="vigem_install" style="joinRight" label="Download / UAC" icon="sportsEsports" command="settings.vigem.install"/>
          </Row>
        </Row>
      </Card>
      <Card id="sec_capture" rows="2" gap="6" padding="6" rowHeights="40,88" style="group">
        <Label id="h_capture" style="plain" label="Screen capture" textStyle="section"/>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Screenshots" caption="All includes overlays (for documentation). Pages keeps boards and hides look-to, the reticle, and the lens. None hides boards and those overlays."/>
          <Row columns="3" style="row">
            <Choice id="cap_all" style="joinLeft" label="All" bind="settings.capture.all" command="settings.capture.all"/>
            <Choice id="cap_pages" style="join" label="Pages" bind="settings.capture.pages" command="settings.capture.pages"/>
            <Choice id="cap_none" style="joinRight" label="None" bind="settings.capture.none" command="settings.capture.none"/>
          </Row>
        </Row>
      </Card>
      <Card id="sec_splash" rows="2" gap="6" padding="6" rowHeights="40,72" style="group">
        <Label id="h_splash" style="plain" label="Startup" textStyle="section"/>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Startup splash" caption="Tour the dock when Gazer starts."/>
          <Row columns="2" style="row">
            <Switch id="splash_on" style="joinLeft" label="Show on start" icon="visibility" bind="settings.session.showSplash.toggle" command="settings.session.showSplash.toggle"/>
            <Button id="splash_play" style="joinRight" label="Play tour" icon="restart" command="settings.session.showSplash.play"/>
          </Row>
        </Row>
      </Card>
      <Card id="sec_session" rows="4" gap="6" padding="6" rowHeights="40,72,72,88" style="group">
        <Label id="h_session" style="plain" label="Session" textStyle="section"/>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Auto-close boards" caption="Close idle boards that opted in."/>
          <Switch id="ac_on" style="button" label="Auto-close" bind="settings.session.layoutAutoClose.toggle" command="settings.session.layoutAutoClose.toggle"/>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Auto-close idle" caption="Idle time before those boards close."/>
          <Row columns="9" style="row">
            <Button style="joinLeft" label="−" span="2" command="settings.nudge.layoutAutoCloseIdleMs.dec"/>
            <Label id="aci_val" style="join" label="—" settingKey="layoutAutoCloseIdleMs" role="value" span="3"/>
            <Button style="join" label="+" span="2" command="settings.nudge.layoutAutoCloseIdleMs.inc"/>
            <Button style="joinRight" label="Edit…" icon="editSquare" span="2" command="settings.edit.layoutAutoCloseIdleMs"/>
          </Row>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Bug log" caption="Send gazer.log when something goes wrong. After a restart, also send the newest gazer- file from the previous session."/>
          <Button id="log_open" style="button" label="Open log folder" icon="mail" command="openLogFolder"/>
        </Row>
      </Card>
      <Card rows="4" gap="6" padding="6" rowHeights="40,72,72,72" style="group">
        <Label id="h_files" style="plain" label="Settings file" textStyle="section"/>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Factory values" caption="Each setting, its default, and its current value."/>
          <Button id="defaults_open" style="button" label="View defaults" icon="list" hostPage="main_settings_defaults"/>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Import" caption="Replace settings with a file. Omitted values return to the factory."/>
          <Button id="import_open" style="button" label="Import" icon="download" command="settings.import"/>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label style="plain" label="Export" caption="Write the current settings to a JSON file."/>
          <Button id="export_open" style="button" label="Export" icon="upload" command="settings.export"/>
        </Row>
      </Card>
      <Card rows="3" gap="6" padding="6" rowHeights="40,88,72" style="group">
        <Label id="h_update" style="plain" label="Updates" textStyle="section"/>
        <Label id="update_note" style="plain" label="Silent updates" caption="After this version is installed, Gazer can download the next one and ask before it restarts Gazer." row="2"/>
        <Row columns="2" row="1" gap="6" style="row">
          <Label id="update_status" style="plain" label="Gazer" caption="Checking for updates."/>
          <Button id="update_check" style="button" label="Check now" icon="restart" command="settings.update.check"/>
        </Row>
      </Card>
    </Column>
    <Card id="page_scroll" rows="3" row="1" col="1" gap="6" rowHeights="72,*,72" style="group">
      <Button id="set_scroll_up" style="button" icon="ArrowUp" role="scrollUp" command="settings.scroll.up"/>
      <Button caption="0,1,1" role="scrollbar" scanGrace="400"/>
      <Button id="set_scroll_down" style="button" icon="ArrowDown" role="scrollDown" command="settings.scroll.down"/>
    </Card>
  </Grid>
</Page>
