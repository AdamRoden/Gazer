<Page id="main_settings_setup" name="Setup" radius="16">
  <Style id="group" background="bg95" thickness="0" radius="16"/>
  <Style id="row" background="transparent" thickness="0" radius="0"/>
  <Style id="plain" background="transparent" thickness="0" radius="0"/>
  <Style id="join" background="transparent" thickness="0" radius="0"/>
  <Style id="joinLeft" background="transparent" thickness="0" radius="10,0,0,10"/>
  <Style id="joinRight" background="transparent" thickness="0" radius="0,10,10,0"/>
  <Grid id="board" desktopMode="true" rows="6" columns="16" anchor="Top" offset="0,0" size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth), A_ScreenHeight" gap="6" margin="12" radius="16"
        rowHeights="96,1.25*,1.25*,1.25*,1.25*,1.9*">
    <Cell id="page_title" row="0" col="0" colSpan="16" label="Setup" caption="Tracker, pad, capture, and session" role="label" textStyle="title" style="plain"/>

    <SubGrid id="sec_tr" row="1" col="0" colSpan="16" rows="2" columns="1" rowHeights="*,2*" gap="6" margin="6" style="group">
      <Cell id="h_tr" row="0" col="0" label="Tracker" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_tr" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="tr_l" row="0" col="0" label="Tracker" caption="Applies on next start." role="label" style="plain"/>
        <SubGrid id="act_tr" row="0" col="1" rows="1" columns="2" gap="0" style="row">
          <Cell id="tr_a" row="0" col="0" label="Auto Tobii" role="choice" activeState="settings.tracker.auto" style="joinLeft" command="settings.tracker.auto"/>
          <Cell id="tr_m" row="0" col="1" label="Mouse" role="choice" activeState="settings.tracker.mouse" style="joinRight" command="settings.tracker.mouse"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_vigem" row="2" col="0" colSpan="16" rows="2" columns="1" rowHeights="*,2*" gap="6" margin="6" style="group">
      <Cell id="h_vigem" row="0" col="0" label="Virtual Xbox pad" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_vigem" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="vigem_status" row="0" col="0" label="ViGEm" caption="Not installed. Dwell Install to download the official setup." role="label" style="plain"/>
        <SubGrid id="act_vigem" row="0" col="1" rows="1" columns="2" gap="0" style="row">
          <Cell id="vigem_refresh" row="0" col="0" label="Recheck" icon="restart" style="joinLeft" command="settings.vigem.refresh"/>
          <Cell id="vigem_install" row="0" col="1" label="Download / UAC" icon="sportsEsports" style="joinRight" command="settings.vigem.install"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_capture" row="3" col="0" colSpan="16" rows="2" columns="1" rowHeights="*,2*" gap="6" margin="6" style="group">
      <Cell id="h_capture" row="0" col="0" label="Screen capture" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_capture" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="cap_label" row="0" col="0" label="Screenshots" caption="All includes overlays (for documentation). Pages keeps boards and hides look-to, the reticle, and the lens. None hides boards and those overlays." role="label" style="plain"/>
        <SubGrid id="act_capture" row="0" col="1" rows="1" columns="3" gap="0" style="row">
          <Cell id="cap_all" row="0" col="0" label="All" role="choice" activeState="settings.capture.all" style="joinLeft" command="settings.capture.all"/>
          <Cell id="cap_pages" row="0" col="1" label="Pages" role="choice" activeState="settings.capture.pages" style="join" command="settings.capture.pages"/>
          <Cell id="cap_none" row="0" col="2" label="None" role="choice" activeState="settings.capture.none" style="joinRight" command="settings.capture.none"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_splash" row="4" col="0" colSpan="16" rows="2" columns="1" rowHeights="*,2*" gap="6" margin="6" style="group">
      <Cell id="h_splash" row="0" col="0" label="Startup" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_splash" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="splash_l" row="0" col="0" label="Startup splash" caption="Tour the dock when Gazer starts." role="label" style="plain"/>
        <SubGrid id="act_splash" row="0" col="1" rows="1" columns="2" gap="0" style="row">
          <Cell id="splash_on" row="0" col="0" label="Show on start" icon="visibility" role="toggle" activeState="settings.session.showSplash.toggle" style="joinLeft" command="settings.session.showSplash.toggle"/>
          <Cell id="splash_play" row="0" col="1" label="Play tour" icon="restart" style="joinRight" command="settings.session.showSplash.play"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>

    <SubGrid id="sec_session" row="5" col="0" colSpan="16" rows="3" columns="1" rowHeights="*,2*,2*" gap="6" margin="6" style="group">
      <Cell id="h_session" row="0" col="0" label="Session" role="label" textStyle="section" style="plain"/>
      <SubGrid id="row_ac" row="1" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="ac_label" row="0" col="0" label="Auto-close boards" caption="Close idle boards that opted in." role="label" style="plain"/>
        <Cell id="ac_on" row="0" col="1" label="Auto-close" role="toggle" activeState="settings.session.layoutAutoClose.toggle" style="join" command="settings.session.layoutAutoClose.toggle"/>
      </SubGrid>
      <SubGrid id="row_aci" row="2" col="0" rows="1" columns="2" gap="6" style="row">
        <Cell id="aci_label" row="0" col="0" label="Auto-close idle" caption="Idle time before those boards close." role="label" style="plain"/>
        <SubGrid id="act_aci" row="0" col="1" rows="1" columns="9" gap="0" style="row">
          <Cell id="aci_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.layoutAutoCloseIdleMs.dec"/>
          <Cell id="aci_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="layoutAutoCloseIdleMs" style="join"/>
          <Cell id="aci_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.layoutAutoCloseIdleMs.inc"/>
          <Cell id="aci_edit" row="0" col="7" colSpan="2" icon="editSquare" label="Edit…" style="joinRight" command="settings.edit.layoutAutoCloseIdleMs"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>
  </Grid>
</Page>
