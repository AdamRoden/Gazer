{
  "schemaVersion": 1,
  "id": "example_settings_theme",
  "name": "Theme",
  "description": "Light / Dark / Custom — Voice-aligned chrome colors",
  "uiStyle": "fluent",
  "window": { "anchor": "center", "widthPx": 900, "heightPx": 520, "marginPx": 16 },
  "grid": { "columns": 3, "rows": 4, "gapPx": 12, "marginPx": 56 },
  "dwell": { "enabled": true, "ms": 650, "progressStyle": "radial" },
  "items": [
    { "id": "light", "label": "Light", "activeState": "setting.theme.light", "row": 0, "col": 0,
      "style": { "background": "#f0f4f9", "foreground": "#1f1f1f" },
      "action": { "type": "command", "name": "theme.light" } },
    { "id": "dark", "label": "Dark", "activeState": "setting.theme.dark", "row": 0, "col": 1,
      "style": { "background": "#0a0a0b", "foreground": "#e3e3e3" },
      "action": { "type": "command", "name": "theme.dark" } },
    { "id": "custom", "label": "Custom", "activeState": "setting.theme.custom", "row": 0, "col": 2,
      "style": { "background": "#674ea7", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "theme.custom" } },

    { "id": "hint", "role": "label", "label": "Theme mode", "caption": "Custom starts from the last dark/light bag; progress colors stay under Appearance.", "row": 1, "col": 0, "colSpan": 3 },

    { "id": "curves", "label": "Response curves…", "row": 2, "col": 0, "colSpan": 2,
      "style": { "background": "#1b5e4a", "foreground": "#f4f6fc" },
      "action": { "type": "command", "name": "openMappingProperties" } },
    { "id": "preview", "label": "Head & Gaze preview", "row": 2, "col": 2,
      "style": { "background": "#2b4c7e", "foreground": "#f4f6fc" },
      "action": { "type": "command", "name": "openPreview" } },

    { "id": "pause_dwell", "label": "Pause dwell", "activeState": "dwellSuspend", "row": 3, "col": 0,
      "style": { "background": "#8b5a2b", "foreground": "#fff" },
      "action": { "type": "command", "name": "toggleDwellSuspend" } },
    { "id": "back", "label": "← Settings", "row": 3, "col": 1,
      "style": { "background": "#0a7ea4", "foreground": "#fff" },
      "action": { "type": "loadLayout", "layoutId": "example_settings" } },
    { "id": "close", "label": "Close", "row": 3, "col": 2,
      "style": { "background": "#4a5568", "foreground": "#fff" },
      "action": { "type": "closeLayout" } }
  ]
}
