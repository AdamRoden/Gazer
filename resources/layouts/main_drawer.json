{
  "schemaVersion": 1,
  "id": "main_drawer",
  "name": "Main",
  "boundsMode": "screen",
  "autoClose": true,
  "autoCloseIdleMs": 3000,
  "autoCloseFadeMs": 3000,
  "window": {
    "anchor": "bottomCenter",
    "widthPx": 1080,
    "heightPx": 150,
    "aboveTaskbar": true,
    "drawerMotion": true,
    "style": {
      "background": "#00000000"
    }
  },
  "style": {
    "background": "#99000000",
    "glass": true
  },
  "grid": {
    "columns": 9,
    "rows": 1,
    "marginPx": 10,
    "gapPx": 10
  },
  "items": [
    {
      "id": "open_keyboard",
      "label": "Keyboard",
      "row": 0,
      "col": 0,
      "action": {
        "type": "openLayout",
        "layoutId": "uw_qwerty"
      },
      "icon": "Keyboard"
    },
    {
      "id": "open_mouse",
      "label": "Mouse",
      "row": 0,
      "col": 1,
      "action": {
        "type": "openLayout",
        "layoutId": "example_mouse"
      },
      "icon": "Mouse"
    },
    {
      "id": "open_assist",
      "label": "Assist",
      "row": 0,
      "col": 2,
      "action": {
        "type": "openLayout",
        "layoutId": "example_assist"
      },
      "icon": "Conversation"
    },
    {
      "id": "open_right",
      "label": "Right",
      "row": 0,
      "col": 3,
      "action": {
        "type": "openLayout",
        "layoutId": "uw_right"
      },
      "icon": "More"
    },
    {
      "id": "open_settings",
      "label": "Settings",
      "row": 0,
      "col": 4,
      "action": {
        "type": "openLayout",
        "layoutId": "main_settings_button_timing"
      },
      "icon": "SizeAndPosition"
    },
    {
      "id": "close",
      "label": "Close",
      "row": 0,
      "col": 5,
      "action": {
        "type": "command",
        "name": "collapseMaster"
      },
      "icon": "MinimizeDown"
    },
    {
      "id": "close_all",
      "label": "Close All",
      "row": 0,
      "col": 6,
      "actions": [
        {
          "type": "command",
          "name": "closeOtherViews"
        },
        {
          "type": "command",
          "name": "collapseMaster"
        }
      ],
      "icon": "CollapseDock"
    },
    {
      "id": "dwell_suspend",
      "label": "Pause dwell",
      "row": 0,
      "col": 7,
      "activeState": "dwellSuspend",
      "action": {
        "type": "command",
        "name": "toggleDwellSuspend"
      },
      "icon": "Sleep"
    },
    {
      "id": "quit",
      "label": "Quit",
      "row": 0,
      "col": 8,
      "action": {
        "type": "loadLayout",
        "layoutId": "main_quit_confirm"
      },
      "icon": "Quit"
    }
  ]
}
