{
  "schemaVersion": 1,
  "id": "main_drawer",
  "name": "Main",
  "uiStyle": "default",
  "boundsMode": "screen",
  "autoClose": true,
  "autoCloseIdleMs": 3000,
  "autoCloseFadeMs": 3000,
  "window": {
    "anchor": "bottomCenter",
    "widthPx": 1080,
    "heightPx": 150,
    "aboveTaskbar": true,
    "drawerMotion": true,
    "style": {
      "background": "#00000000"
    }
  },
  "grid": {
    "columns": 8,
    "rows": 1,
    "gapPx": 10
  },
  "items": [
    {
      "id": "open_keyboard",
      "label": "Keyboard",
      "row": 0,
      "col": 0,
      "style": { "background": "#1d3557", "foreground": "#ffffff" },
      "action": { "type": "openLayout", "layoutId": "example_keyboard" }
    },
    {
      "id": "open_mouse",
      "label": "Mouse",
      "row": 0,
      "col": 1,
      "style": { "background": "#2d6a4f", "foreground": "#ffffff" },
      "action": { "type": "openLayout", "layoutId": "example_mouse" }
    },
    {
      "id": "open_assist",
      "label": "Assist ★",
      "row": 0,
      "col": 2,
      "style": { "background": "#6a4c93", "foreground": "#ffffff" },
      "action": { "type": "openLayout", "layoutId": "example_assist" }
    },
    {
      "id": "open_settings",
      "label": "Settings ⚙",
      "row": 0,
      "col": 3,
      "style": { "background": "#4a5568", "foreground": "#ffffff" },
      "action": { "type": "openLayout", "layoutId": "main_settings" }
    },
    {
      "id": "close",
      "label": "Close",
      "row": 0,
      "col": 4,
      "style": { "background": "#3d4f66", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "collapseMaster" }
    },
    {
      "id": "close_all",
      "label": "Close All",
      "row": 0,
      "col": 5,
      "style": { "background": "#495057", "foreground": "#ffffff" },
      "actions": [{ "type": "command", "name": "closeOtherViews" }, { "type": "command", "name": "collapseMaster" }]
    },
    {
      "id": "dwell_suspend",
      "label": "Pause dwell",
      "row": 0,
      "col": 6,
      "activeState": "dwellSuspend",
      "style": { "background": "#5c4d7a", "foreground": "#ffffff" },
      "action": { "type": "command", "name": "toggleDwellSuspend" }
    },
    {
      "id": "quit",
      "label": "Quit",
      "row": 0,
      "col": 7,
      "style": { "background": "#9b2226", "foreground": "#ffffff" },
      "action": { "type": "loadLayout", "layoutId": "main_quit_confirm" }
    }
  ]
}
