<?xml version="1.0" encoding="UTF-8"?>
<Page id="main_settings_host" name="Settings" radius="16">
  <Style id="tabbar" background="bg95" thickness="0" radius="12"/>
  <Style id="plain" background="transparent" thickness="0" radius="0"/>
  <Style id="button" background="transparent" thickness="0" radius="10"/>
  <Grid id="board" rows="2" columns="2" desktopMode="true" anchor="Top" offset="0,0" size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth),A_ScreenHeight" gap="12" padding="16" rowHeights="96,*" columnWidths="248,*" radius="16">
    <Label id="host_title" style="plain" label="Settings" textStyle="title"/>
    <Column id="tabs" rows="8" row="1" gap="6" padding="8" rowHeights="72,72,72,72,72,72,72,*" style="tabbar">
      <Tab id="tab_dwell" style="button" label="Dwell" icon="timer" textStyle="row" hostPage="main_settings_dwell"/>
      <Tab id="tab_pointer" style="button" label="Pointer" icon="mouseMove" textStyle="row" hostPage="main_settings_pointer"/>
      <Tab id="tab_gaze" style="button" label="Gaze" icon="eye" textStyle="row" hostPage="main_settings_gaze"/>
      <Tab id="tab_head" style="button" label="Head" icon="HeadPreview" textStyle="row" hostPage="main_settings_head_pose"/>
      <Tab id="tab_speak" style="button" label="Speak" icon="Speak" textStyle="row" hostPage="main_settings_speak"/>
      <Tab id="tab_theme" style="button" label="Theme" icon="palette" textStyle="row" hostPage="main_settings_theme"/>
      <Tab id="tab_setup" style="button" label="Setup" icon="settings" textStyle="row" hostPage="main_settings_setup"/>
    </Column>
    <Grid id="body" col="1" rowSpan="2" src="main_settings_dwell" grid="board"/>
  </Grid>
</Page>
