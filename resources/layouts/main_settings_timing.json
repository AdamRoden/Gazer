{
  "schemaVersion": 1,
  "id": "main_settings_timing",
  "name": "Timing",
  "description": "Label · − · value · + · Edit  ·  sequence e.g. 600,300,100,600 (last step holds forever)",
  "uiStyle": "fluent",
  "window": { "anchor": "TopCenter", "widthPx": 1260, "height": 100, "marginPx": 0 },
  "grid": { "columns": 5, "rows": 11, "gapPx": 10, "marginPx": 100 },
  "items": [
    { "id": "timing", "label": "Timing", "row": 0, "col": 0, "style": { "background": "#332b4c7e", "foreground": "#f4f6fc" } },
    { "id": "magnifier", "label": "Magnifier", "row": 0, "col": 1, "style": { "background": "#5c4d7a", "foreground": "#f4f6fc" }, "action": { "type": "loadLayout", "layoutId": "main_settings_magnifier" } },
    { "id": "lts", "label": "Look↕Scroll", "row": 0, "col": 2, "style": { "background": "#1b5e4a", "foreground": "#f4f6fc" }, "action": { "type": "loadLayout", "layoutId": "main_settings_lts" } },
    {"id": "appearance","label": "Appearance","row": 0,"col": 3,"style": { "background": "#5c4d7a", "foreground": "#f4f6fc" },"action": { "type": "loadLayout", "layoutId": "main_settings_appearance" }},
    {"id": "assist","label": "Assist tools","row": 0,"col": 4,"style": { "background": "#134f5c", "foreground": "#f4f6fc" },"action": { "type": "loadLayout", "layoutId": "main_settings_assist" }},
  
    { "id": "scan_label", "role": "label", "label": "Scan grace", "caption": "Time on-target before dwell progress starts (ms). Layout/item dwell.scanGraceMs can override.", "row": 2, "col": 0 },
    { "id": "scan_dec", "label": "−", "row": 2, "col": 1, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.scanGraceMs.dec" } },
    { "id": "scan_value", "role": "value", "settingKey": "scanGraceMs", "label": "—", "row": 2, "col": 2 },
    { "id": "scan_inc", "label": "+", "row": 2, "col": 3, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.scanGraceMs.inc" } },
    { "id": "scan_edit", "label": "Edit…", "row": 2, "col": 4, "style": { "background": "#0a7ea4", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.edit.scanGraceMs" } },

    { "id": "dwell_label", "role": "label", "label": "Dwell sequence", "caption": "Comma-separated ms steps while holding (e.g. 600,300,100,600). Last step repeats forever.", "row": 3, "col": 0 },
    { "id": "dwell_dec", "label": "−", "row": 3, "col": 1, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.dwellMs.dec" } },
    { "id": "dwell_value", "role": "value", "settingKey": "dwellMs", "label": "—", "row": 3, "col": 2 },
    { "id": "dwell_inc", "label": "+", "row": 3, "col": 3, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.dwellMs.inc" } },
    { "id": "dwell_edit", "label": "Edit…", "row": 3, "col": 4, "style": { "background": "#0a7ea4", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.edit.dwellMs" } },

    { "id": "grace_label", "role": "label", "label": "Blink grace", "caption": "Blink window without canceling dwell (ms).", "row": 4, "col": 0 },
    { "id": "grace_dec", "label": "−", "row": 4, "col": 1, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.dwellGraceMs.dec" } },
    { "id": "grace_value", "role": "value", "settingKey": "dwellGraceMs", "label": "—", "row": 4, "col": 2 },
    { "id": "grace_inc", "label": "+", "row": 4, "col": 3, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.dwellGraceMs.inc" } },
    { "id": "grace_edit", "label": "Edit…", "row": 4, "col": 4, "style": { "background": "#0a7ea4", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.edit.dwellGraceMs" } },

    { "id": "mm_label", "role": "label", "label": "Mouse-move dwell", "caption": "Dwell time for cursor placement (ms).", "row": 5, "col": 0 },
    { "id": "mm_dec", "label": "−", "row": 5, "col": 1, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.mouseMoveDwellMs.dec" } },
    { "id": "mm_value", "role": "value", "settingKey": "mouseMoveDwellMs", "label": "—", "row": 5, "col": 2 },
    { "id": "mm_inc", "label": "+", "row": 5, "col": 3, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.mouseMoveDwellMs.inc" } },
    { "id": "mm_edit", "label": "Edit…", "row": 5, "col": 4, "style": { "background": "#0a7ea4", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.edit.mouseMoveDwellMs" } },

    { "id": "mmt_label", "role": "label", "label": "Mouse-move timeout", "caption": "Cancel move / click-loop if no target selected within this many ms (0 = off).", "row": 6, "col": 0 },
    { "id": "mmt_dec", "label": "−", "row": 6, "col": 1, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.mouseMoveSelectTimeoutMs.dec" } },
    { "id": "mmt_value", "role": "value", "settingKey": "mouseMoveSelectTimeoutMs", "label": "—", "row": 6, "col": 2 },
    { "id": "mmt_inc", "label": "+", "row": 6, "col": 3, "style": { "background": "#355070", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.nudge.mouseMoveSelectTimeoutMs.inc" } },
    { "id": "mmt_edit", "label": "Edit…", "row": 6, "col": 4, "style": { "background": "#0a7ea4", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.edit.mouseMoveSelectTimeoutMs" } },

    { "id": "p_label", "role": "label", "label": "Quick presets", "caption": "Slow / Normal / Fast single-step packages.", "row": 7, "col": 0 },
    { "id": "p_slow", "label": "Slow", "row": 7, "col": 1, "style": { "background": "#264653", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.dwell.slow" } },
    { "id": "p_norm", "label": "Normal", "row": 7, "col": 2, "style": { "background": "#2a9d8f", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.dwell.normal" } },
    { "id": "p_fast", "label": "Fast", "row": 7, "col": 3, "colSpan": 2, "style": { "background": "#e9c46a", "foreground": "#1a1a1a" }, "action": { "type": "command", "name": "settings.dwell.fast" } },

    { "id": "mag_pick", "label": "Pre-Click Zoom", "activeState": "mouseMoveMagPick", "row": 8, "col": 1, "style": { "background": "#f4a261", "foreground": "#1a1a1a" }, "action": { "type": "command", "name": "toggleMouseMoveMagPick" } },
    { "id": "mag_center", "label": "Zoom @dwell", "activeState": "mouseMoveMagPickCenter", "row": 8, "col": 2, "style": { "background": "#e76f51", "foreground": "#fff" }, "action": { "type": "command", "name": "toggleMouseMoveMagPickCenter" } },
    { "id": "click_loop", "label": "Gaze click\nloop", "activeState": "loop.gazeClick", "row": 8, "col": 3, "style": { "background": "#c1121f", "foreground": "#ffffff" }, "action": { "type": "command", "name": "mouseDwellClickLoop" } },
    { "id": "stop_loops", "label": "Stop action loops", "row": 8, "col": 4, "style": { "background": "#8b2e2e", "foreground": "#fff" }, "action": { "type": "command", "name": "stopAllActionLoops" } },

    { "id": "close", "label": "Close", "row": 10, "col": 2, "colSpan": 1, "style": { "background": "#4a5568", "foreground": "#fff" }, "action": { "type": "closeLayout" } }
  ]
}
