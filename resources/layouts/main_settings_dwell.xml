<?xml version="1.0" encoding="UTF-8"?>
<Page id="main_settings_dwell" name="Dwell" radius="16">
  <Style id="row" background="transparent" thickness="0" radius="0"/>
  <Style id="join" background="transparent" thickness="0" radius="0"/>
  <Style id="plain" background="transparent" thickness="0" radius="0"/>
  <Style id="button" background="transparent" thickness="0" radius="10"/>
  <Style id="joinLeft" background="transparent" thickness="0" radius="10,0,0,10"/>
  <Style id="group" background="bg95" thickness="0" radius="16"/>
  <Style id="joinRight" background="transparent" thickness="0" radius="0,10,10,0"/>
  <Grid id="board" rows="2" columns="2" desktopMode="true" anchor="Top" offset="0,0" size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth),A_ScreenHeight" gap="12" rowHeights="96,*" columnWidths="*,72" radius="16">
    <Row id="titlebar" columns="2" span="2" gap="8" columnWidths="*,160" style="plain">
      <Label id="page_title" style="plain" label="Dwell" caption="Presets, sequences, likely keys, grace, and button progress." textStyle="title"/>
      <Button id="tab_done" style="button" label="Close" icon="keyboardHide" textStyle="row" closeAllPages="true"/>
    </Row>
    <Column id="scroller" rows="5" row="1" gap="12" rowHeights="272,272,272,272,168" scroll="true">
      <Card id="sec_presets" rows="3" gap="8" padding="8" rowHeights="48,96,96" style="group">
        <Label id="h_presets" style="plain" label="Presets" textStyle="section"/>
        <Row columns="2" gap="6" style="row">
          <Label id="p_label" style="plain" label="Quick packages" caption="Slow, Normal, Fast, or Custom. Also sets pointer dwell, zoom dwell, and blink grace."/>
          <Row columns="4" style="row">
            <Choice id="p_slow" style="joinLeft" label="Slow" icon="speed2" bind="settings.dwell.slow" command="settings.dwell.slow"/>
            <Choice style="join" label="Normal" icon="speed3" bind="settings.dwell.normal" command="settings.dwell.normal"/>
            <Choice style="join" label="Fast" icon="speed4" bind="settings.dwell.fast" command="settings.dwell.fast"/>
            <Choice id="p_custom" style="joinRight" label="Custom" icon="toolsHandyman" bind="settings.dwell.custom" command="settings.dwell.custom"/>
          </Row>
        </Row>
        <Row columns="2" gap="6" style="row">
          <Label id="p_custom_l" style="plain" label="Custom" caption="Save the current timings, or restore the last save."/>
          <Row columns="2" style="row">
            <Button id="p_save" style="joinLeft" label="Save" command="settings.dwell.custom.save"/>
            <Button id="p_restore" style="joinRight" label="Restore" command="settings.dwell.custom.restore"/>
          </Row>
        </Row>
      </Card>
      <Card id="sec_dwell" rows="3" gap="8" padding="8" rowHeights="48,96,96" style="group">
        <Label id="h_dwell" style="plain" label="Sequences" textStyle="section"/>
        <Row id="row_dwell" columns="2" gap="6" style="row">
          <Label id="dwell_label" style="plain" label="Standard" caption="Settings, navigation, mouse, and AHK. Last step repeats."/>
          <Row columns="2" columnWidths="7*,2*" style="row">
            <Label id="dwell_value" style="joinLeft" label="—" settingKey="dwellMs" role="value"/>
            <Button style="joinRight" label="Edit…" icon="editSquare" id="dwell_edit" command="settings.edit.dwellMs"/>
          </Row>
        </Row>
        <Row id="row_rapid_dwell" columns="2" gap="6" style="row">
          <Label id="rapid_dwell_label" style="plain" label="Rapid" caption="Virtual keystrokes, composer typing, and modifiers. Last step repeats."/>
          <Row columns="2" columnWidths="7*,2*" style="row">
            <Label id="rapid_dwell_value" style="joinLeft" label="—" settingKey="rapidDwellMs" role="value"/>
            <Button style="joinRight" label="Edit…" icon="editSquare" command="settings.edit.rapidDwellMs"/>
          </Row>
        </Row>
      </Card>
      <Card id="sec_keys" rows="3" gap="8" padding="8" rowHeights="48,96,96" style="group">
        <Label id="h_keys" style="plain" label="Likely keys" textStyle="section"/>
        <Row id="row_key_size" columns="2" gap="6" style="row">
          <Label id="size_label" style="plain" label="Dynamic size" caption="After t, the edge of g toward h can select h. The middle of a key always stays that key. 0 is off, 5 is strongest."/>
          <Row columns="9" style="row">
            <Button style="joinLeft" label="−" span="2" command="settings.nudge.keyGravitySize.dec"/>
            <Label id="size_val" style="join" label="—" settingKey="keyGravitySize" role="value" span="3"/>
            <Button style="join" label="+" span="2" command="settings.nudge.keyGravitySize.inc"/>
            <Button style="joinRight" label="Edit…" icon="editSquare" span="2" command="settings.edit.keyGravitySize"/>
          </Row>
        </Row>
        <Row id="row_key_duration" columns="2" gap="6" style="row">
          <Label id="duration_label" style="plain" label="Dynamic duration" caption="After t, h finishes its rapid dwell sooner than g. An unlikely key takes longer. 0 is off, 5 is strongest."/>
          <Row columns="9" style="row">
            <Button style="joinLeft" label="−" span="2" command="settings.nudge.keyGravityDuration.dec"/>
            <Label id="duration_val" style="join" label="—" settingKey="keyGravityDuration" role="value" span="3"/>
            <Button style="join" label="+" span="2" command="settings.nudge.keyGravityDuration.inc"/>
            <Button style="joinRight" label="Edit…" icon="editSquare" span="2" command="settings.edit.keyGravityDuration"/>
          </Row>
        </Row>
      </Card>
      <Card id="sec_grace" rows="3" gap="8" padding="8" rowHeights="48,96,96" style="group">
        <Label id="h_grace" style="plain" label="Grace" textStyle="section"/>
        <Row id="row_scan" columns="2" gap="6" style="row">
          <Label style="plain" label="Scan grace" caption="Time on-target before dwell starts."/>
          <Row id="act_scan" columns="9" style="row">
            <Button style="joinLeft" label="−" span="2" id="scan_dec" command="settings.nudge.scanGraceMs.dec"/>
            <Label id="scan_val" style="join" label="—" settingKey="scanGraceMs" role="value" span="3"/>
            <Button style="join" label="+" span="2" id="scan_inc" command="settings.nudge.scanGraceMs.inc"/>
            <Button style="joinRight" label="Edit…" icon="editSquare" span="2" id="scan_edit" command="settings.edit.scanGraceMs"/>
          </Row>
        </Row>
        <Row id="row_grace" columns="2" gap="6" style="row">
          <Label style="plain" label="Blink grace" caption="Blink without canceling dwell."/>
          <Row columns="9" style="row">
            <Button style="joinLeft" label="−" span="2" command="settings.nudge.dwellGraceMs.dec"/>
            <Label id="grace_val" style="join" label="—" settingKey="dwellGraceMs" role="value" span="3"/>
            <Button style="join" label="+" span="2" command="settings.nudge.dwellGraceMs.inc"/>
            <Button style="joinRight" label="Edit…" icon="editSquare" span="2" command="settings.edit.dwellGraceMs"/>
          </Row>
        </Row>
      </Card>
      <Card id="sec_progress" rows="2" gap="8" padding="8" rowHeights="48,96" style="group">
        <Label id="h_prog" style="plain" label="Button progress" textStyle="section"/>
        <Row id="row_bp" columns="2" gap="6" style="row">
          <Label style="plain" label="Buttons" caption="Dwell styles on board cells."/>
          <Row id="act_bp" columns="3" style="row">
            <Switch id="bp_r" style="joinLeft" label="Ring" bind="settings.progress.radial.toggle" command="settings.progress.radial.toggle"/>
            <Switch style="join" label="Pie" bind="settings.progress.pie.toggle" command="settings.progress.pie.toggle"/>
            <Switch style="joinRight" label="Fill" bind="settings.progress.fill.toggle" command="settings.progress.fill.toggle"/>
          </Row>
        </Row>
      </Card>
    </Column>
    <Card id="page_scroll" rows="3" row="1" col="1" gap="6" rowHeights="72,*,72" style="group">
      <Button id="set_scroll_up" style="button" icon="ArrowUp" role="scrollUp" command="settings.scroll.up"/>
      <Button caption="0,1,1" role="scrollbar" scanGrace="400"/>
      <Button id="set_scroll_down" style="button" icon="ArrowDown" role="scrollDown" command="settings.scroll.down"/>
    </Card>
  </Grid>
</Page>
