{
  "schemaVersion": 1,
  "id": "example_settings_assist",
  "name": "Assist tools",
  "description": "Reticle, gaze→mouse, loops, preview — plus missing LTS / mouse pick knobs",
  "uiStyle": "fluent",
  "window": { "anchor": "center", "widthPx": 960, "heightPx": 560, "marginPx": 16 },
  "grid": { "columns": 3, "rows": 5, "gapPx": 12, "marginPx": 56 },
  "dwell": { "enabled": true, "ms": 650, "progressStyle": "radial" },
  "items": [
    { "id": "reticle", "label": "Gaze reticle", "activeState": "gazeReticle", "row": 0, "col": 0,
      "style": { "background": "#2b4c7e", "foreground": "#fff" },
      "action": { "type": "command", "name": "toggleGazeReticle" } },
    { "id": "follow", "label": "Gaze → mouse", "activeState": "gazeMouseFollow", "row": 0, "col": 1,
      "style": { "background": "#1b5e4a", "foreground": "#fff" },
      "action": { "type": "command", "name": "toggleGazeMouseFollow" } },
    { "id": "stop_loops", "label": "Stop action loops", "row": 0, "col": 2,
      "style": { "background": "#8b2e2e", "foreground": "#fff" },
      "action": { "type": "command", "name": "stopAllActionLoops" } },

    { "id": "mag_pick", "label": "Mag pick", "activeState": "mouseMoveMagPick", "row": 1, "col": 0,
      "style": { "background": "#f4a261", "foreground": "#1a1a1a" },
      "action": { "type": "command", "name": "toggleMouseMoveMagPick" } },
    { "id": "mag_center", "label": "Mag @dwell", "activeState": "mouseMoveMagPickCenter", "row": 1, "col": 1,
      "style": { "background": "#e76f51", "foreground": "#fff" },
      "action": { "type": "command", "name": "toggleMouseMoveMagPickCenter" } },
    { "id": "lts", "label": "Look↕Scroll", "activeState": "lookToScroll", "row": 1, "col": 2,
      "style": { "background": "#0a7ea4", "foreground": "#fff" },
      "action": { "type": "command", "name": "toggleLookToScroll" } },

    { "id": "accel_label", "role": "label", "label": "LTS accel/s", "caption": "Speed growth while outside deadzone", "row": 2, "col": 0 },
    { "id": "accel_dec", "label": "−", "row": 2, "col": 1, "style": { "background": "#355070", "foreground": "#fff" },
      "action": { "type": "command", "name": "settings.nudge.ltsAccelPerSec.dec" } },
    { "id": "accel_val", "role": "value", "settingKey": "ltsAccelPerSec", "label": "—", "row": 2, "col": 2 },

    { "id": "curves", "label": "Response curves…", "row": 3, "col": 0,
      "style": { "background": "#1b5e4a", "foreground": "#fff" },
      "action": { "type": "command", "name": "openMappingProperties" } },
    { "id": "preview", "label": "Head & Gaze preview", "row": 3, "col": 1,
      "style": { "background": "#2b4c7e", "foreground": "#fff" },
      "action": { "type": "command", "name": "openPreview" } },
    { "id": "mag", "label": "Magnifier", "activeState": "magnifier", "row": 3, "col": 2,
      "style": { "background": "#6a4c93", "foreground": "#fff" },
      "action": { "type": "command", "name": "toggleMagnifier" } },

    { "id": "pause_dwell", "label": "Pause dwell", "activeState": "dwellSuspend", "row": 4, "col": 0,
      "style": { "background": "#8b5a2b", "foreground": "#fff" },
      "action": { "type": "command", "name": "toggleDwellSuspend" } },
    { "id": "back", "label": "← Settings", "row": 4, "col": 1,
      "style": { "background": "#0a7ea4", "foreground": "#fff" },
      "action": { "type": "loadLayout", "layoutId": "example_settings" } },
    { "id": "close", "label": "Close", "row": 4, "col": 2,
      "style": { "background": "#4a5568", "foreground": "#fff" },
      "action": { "type": "closeLayout" } }
  ]
}
