{
  "schemaVersion": 1,
  "id": "example_settings_assist",
  "name": "Assist tools",
  "description": "Reticle, gaze→mouse, loops, preview — plus missing LTS / mouse pick knobs",
  "uiStyle": "fluent",
  "window": { "anchor": "TopCenter", "widthPx": 1260, "height": 100, "marginPx": 0 },
  "grid": { "columns": 5, "rows": 10, "gapPx": 10, "marginPx": 100 },
  "items": [
    { "id": "timing", "label": "Timing", "row": 0, "col": 0, "style": { "background": "#2b4c7e", "foreground": "#f4f6fc" }, "action": { "type": "loadLayout", "layoutId": "example_settings_timing" } },
    { "id": "magnifier", "label": "Magnifier", "row": 0, "col": 1, "style": { "background": "#5c4d7a", "foreground": "#f4f6fc" }, "action": { "type": "loadLayout", "layoutId": "example_settings_magnifier" } },
    { "id": "lts", "label": "Look↕Scroll", "row": 0, "col": 2, "style": { "background": "#1b5e4a", "foreground": "#f4f6fc" }, "action": { "type": "loadLayout", "layoutId": "example_settings_lts" } },
    {"id": "appearance","label": "Appearance","row": 0,"col": 3,"style": { "background": "#5c4d7a", "foreground": "#f4f6fc" },"action": { "type": "loadLayout", "layoutId": "example_settings_appearance" }},
    {"id": "assist","label": "Assist tools","row": 0,"col": 4,"style": { "background": "#33134f5c", "foreground": "#f4f6fc" },"action": { "type": "loadLayout", "layoutId": "example_settings_assist" }},

    { "id": "tr_l", "role": "label", "label": "Tracker", "caption": "Applies on next app start.", "row": 2, "col": 0 },
    { "id": "tr_a", "label": "Auto Tobii", "activeState": "setting.tracker.0", "row": 2, "col": 1, "style": { "background": "#1d3557", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.tracker.auto" } },
    { "id": "tr_m", "label": "Mouse", "activeState": "setting.tracker.1", "row": 2, "col": 2, "style": { "background": "#457b9d", "foreground": "#fff" }, "action": { "type": "command", "name": "settings.tracker.mouse" } },

    { "id": "reticle", "label": "Gaze Indicator", "activeState": "gazeReticle", "row": 3, "col": 1, "style": { "background": "#2b4c7e", "foreground": "#fff" }, "action": { "type": "command", "name": "toggleGazeReticle" } },
    { "id": "follow", "label": "Gaze → mouse", "activeState": "gazeMouseFollow", "row": 4, "col": 1, "style": { "background": "#1b5e4a", "foreground": "#fff" }, "action": { "type": "command", "name": "toggleGazeMouseFollow" } },
    { "id": "preview", "label": "Head preview", "row": 5, "col": 1, "style": { "background": "#2b4c7e", "foreground": "#fff" }, "action": { "type": "command", "name": "openPreview" } },

    { "id": "close", "label": "Close", "row": 9, "col": 2, "colSpan": 1, "style": { "background": "#4a5568", "foreground": "#fff" }, "action": { "type": "closeLayout" } }

  ]
}
