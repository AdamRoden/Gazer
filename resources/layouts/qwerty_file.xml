<?xml version="1.0" encoding="UTF-8"?>
<Page id="qwerty_file" name="File keys" radius="0">
  <Dwell id="vert2" scanGrace="100" activation="100,600"/>
  <Dwell id="vert1" scanGrace="200" activation="200,600"/>
  <Column id="vert1" rows="6" desktopMode="true" anchor="TopRight" offset="0,0" size="0.0625,0.72" layers="1,2">
    <Button dwell="vert1" icon="mouse" openPage="example_mouse"/>
    <Button dwell="vert1" icon="mouseLeftClickAtGaze" bind="mouseLeftClickAtGaze" row="1" mouseLeftClickAtGaze=""/>
    <Button dwell="vert1" icon="mouseRightClickAtGaze" bind="mouseRightClickAtGaze" row="2" mouseRightClickAtGaze=""/>
    <Button id="comboMouse" dwell="vert1" icon="comboMouse" bind="comboMouse" row="4" command="toggleComboMouse"/>
    <Button dwell="vert1" icon="lookToScroll" bind="lookToScroll" row="5" id="lts" command="toggleLookToScroll"/>
    <Grid id="edge" row="3">
      <Button dwell="vert1" icon="ArrowPointingToRight" showLayers="2"/>
    </Grid>
    <Grid id="keyboard" row="3" layers="2">
      <Button dwell="vert1" icon="keyboardKeys" showLayers="1"/>
    </Grid>
  </Column>
  <Column id="vert2" rows="2" desktopMode="true" anchor="TopRight" offset="0,0.72" size="0.0625,0.28" layers="2">
    <Button dwell="vert2" label="MID" icon="WindowMid">
      <AHK><![CDATA[
      {
      try { 
      Title := WinGetTitle("A")
      xPos := -4
      yPos := -4
      v_nWidthN := 15/16*A_ScreenWidth+8
      v_nHeightN := 0.72*(A_ScreenHeight-32)
      WinRestore Title 
      WinMove xPos, yPos, v_nWidthN, v_nHeightN, Title
      } catch { 
      }
      }
      ]]></AHK>
    </Button>
    <Button dwell="vert2" id="max" label="MAX" icon="WindowMax">
      <AHK><![CDATA[
      {
      try { 
      Title := WinGetTitle("A")
      xPos := -4
      yPos := -4
      v_nWidthN := 15/16*A_ScreenWidth+8
      v_nHeightN := A_ScreenHeight-32
      WinRestore Title 
      WinMove xPos, yPos, v_nWidthN, v_nHeightN, Title
      } catch { 
      }
      }
      ]]></AHK>
    </Button>
  </Column>
