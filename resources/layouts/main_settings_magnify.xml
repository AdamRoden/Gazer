<Page id="main_settings_magnify" name="Magnify pick" radius="16">
  <Style id="group" thickness="0" radius="16"/>
  <Style id="row" background="#00000000" thickness="0" radius="0"/>
  <Style id="plain" background="#00000000" thickness="0" radius="0"/>
  <Style id="join" background="#00000000" thickness="0" radius="0"/>
  <Style id="joinLeft" background="#00000000" thickness="0" radius="10,0,0,10"/>
  <Style id="joinRight" background="#00000000" thickness="0" radius="0,10,10,0"/>
  <Style id="tabbar" thickness="0" radius="12"/>
  <Grid id="board" desktopMode="true" rows="10" columns="16" anchor="Top" offset="0,0" size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth), A_ScreenHeight" gap="6" margin="12" radius="16">
    <SubGrid id="tabs" row="0" col="0" colSpan="16" rows="1" columns="9" gap="6" margin="4" style="tabbar">
      <Cell id="tab_speed" row="0" col="0" label="Speed" icon="timer" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_speed"/>
      </Cell>
      <Cell id="tab_magnify" row="0" col="1" label="Magnify" icon="ZoomSettings" role="tab"/>
      <Cell id="tab_indicators" row="0" col="2" label="Indicators" icon="cycle" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_indicators"/>
      </Cell>
      <Cell id="tab_assist" row="0" col="3" label="Assist" icon="ideas" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_assist"/>
      </Cell>
      <Cell id="tab_tools" row="0" col="4" label="Tools" icon="lookToScroll" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_tools"/>
      </Cell>
      <Cell id="tab_theme" row="0" col="5" label="Theme" icon="palette" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_theme"/>
      </Cell>
      <Cell id="tab_speech" row="0" col="6" label="Speech" icon="Speak" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_speech"/>
      </Cell>
      <Cell id="tab_head" row="0" col="7" label="Head" icon="HeadPreview" role="tab">
        <ClosePage/>
        <OpenPage value="main_settings_head_pose"/>
      </Cell>
      <Cell id="tab_done" row="0" col="8" label="Done" icon="keyboardHide">
        <CloseAllPages/>
      </Cell>
    </SubGrid>

    <Cell id="page_title" row="1" col="0" colSpan="16" label="Magnify pick" caption="How Move-to zooms, and the zoom window" role="label" textStyle="title" style="plain"/>

    <SubGrid id="sec_all" row="2" col="0" colSpan="16" rowSpan="8" rows="3" columns="1" rowWeights="1,3,1" gap="6" margin="6" style="group">
      <SubGrid id="sec_mode" row="0" col="0" rows="2" columns="1" rowWeights="1,2" gap="6" margin="6" style="group">
        <Cell id="h_mode" row="0" col="0" label="Zoom" role="label" textStyle="section" style="plain"/>
        <SubGrid id="row_mode" row="1" col="0" rows="1" columns="3" gap="0" style="row">
          <Cell id="zm_pre" row="0" col="0" icon="ZoomConfirm" label="Magnify pick" role="toggle" activeState="mouseMoveMagPick" style="joinLeft" command="toggleMouseMoveMagPick"/>
          <Cell id="zm_fs" row="0" col="1" icon="ZoomReset" label="Foresight" role="toggle" activeState="mouseMoveForesight" style="join" command="toggleMouseMoveForesight"/>
          <Cell id="zm_fs2" row="0" col="2" icon="ZoomRepeat" label="Repeat Zoom" role="toggle" activeState="mouseMoveForesightSecondZoom" style="joinRight" command="toggleMouseMoveForesightSecondZoom"/>
        </SubGrid>
      </SubGrid>

      <SubGrid id="sec_zoom" row="1" col="0" rows="5" columns="1" rowWeights="1,2,2,2,2" gap="6" margin="6" style="group">
        <Cell id="h_zoom" row="0" col="0" label="Window" role="label" textStyle="section" style="plain"/>
        <SubGrid id="row_zl" row="1" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="zl_label" row="0" col="0" label="Zoom level" caption="Static magnification." role="label" style="plain"/>
          <SubGrid id="act_zl" row="0" col="1" rows="1" columns="9" gap="0" style="row">
            <Cell id="zl_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.pickZoom.dec"/>
            <Cell id="zl_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="pickZoom" style="join"/>
            <Cell id="zl_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.pickZoom.inc"/>
            <Cell id="zl_edit" row="0" col="7" colSpan="2" icon="editSquare" label="Edit…" style="joinRight" command="settings.edit.pickZoom"/>
          </SubGrid>
        </SubGrid>
        <SubGrid id="row_zs" row="2" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="zs_label" row="0" col="0" label="Zoom size" caption="Window size. Full screen uses the short axis." role="label" style="plain"/>
          <SubGrid id="act_zs" row="0" col="1" rows="1" columns="9" gap="0" style="row">
            <Cell id="zs_dec" row="0" col="0" colSpan="2" label="−" style="joinLeft" command="settings.nudge.pickWindowPx.dec"/>
            <Cell id="zs_val" row="0" col="2" colSpan="3" label="—" role="value" settingKey="pickWindowPx" style="join"/>
            <Cell id="zs_inc" row="0" col="5" colSpan="2" label="+" style="join" command="settings.nudge.pickWindowPx.inc"/>
            <Cell id="zs_full" row="0" col="7" colSpan="2" icon="FillScreen" label="Fill screen" role="toggle" activeState="mouseMoveMagPickFullScreen" style="joinRight" command="toggleMouseMoveMagPickFullScreen"/>
          </SubGrid>
        </SubGrid>
        <SubGrid id="row_shape" row="3" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="zs_shape_l" row="0" col="0" label="Shape" caption="Circle or square zoom window." role="label" style="plain"/>
          <SubGrid id="act_shape" row="0" col="1" rows="1" columns="2" gap="0" style="row">
            <Cell id="zs_round" row="0" col="0" label="Round" role="choice" activeState="settings.pickWindow.round" style="joinLeft" command="settings.pickWindow.round"/>
            <Cell id="zs_sq" row="0" col="1" label="Square" role="choice" activeState="settings.pickWindow.square" style="joinRight" command="settings.pickWindow.square"/>
          </SubGrid>
        </SubGrid>
        <SubGrid id="row_pos" row="4" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="zs_pos_l" row="0" col="0" label="Position" caption="Center on the gaze point or the screen." role="label" style="plain"/>
          <SubGrid id="act_pos" row="0" col="1" rows="1" columns="2" gap="0" style="row">
            <Cell id="z_gaze" row="0" col="0" icon="MagnifyAtPoint" label="Gaze point" role="choice" activeState="settings.pickCenter.gaze" style="joinLeft" command="settings.pickCenter.gaze"/>
            <Cell id="z_center" row="0" col="1" icon="MagnifyAtCenter" label="Screen center" role="choice" activeState="settings.pickCenter.screen" style="joinRight" command="settings.pickCenter.screen"/>
          </SubGrid>
        </SubGrid>
      </SubGrid>

      <SubGrid id="sec_preview" row="2" col="0" rows="2" columns="1" rowWeights="1,2" gap="6" margin="6" style="group">
        <Cell id="h_preview" row="0" col="0" label="Preview" role="label" textStyle="section" style="plain"/>
        <SubGrid id="row_test" row="1" col="0" rows="1" columns="2" gap="6" style="row">
          <Cell id="test_label" row="0" col="0" label="Test" caption="Dwell Move to… to try zoom." role="label" style="plain"/>
          <Cell id="test_move" row="0" col="1" icon="mouseMove" label="Move to…" activeState="mouseMoveToGaze" command="mouseMoveToGaze"/>
        </SubGrid>
      </SubGrid>
    </SubGrid>
  </Grid>
</Page>
