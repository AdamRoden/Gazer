<?xml version="1.0" encoding="UTF-8"?>
<Page id="main_settings_speak" name="Speak" radius="16">
  <Style id="row" background="transparent" thickness="0" radius="0"/>
  <Style id="join" background="transparent" thickness="0" radius="0"/>
  <Style id="plain" background="transparent" thickness="0" radius="0"/>
  <Style id="button" background="transparent" thickness="0" radius="10"/>
  <Style id="joinLeft" background="transparent" thickness="0" radius="10,0,0,10"/>
  <Style id="group" background="bg95" thickness="0" radius="16"/>
  <Style id="joinRight" background="transparent" thickness="0" radius="0,10,10,0"/>
  <Grid id="board" rows="2" columns="2" desktopMode="true" anchor="Top" offset="0,0" size="clamp(1.8*A_ScreenHeight, 1080, A_ScreenWidth),A_ScreenHeight" gap="12" rowHeights="96,*" columnWidths="*,72" radius="16">
    <Row id="titlebar" columns="2" span="2" gap="8" columnWidths="*,160" style="plain">
      <Label id="page_title" style="plain" label="Speak" caption="Voice and playback" textStyle="title"/>
      <Button id="tab_done" style="button" label="Close" icon="keyboardHide" textStyle="row" closeAllPages="true"/>
    </Row>
    <Column id="scroller" rows="2" row="1" gap="12" rowHeights="688,*" scroll="true">
      <Card id="sec_speech" rows="7" gap="8" padding="8" rowHeights="48,96,96,96,96,96,96" style="group">
        <Label id="h_speech" style="plain" label="Speech" textStyle="section"/>
        <Row id="row_key" columns="2" gap="6" style="row">
          <Label style="plain" label="API key" caption="ElevenLabs key for the composer. Stored on this PC."/>
          <Row columns="2" gap="6" columnWidths="*,160" style="row">
            <Label id="key_status" style="plain" label="No API key" role="value"/>
            <Button id="key_edit" style="button" label="Edit" icon="editSquare" command="settings.speech.editKey"/>
          </Row>
        </Row>
        <Row id="row_eng" columns="2" gap="6" style="row">
          <Label style="plain" label="Composer voice" caption="v4 Turbo streams as soon as audio is ready. XML Speak stays SAPI."/>
          <Row columns="2" style="row">
            <Choice id="m_sapi" style="joinLeft" label="SAPI" bind="settings.speech.model.sapi" command="settings.speech.model.sapi"/>
            <Choice id="m_turbo" style="joinRight" label="v4 Turbo" bind="settings.speech.model.eleven_v4_turbo" command="settings.speech.model.eleven_v4_turbo"/>
          </Row>
        </Row>
        <Row id="row_spd" columns="2" gap="6" style="row">
          <Label style="plain" label="Speed" caption="0.5–2.0 for ElevenLabs and SAPI."/>
          <Row columns="9" style="row">
            <Button style="joinLeft" label="−" span="2" command="settings.nudge.speechSpeed.dec"/>
            <Label id="speed_value" style="join" label="1.0" settingKey="speechSpeed" role="value" span="3"/>
            <Button style="join" label="+" span="2" command="settings.nudge.speechSpeed.inc"/>
            <Button id="spd_edit" style="joinRight" label="Edit…" icon="editSquare" span="2" command="settings.edit.speechSpeed"/>
          </Row>
        </Row>
        <Row id="row_pitch" columns="2" gap="6" style="row">
          <Label style="plain" label="Pitch" caption="0.5–2. ElevenLabs only. Speed keeps the pitch."/>
          <Row columns="9" style="row">
            <Button style="joinLeft" label="−" span="2" command="settings.nudge.speechPitch.dec"/>
            <Label id="pitch_value" style="join" label="1.0" settingKey="speechPitch" role="value" span="3"/>
            <Button style="join" label="+" span="2" command="settings.nudge.speechPitch.inc"/>
            <Button id="pit_edit" style="joinRight" label="Edit…" icon="editSquare" span="2" command="settings.edit.speechPitch"/>
          </Row>
        </Row>
        <Row id="row_vol" columns="2" gap="6" style="row">
          <Label style="plain" label="Boost" caption="1–5× louder for ElevenLabs clips."/>
          <Row columns="9" style="row">
            <Button style="joinLeft" label="−" span="2" command="settings.nudge.speechVolume.dec"/>
            <Label id="volume_value" style="join" label="1.0×" settingKey="speechVolume" role="value" span="3"/>
            <Button style="join" label="+" span="2" command="settings.nudge.speechVolume.inc"/>
            <Button id="vol_edit" style="joinRight" label="Edit…" icon="editSquare" span="2" command="settings.edit.speechVolume"/>
          </Row>
        </Row>
        <Row id="row_predict" columns="2" gap="6" style="row">
          <Label style="plain" label="Word predictions" caption="Suggestions below the phrase. Dwell a word to insert it."/>
          <Switch id="predict_on" style="button" label="On" bind="settings.speech.predictions.toggle" command="settings.speech.predictions.toggle"/>
        </Row>
      </Card>
      <Card id="sec_output" rows="2" gap="8" padding="8" rowHeights="96,*" style="group">
        <Row columns="2" gap="6" columnWidths="*,160" style="row">
          <Label id="h_output" style="plain" label="Output" caption="Where speech is heard." textStyle="section"/>
          <Button id="out_refresh" style="button" label="Refresh" icon="restart" command="settings.speech.output.refresh"/>
        </Row>
        <Grid id="out_list" gap="6" style="row"/>
      </Card>
    </Column>
    <Card id="page_scroll" rows="3" row="1" col="1" gap="6" rowHeights="72,*,72" style="group">
      <Button id="set_scroll_up" style="button" icon="ArrowUp" role="scrollUp" command="settings.scroll.up"/>
      <Button caption="0,1,1" role="scrollbar" scanGrace="400"/>
      <Button id="set_scroll_down" style="button" icon="ArrowDown" role="scrollDown" command="settings.scroll.down"/>
    </Card>
  </Grid>
</Page>
