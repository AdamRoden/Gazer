{
  "schemaVersion": 1,
  "id": "default",
  "name": "Default Windows",
  "commands": {
    "backspace": [
      { "type": "keyTap", "key": "Backspace" }
    ],
    "tab": [
      { "type": "keyTap", "key": "Tab" }
    ],
    "enter": [
      { "type": "keyTap", "key": "Enter" }
    ],
    "space": [
      { "type": "keyTap", "key": "Space" }
    ],
    "escape": [
      { "type": "keyTap", "key": "Escape" }
    ],
    "delete": [
      { "type": "keyTap", "key": "Delete" }
    ],
    "home": [
      { "type": "keyTap", "key": "Home" }
    ],
    "end": [
      { "type": "keyTap", "key": "End" }
    ],
    "pageUp": [
      { "type": "keyTap", "key": "PageUp" }
    ],
    "pageDown": [
      { "type": "keyTap", "key": "PageDown" }
    ],
    "arrowUp": [
      { "type": "keyTap", "key": "Up" }
    ],
    "arrowDown": [
      { "type": "keyTap", "key": "Down" }
    ],
    "arrowLeft": [
      { "type": "keyTap", "key": "Left" }
    ],
    "arrowRight": [
      { "type": "keyTap", "key": "Right" }
    ],
    "clearPhrase": [
      { "type": "keyCombo", "keys": ["Control", "A"] },
      { "type": "keyTap", "key": "Backspace" }
    ],
    "speakPhrase": [
      { "type": "keyCombo", "keys": ["Control", "Enter"] }
    ],
    "windowMid": [
      { "type": "keyCombo", "keys": ["Control", "Alt", "U"] }
    ],
    "windowMax": [
      { "type": "keyCombo", "keys": ["Control", "Alt", "W"] }
    ]
  }
}
